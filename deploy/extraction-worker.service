# Replace %WORKER_AUTH_TOKEN% with the actual value from worker/.env before installing.
# Also fill in the repo path.
# Install: sudo cp extraction-worker.service /etc/systemd/system/ && sudo systemctl enable --now extraction-worker
[Unit]
Description=SpaceWorker extraction worker
After=network.target

[Service]
WorkingDirectory=/path/to/repo/worker
ExecStart=/path/to/python api.py
Restart=always
RestartSec=5
EnvironmentFile=/path/to/repo/worker/.env

[Install]
WantedBy=multi-user.target