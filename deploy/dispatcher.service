# Replace %INTERNAL_BEARER_TOKEN% with the actual value from .env before installing.
# Install: sudo cp dispatcher.service /etc/systemd/system/
[Unit]
Description=SpaceWorker job dispatcher

[Service]
Type=oneshot
ExecStart=/usr/bin/curl -s -X POST \
  -H "Authorization: Bearer %INTERNAL_BEARER_TOKEN%" \
  http://localhost:3000/api/internal/dispatch
