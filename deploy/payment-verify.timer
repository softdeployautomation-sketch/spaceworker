# Runs every 5 minutes to re-check pending payments against the blockchain.
# Install: sudo cp payment-verify.timer /etc/systemd/system/ && sudo systemctl enable --now payment-verify.timer
[Unit]
Description=SpaceWorker payment verification poller — every 5 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
Unit=payment-verify.service

[Install]
WantedBy=timers.target