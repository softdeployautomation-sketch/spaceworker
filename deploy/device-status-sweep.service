# Install: sudo cp device-status-sweep.service /etc/systemd/system/ && sudo systemctl daemon-reload
# The bearer token is READ FROM THE APP'S .env AT RUNTIME (EnvironmentFile +
# systemd ${...} expansion) — never substitute %INTERNAL_BEARER_TOKEN% by hand:
# that is exactly how four sibling units silently 401'd on 2026-09-24.
# PORT 3500 — matches spaceworker.service (same convention as automations-sweep.service).
[Unit]
Description=SpaceWorker device online/offline notification sweep

[Service]
Type=oneshot
EnvironmentFile=/opt/spaceworker/.env
ExecStart=/usr/bin/curl -s -X POST \
  -H "Authorization: Bearer ${INTERNAL_BEARER_TOKEN}" \
  http://localhost:3500/api/internal/device-status-sweep
