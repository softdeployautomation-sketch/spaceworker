# PostgreSQL connection string — create role/db with: createuser spaceworker && createdb spaceworker -O spaceworker
DATABASE_URL=""
# 64 random hex chars — generate: openssl rand -hex 32 | tr -d '\n' | cat - /dev/null && openssl rand -hex 32
JWT_SECRET=""
# Strong passcode for the /admin panel
ADMIN_PASSCODE=""
# 32 random bytes hex — generate: openssl rand -hex 32
MAILBOX_ENCRYPTION_KEY=""
# Resend API key for this product's own transactional email (NOT used for outreach)
RESEND_API_KEY=""
# Random secret for the internal mail-drain endpoint and payment verification poller
INTERNAL_BEARER_TOKEN=""
# Wallet addresses (BTC / USDT-TRC20) are set via the /admin wallets tab and stored
# in the database (AdminSetting singleton) — no env vars needed for wallets.
# Base directory on the server where per-user Chrome profile dirs live. Created at
# deploy time — must be owned by the app user.
BROWSER_PROFILE_BASE_DIR="/var/spaceworker/profiles"