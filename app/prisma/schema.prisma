generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  emailVerified  Boolean  @default(false)
  tier           Int      @default(0)
  createdAt      DateTime @default(now())
  verifications  VerificationCode[]
  rateLimits     RateLimitEvent[]
  mailboxes      Mailbox[]
  emailCampaigns EmailCampaign[]
  payments       Payment[]
  browserProfiles BrowserProfile[]
  searchJobs    SearchJob[]
  leads         Lead[]
}

model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  ip        String
  kind      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([ip, kind, createdAt])
}

model AdminSetting {
  id           String   @id @default("singleton")
  updatedAt    DateTime @updatedAt
  btcWallet    String?
  usdtWallet   String?
  planPriceUsd Float    @default(9.99)
}

model Mailbox {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  label             String
  host              String
  port              Int
  username          String
  encryptedPassword String
  passwordIv        String
  passwordTag       String
  secure            Boolean   @default(true)
  dailyLimit        Int       @default(40)
  sentToday         Int       @default(0)
  sentTodayDate     String?
  active            Boolean   @default(true)
  lastTestedAt      DateTime?
  lastTestOk        Boolean?
  createdAt         DateTime  @default(now())
  queueItems        EmailQueueItem[]
  @@index([userId])
}

model EmailCampaign {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  subject     String
  bodyHtml    String
  searchJobId String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  items       EmailQueueItem[]
  @@index([userId])
}

model EmailQueueItem {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id])
  mailboxId  String
  mailbox    Mailbox       @relation(fields: [mailboxId], references: [id])
  toEmail    String
  status     String        @default("queued")
  sentAt     DateTime?
  error      String?
  createdAt  DateTime      @default(now())
  @@index([campaignId, status])
  @@index([mailboxId, status])
}

model Payment {
  id           String                       @id @default(cuid())
  userId       String
  user         User                         @relation(fields: [userId], references: [id])
  kind         String                       // "btc" | "usdt_trc20"
  amountUsd    Float
  txHash       String                       @unique
  toAddress    String
  status       String                       @default("pending") // "pending" | "approved" | "flagged" | "rejected"
  autoApproved Boolean                      @default(false)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  attempts     PaymentVerificationAttempt[]
  @@index([userId])
  @@index([status])
}

model PaymentVerificationAttempt {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  success   Boolean
  note      String?
  checkedAt DateTime @default(now())
}

model BrowserProfile {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  name       String
  dirPath    String    // absolute path — never exposed to client
  status     String    @default("idle") // "idle" | "in_use"
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  @@unique([userId, name])
  @@index([userId])
}

model SearchJob {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  query       String
  params      Json
  status      String         @default("queued")
  lane        String
  workerJobId String?
  error       String?
  createdAt   DateTime       @default(now())
  queueEntry  JobQueueEntry?
  leads       Lead[]
  @@index([userId, createdAt])
}

model JobQueueEntry {
  id           String    @id @default(cuid())
  searchJobId  String    @unique
  searchJob    SearchJob @relation(fields: [searchJobId], references: [id])
  priorityTier Int
  lane         String
  status       String    @default("queued")
  createdAt    DateTime  @default(now())
  @@index([lane, status, priorityTier, createdAt])
}

model Lead {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  searchJobId  String
  searchJob    SearchJob @relation(fields: [searchJobId], references: [id])
  email        String?
  phone        String?
  contactName  String?
  businessName String?
  website      String?
  sourceUrl    String?
  snippet      String?
  createdAt    DateTime  @default(now())
  @@index([userId, searchJobId])
}