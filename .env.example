# SpaceWorker environment configuration.
# Copy to .env and fill in real values. NEVER commit .env (it holds live secrets).

# PostgreSQL — OWN fresh database + own dedicated role for SpaceWorker. Zero
# shared tables or connections with Vantra's database.
DATABASE_URL=postgresql://spaceworker_app:***@127.0.0.1:5432/spaceworker

# Session signing secret (32+ random bytes, base64)
SESSION_SECRET=

# Resend email provider — this is SpaceWorker's OWN transactional-sending Resend
# account/key, deliberately separate from Vantra's. For a local build without a
# real key, use: re_local_dev_placeholder (email sending is stubbed/disabled).
RESEND_API_KEY=
EMAIL_FROM=noreply@spaceworker.app
APP_BASE_URL=http://localhost:3400

# Admin panel shared passcode (Channelry-style). Fails CLOSED when unset — the
# /admin panel is locked (never open) until this is set.
ADMIN_TOKEN=

# Server port
PORT=3400