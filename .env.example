# SpaceWorker environment configuration.
# Copy to .env and fill in real values. NEVER commit .env (it holds live secrets).

# PostgreSQL — OWN fresh database + own dedicated role for SpaceWorker. Zero
# shared tables or connections with Vantra's database.
DATABASE_URL=postgresql://spaceworker_app:***@127.0.0.1:5432/spaceworker

# Session signing secret (32+ random bytes, base64)
SESSION_SECRET=

# Resend email provider — this is SpaceWorker's OWN transactional-sending Resend
# account/key, deliberately separate from Vantra's. For a local build without a
# real key, use: re_local_dev_placeholder (email sending is stubbed/disabled).
RESEND_API_KEY=
EMAIL_FROM=noreply@spaceworker.app
APP_BASE_URL=http://localhost:3400

# Admin panel shared passcode (Channelry-style). Fails CLOSED when unset — the
# /admin panel is locked (never open) until this is set.
ADMIN_TOKEN=

# Server port
PORT=3400

# Interactive browser subsystem (Task 7). See browser-server/README.md.
BROWSER_SERVER_URL=http://127.0.0.1:3401
BROWSER_SERVER_TOKEN=
BROWSER_SESSION_BASE_PORT=32000

# Free exit-node endpoints (self-hosted WireGuard/OpenVPN SOCKS exit boxes).
# Example value: socks5://203.0.113.10:1080
EXIT_NODE_US=
EXIT_NODE_UK=

# Mailbox credential encryption — 64 hex chars (32 bytes) for AES-256-GCM.
MAILBOX_ENCRYPTION_KEY=

# Bearer token for internal systemd → Next.js calls (dispatch + mail-queue-drain).
INTERNAL_BEARER_TOKEN=

# Task 42 — signs EXE license keys (HMAC-SHA256 over a base64 payload, the Lead
# Extractor Pro format). Required IN PRODUCTION to issue licenses; a leaked value
# can forge unlimited licenses, so use a fresh 32+ random bytes and NEVER reuse
# INTERNAL_BEARER_TOKEN or SESSION_SECRET. Local builds work without it — license
# issuance simply fails closed until it's set.
EXE_LICENSE_SECRET=

# Task 27 Part A — where the desktop EXE stores its local license state (trial
# start timestamp + the activated key/email bound to this machine). OPTIONAL: the
# EXE's bundled local runtime honours this override; when blank, it falls back to
# a per-OS app-data dir (~/Library/Application Support/SpaceWorkerOS,
# %APPDATA%\\SpaceWorkerOS, or $XDG_DATA_HOME/spaceworker-os). Also used by the
# offline licensing layer's tests.
SPACEWORKER_LOCAL_DATA_DIR=

# Fixed 2026-09-14 — /api/exe-license/status and /api/exe-license/activate are
# part of this SAME Next.js codebase (no build-time route exclusion exists yet —
# that's still-future work). Without this gate they'd be live, unauthenticated,
# unlimited-rate endpoints on the deployed web server: /status runs OS commands
# and writes local state to the SERVER's own filesystem on every call, and
# /activate would validate real keys against the real EXE_LICENSE_SECRET the
# server also holds for issuance. Fails CLOSED like every other gate in this
# app — leave this blank in the production VPS .env, ALWAYS. Only the
# Tauri-bundled local runtime's own .env should ever set it to "true".
SPACEWORKER_LOCAL_EXE=

# Task 28, item 5 — account whose EmailCampaign rows are surfaced as
# "ready-made campaign templates" in the Automations builder's template picker.
# OPTIONAL: when blank, no ready-made templates exist and only the user's own
# campaigns are usable as automation templates. If set, the account must be a
# registered User email (the admin authoring API creates it on first use).
SYSTEM_TEMPLATES_USER_EMAIL=

# Task 31 — Channelry external-AI relay key. Issued when SpaceWorker was
# registered as an external client (client_id "spaceworker", $50/day pooled
# cap, admin-adjustable on Channelry's side). Blank = the admin "Test
# connection" button and the AI agent are disabled (fail closed). NEVER commit
# the real value.
CHANNELRY_AI_API_KEY=

# Platform-owned seed mailbox for the Mailer's test-send-confirm deliverability
# gate. Test messages are sent here from a customer mailbox, then polled via IMAP
# to prove the SMTP credentials genuinely deliver before a real send is allowed.
# Encrypted with MAILBOX_ENCRYPTION_KEY (same scheme as customer Mailbox rows).
SEED_MAILBOX_HOST=
SEED_MAILBOX_PORT=
SEED_MAILBOX_SECURE=true
SEED_MAILBOX_USERNAME=
SEED_MAILBOX_PASSWORD=
SEED_MAILBOX_LABEL=Deliverability seed

# 2026-09-28 — the platform's OWN sending relay (operator-only).
# SpaceWorker runs a local Postfix relay bound to 127.0.0.1 so a customer's
# broken/unreachable third-party SMTP server cannot stop campaigns going out
# (it also signs DKIM via OpenDKIM). The mail-host guard (lib/smtp-host-guard.ts,
# Task 51) rejects loopback/private SMTP hosts to stop an authenticated
# port-scan oracle — this variable is the single, explicit, OPERATOR-only
# exception that lets a mailbox point at that relay.
#
# Format: comma-separated host:PORT pairs. The port is REQUIRED — a portless
# entry is ignored on purpose, because allowing the whole host would re-open
# scanning of every loopback port (the exact thing Task 51 fixed). IPv6 uses
# the bracketed form. Blank/unset => nothing internal is ever allowed.
# Example for this deployment's relay:
#   SMTP_INTERNAL_RELAY_HOSTS=127.0.0.1:587
SMTP_INTERNAL_RELAY_HOSTS=

# TASK_139 — the relay's own public sending addresses, used ONLY to tell a
# customer which address their SPF record must authorise and to check whether
# the published record actually contains it. Two ip4:/ip6: entries that do not
# match the address receivers see are worse than no SPF hint at all, so this is
# operator-set rather than probed: the egress address can differ from the box's
# primary one (a NAT, a proxy, a second uplink).
# Blank => DKIM still verifies; SPF verification reports "not configured"
# instead of guessing.
SENDING_RELAY_IPV4=
SENDING_RELAY_IPV6=

# TASK_140 — the platform's OWN authenticated sending domain (operator-only).
# A customer's From domain can only be authenticated by a record in THAT domain's
# DNS, so if a customer cannot edit their DNS, DKIM for their own domain is
# impossible — no sending setup on our side can substitute for it. The way out is
# a domain WE own: authenticate it once (a single, platform-wide DNS edit, NOT
# one edit per customer) and any customer can send as it fully authenticated with
# zero DNS work of their own. This is the same shared-sending-domain model as
# Resend/SendGrid.
#
# Set this to the domain you have authenticated on the relay. It is then offered
# in the deliverability warnings as the "no DNS needed" alternative to a
# customer's unauthenticated From domain.
# Blank/unset => no platform domain is offered and behaviour is unchanged.
# Example: PLATFORM_SENDING_DOMAIN=spaceworker.top
PLATFORM_SENDING_DOMAIN=

# Task 39 — Telegram notifications. All OPTIONAL: when blank, Telegram simply
# doesn't fire and everything else (email + agent chat) keeps working.
#   - TELEGRAM_BOT_TOKEN: the bot's API token from @BotFather.
#   - TELEGRAM_BOT_USERNAME: the bot's @username (no @ needed) — used to build
#     the user-facing "Connect Telegram" deep link (t.me/<username>?start=...).
#   - TELEGRAM_WEBHOOK_SECRET: a strong random secret. After deploying, register
#     the webhook once (re-run whenever this changes or the URL moves):
#       curl -F "url=${APP_BASE_URL}/api/telegram/webhook" \
#            -F "secret_token=${TELEGRAM_WEBHOOK_SECRET}" \
#            "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook"
#     Telegram sends this back in the X-Telegram-Bot-Api-Secret-Token header,
#     which the webhook route verifies (fails CLOSED when unset/mismatched).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Task 155 — "Workers & Pages" (hosting). Cloudflare is the SCALE engine (Pages, custom
# domains, bulk redirects, R2); the free tier is our own dl.* metal and does NOT need any of
# this. Leave BLANK until the owner/lead supplies a production token — a blank value means
# "no Cloudflare engine configured" and everything except the Cloudflare phases is unaffected.
#   - CLOUDFLARE_API_TOKEN: a SCOPED account token (Account > Cloudflare Pages: Edit,
#     Account > Workers Scripts: Edit, Account > Bulk URL Redirects: Edit + Account Filter
#     Lists: Edit only if bulk redirects are wanted, Zone > DNS: Edit only for custom domains).
#   - CLOUDFLARE_ACCOUNT_ID: the account id the token belongs to.
#   - CLOUDFLARE_PAGES_PROJECT_DOMAIN (optional): the account's *.pages.dev suffix, used to
#     build the preview URL we show the user before a custom domain exists. The platform
#     account's Pages suffix is derived from its workers.dev subdomain in the dashboard.
# SECURITY: server-only. Never in a client bundle, a log line, an AI prompt or an error
# message. Any token pasted during testing goes in the gitignored .env only — never here.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Task 155 §15 — the PUBLIC host that serves user-uploaded hosting files. MUST NOT be the main
# spaceworker host (owner 2026-10-01); use the instaweb public family, e.g. the download host
# dl.instaweb.top (wildcard *.instaweb.top TLS already covers single labels). Optional and
# zero-behaviour-change until set: defaults to APP_BASE_URL. Server-only.
HOSTING_PUBLIC_BASE_URL=
# Task 155 P1 — where the local ("This server") hosting engine writes uploaded bytes. Defaults
# to <cwd>/.hosting-storage in dev; the VPS deploy sets it to /opt/spaceworker/storage/hosting so
# uploads sit on the data disk and are NOT wiped by a deploy. Server-only.
HOSTING_STORAGE_DIR=
