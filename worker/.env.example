# Worker environment — copy to .env and fill in real values.
# WORKER_AUTH_TOKEN — bearer token, REQUIRED, no default. The worker refuses to start if unset.
#   Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# WORKER_HOST — bind address. Default 127.0.0.1 (localhost only). Never set to 0.0.0.0 in production —
#   this worker must never be reachable from outside the box.
WORKER_HOST=127.0.0.1
# WORKER_PORT — port to listen on. Default 8001.
WORKER_PORT=8001
# WORKER_JOB_DIR — base directory holding one throwaway temp subdir per job.
#   Each job's directory is deleted unconditionally when the job ends (success, failure, or cancellation).
WORKER_JOB_DIR=/tmp/spaceworker-jobs