generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(cuid())
  email                    String                 @unique
  passwordHash             String
  emailVerified            Boolean                @default(false)
  // Tier 1 trial (Task: Tier 1 trial for all free users). Tier numbers:
  //   0 = legacy / nothing (inline EXE-buyer license_only accounts — see
  //       findOrCreateUser in app/api/billing/submit/route.ts, which MUST pin 0)
  //   1 = trial (15 min/day per tool, never prioritized over Premium)
  //   5 = Premium (the web subscription product — always grant exactly 5, see
  //       bumpWebTier in lib/license-service.ts)
  // 2/3/4 are deliberately reserved/unused headroom for future paid plans.
  // IMPORTANT: every "has Pro" branch must test `>= 5`, never `>= 1`, or a trial
  // user would silently get a paid feature and a paying customer would lose one.
  tier                     Int                    @default(1)
  // Task 55 — time-limited premium. In SpaceWorker, tier is per-User (unlike
  // Vantra's per-Organization). NULLABLE semantics differ from Vantra by design:
  //   - NULL on an EXISTING tier:5 user (created BEFORE this field existed) =
  //     GRANDFATHERED, never expires. The reversion check (premiumExpiresAt ===
  //     null) never touches them — never backfill a date here or you'd silently
  //     downgrade every existing paying customer.
  //   - NULL on a tier < 5 user = "not premium / free", meaningless.
  //   - non-NULL = a real premium term; every NEW grant / web-sub charge sets
  //     this. When it passes, the lazy check-on-read flips tier back to 1.
  premiumExpiresAt         DateTime?
  // Admin override, independent of tier — an admin can revoke a premium user's
  // access to SpaceWorker's own exit nodes (regional SMTP/browser/extraction
  // routing) without touching their premium status otherwise, e.g. for abuse.
  // Every node-access gate checks isPremiumTier(tier) && !nodeAccessRestricted.
  nodeAccessRestricted     Boolean                @default(false)
  // Premium — the user's saved default region for lead-extraction jobs (US/CA/UK,
  // mirrors Mailbox.sendRegion's exact pattern). null = direct, the default.
  // Read at job-creation time (app/api/jobs/route.ts) and baked into that job's
  // own params.proxyRegion, gated by canUseExitNodes() same as every other
  // node-access surface — never trusted from client input since there isn't any
  // here, it's purely derived from this saved preference.
  extractProxyRegion       String?
  // Task 39 — per-channel notification prefs (lib/notify.ts fan-out). notifyEmail
  // / notifyAgent default ON so a user who never opens Settings keeps today's
  // behavior; notifyTelegram defaults OFF (it's a no-op until the user links
  // their chat anyway). telegramChatId is set only via the bot-linking webhook;
  // telegramLinkToken is a short-lived random token backing the Connect deep link,
  // cleared on a successful link.
  notifyEmail              Boolean                @default(true)
  notifyTelegram           Boolean                @default(false)
  notifyAgent              Boolean                @default(true)
  // Task 94 — a SEPARATE toggle from notifyTelegram: that one is "send me
  // event notifications there", this one is "let me approve/reject agent
  // proposals from Telegram". Default off until linked (same reasoning as
  // notifyTelegram) — a user who's never touched Settings sees no behavior
  // change; the deep-link push only ever fires when both this AND a linked
  // telegramChatId are true.
  telegramApprovalsEnabled Boolean                @default(false)
  // A THIRD, separate Telegram toggle: "let me talk to the agent from
  // Telegram, not just tap approve/reject buttons on its pushes". Default
  // off (opt-in) — same reasoning as the other two: a linked-but-silent
  // Telegram chat must never start eating free-text messages as agent
  // input unless the user explicitly turns this on.
  telegramChatEnabled      Boolean                @default(false)
  telegramChatId           String?
  telegramLinkToken        String?
  // Master per-user kill switch: "let the agent PROPOSE actions at all"
  // (job/campaign pending actions in lib/agent.ts, device action proposals
  // in lib/vantra-link.ts). Default on — this is an opt-out, not a new
  // gate most users will ever touch. Off does NOT touch chat (the agent
  // still answers, it just never creates a pending action — see the
  // short-circuit in runAgentTurn) and does NOT touch manual device tools
  // (Wake/Reboot/Run now/PIN/maintenance overlay execute directly and never
  // go through AgentPendingAction or createDeviceActionProposal at all).
  agentActionsEnabled      Boolean                @default(true)
  // Real evidence of ToS/AUP agreement at signup — null means a pre-existing
  // account created before this field existed, not that they never agreed.
  acceptedTermsAt          DateTime?
  // Task 40 — per-user daily AI cost cap, in hundredths of a cent. Default $2/day
  // (20000), a modest slice of the shared $50/day Channelry pool. Deliberately a
  // per-user, admin-adjustable value (not a global constant) so an admin can "add
  // more" to a power user live, per the ask. Enforced in runAgentTurn against a
  // SUM over today's AiUsageLog rows (append-only, race-safe — see AiUsageLog).
  aiDailyCapHundredthsCent Int                    @default(20000)
  // Task 92 — assistant foundation. digestEnabled gates the nightly assistant
  // digest (digest-sweep skips users who turn it off); deviceTelemetryEnabled
  // is the master WEB toggle for device telemetry ingest (heartbeat upsert
  // refuses when false — no tray in SpaceWorker, per plan decision M-scope).
  digestEnabled            Boolean                @default(true)
  deviceTelemetryEnabled   Boolean                @default(true)
  // 2026-09-26 — ported from Vantra's proven device-status-check pattern
  // (app/api/internal/telegram-device-check/route.ts there). Independent
  // toggles, both default true (unlike the opt-in Telegram-specific ones
  // above) — this is a safety-relevant notification most users want by
  // default, same reasoning as Vantra's.
  notifyDeviceOffline      Boolean                @default(true)
  notifyDeviceOnline       Boolean                @default(true)
  // 2026-09-27 — the floating agent widget's own mute switch (distinct from
  // agentActionsEnabled, which only gates PROPOSALS). Off hides the widget
  // entirely; on by default since it's a pure UI convenience, not a new
  // capability with any side effect of its own.
  agentWidgetEnabled       Boolean                @default(true)
  // TASK_152 M5 — screen-monitoring notifications. BOTH master switches default
  // FALSE: a notification feature that switches itself on is how trust is lost,
  // so screen alerts only ever speak after the owner turns them on for their
  // account. A per-trigger `enabled` flag (ScreenTrigger.enabled) is the second,
  // narrower switch beneath these.
  //   screenTriggerNotificationsEnabled = master switch for the keyword triggers
  //                                       matched against frame summaries.
  //   screenDigestEnabled               = master switch for the periodic
  //                                       "every N minutes, all my monitored
  //                                       devices" digest.
  //   screenDigestIntervalMinutes       = that cadence (default 120 = 2 hours,
  //                                       which is the owner's own example).
  screenTriggerNotificationsEnabled Boolean @default(false)
  screenDigestEnabled               Boolean @default(false)
  screenDigestIntervalMinutes       Int     @default(120)
  createdAt                DateTime               @default(now())
  verifications            VerificationCode[]
  rateLimits               RateLimitEvent[]
  mailboxes                Mailbox[]
  emailCampaigns           EmailCampaign[]
  suppressions             Suppression[]
  payments                 Payment[]
  browserProfiles          BrowserProfile[]
  browserSessions          BrowserSession[]
  notificationLogs         NotificationLog[]
  searchJobs               SearchJob[]
  leads                    Lead[]
  campaignAutomations      CampaignAutomation[]
  seedMailboxes            SeedMailbox[]
  agentThreads             AgentThread[]
  agentPendingActions      AgentPendingAction[]
  aiUsageLogs              AiUsageLog[]
  toolUsageLogs            ToolUsageLog[]
  exeLicenses              ExeLicense[]
  exeLicenseTransfers      ExeLicenseTransfer[]
  // Task 92 — assistant foundation device layer + entitlements.
  devices                  Device[]
  deviceJobs               DeviceJob[]
  deviceActions            DeviceAction[]
  deviceRelationships      DeviceRelationship[]
  activityRollups          ActivityRollup[]
  userEntitlements         UserEntitlement[]
  agentActionAudits        AgentActionAudit[]
  vantraLink               VantraLink?
  // Task 95 — Devices v2 tool parity.
  deviceQueuedCommands     DeviceQueuedCommand[]
  devicePinRequests        DevicePinRequest[]
  // Task 97 — Browser Clone lifecycle records + relay registry + hosted sessions.
  cloneJobs                CloneJob[]
  relays                   RelayHealth[]
  hostedBrowserSessions    HostedBrowserSession[]
  // TASK_105 — the resource governor's durable wait list.
  governorQueueEntries     GovernorQueueEntry[]
  // TASK_127 — Phase 1 device screenshot monitoring (frames + opt-in).
  deviceScreenshots        DeviceScreenshot[]
  // TASK_128 — the visible public→private onboarding quarantine (one row/device).
  deviceOnboardings        DeviceOnboarding[]
  // TASK_139 — self-serve DKIM for mail relayed through SpaceWorker's own relay.
  sendingDomains           SendingDomain[]
  // TASK_152 M5 — screen-monitoring notification config + firing state.
  screenTriggers           ScreenTrigger[]
  screenDigestRollups      ScreenDigestRollup[]
  // TASK_152 M6 — the capture scheduler's persisted per-user rotation cursor.
  screenshotRotationCursors ScreenshotRotationCursor[]
  // TASK_159 — support tickets this user opened. The userId ALWAYS comes from the
  // session, never from a request body (PLAN_TASK_159_SUPPORT_TICKETS.md §2.2).
  supportTickets           SupportTicket[]
}

model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  // 2026-09-20 — Task 49 fix: a device-transfer confirmation code now reuses
  // this exact table/mechanism instead of inventing a new one, but issuing
  // one must never invalidate an unrelated pending signup-verification code
  // (or vice versa) for the same user — hence scoping by purpose. Every
  // pre-existing row is a real signup code, so the default keeps them
  // correctly classified with no backfill needed.
  purpose    String    @default("signup")
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  ip        String
  kind      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([ip, kind, createdAt])
}

model AdminSetting {
  id                             String   @id @default("singleton")
  updatedAt                      DateTime @updatedAt
  btcWallet                      String?
  usdtWallet                     String? // USDT-TRC20 (Tron) — the original/default USDT chain
  // USDT-ERC20 (Ethereum) — a second USDT wallet so buyers on Ethereum-native
  // exchanges (which often don't support Tron withdrawals) can pay directly
  // instead of needing to bridge/swap first. Independent from usdtWallet —
  // both can be configured at once, admin picks which chains are live.
  usdtErc20Wallet                String?
  // Task 42 — one price per product sold on the store/landing page (all real
  // launch prices decided 2026-09-14, still admin-adjustable at runtime). The
  // old planPriceUsd field was renamed to webSubscriptionPriceUsd (same role,
  // new default 25 = the store's web-subscription price, superseding 9.99).
  webSubscriptionPriceUsd        Float    @default(25) // /month
  extractorExePriceUsd           Float    @default(50) // one-time, 6-month term
  mailerExePriceUsd              Float    @default(50) // one-time, 6-month term
  combinedExePriceUsd            Float    @default(70) // one-time, 6-month term
  automationExePriceUsd          Float    @default(100) // one-time, 6-month term — top tier
  // TASK_99 / plan §COMMERCIAL C3 — module store: pick-your-capability web
  // subscriptions, each granting its own UserEntitlement instead of the full
  // tier-5 bundle. Placeholder launch prices — owner sets the real numbers in
  // Admin > Wallets & Prices.
  extractorModulePriceUsd        Float    @default(9) // /month
  mailerModulePriceUsd           Float    @default(9) // /month
  assistantDevicesModulePriceUsd Float    @default(15) // /month
  // New EXE product (owner, 2026-09-26): the AI assistant + device control as
  // a lightweight desktop app. No build variant exists yet (same state
  // mailer/combined/automation EXE already sell in — TASK_27 Part A: "only
  // Extractor is wired into CI today") — sellable now, buildable later.
  agentExePriceUsd               Float    @default(50) // one-time, 6-month term

  // Task 46 — admin admission control for the two mechanisms that actually spend
  // real RAM on this shared, resource-constrained VPS: search/extraction dispatch
  // (each running job is a real Playwright+Chromium process, one per lane today)
  // and interactive browser sessions (each is a full Neko streaming container).
  // Defaults exactly match today's hardcoded behavior — purely additive, zero
  // change until an admin actually touches a toggle or number.
  dispatchLightEnabled         Boolean @default(true)
  dispatchLightMaxConcurrent   Int     @default(1)
  dispatchHeavyEnabled         Boolean @default(true)
  dispatchHeavyMaxConcurrent   Int     @default(1)
  browserSessionsEnabled       Boolean @default(true)
  browserSessionsMaxConcurrent Int     @default(3)

  // Task 93 (CROSS-TRACK RULE 7) — per-feature admin limits for the Vantra
  // plugin: link provisioning rate + device-action concurrency. Live counts
  // are surfaced alongside in the admin panel (admission-control pattern).
  vantraLinksEnabled         Boolean @default(true)
  vantraLinksMax             Int     @default(100)
  deviceActionsEnabled       Boolean @default(true)
  deviceActionsMaxConcurrent Int     @default(3)

  // Task 97/107 (CROSS-TRACK RULE 7 + TASK_105 governor) — Browser Clone limits.
  // A cloned browser is a live Chromium process on the POOLED hosted PC, so it
  // is a first-class RAM consumer like the two mechanisms above. These key names
  // ARE the contract (TASK_107 deliverable 2); TASK_109/112 read them only
  // through lib/clone-settings.ts and never touch this table directly.
  //   cloneSessionsEnabled         = master on/off; a pause blocks NEW starts only
  //   cloneMaxConcurrent           = concurrent live clone sessions (engine-wide)
  //   clonePerUserCap              = of those, how many one user may hold at once
  //   hostedPoolSize               = hosted clone PCs provisioned to serve them
  //   cloneIdleTtlMinutes          = idle TTL before teardown (Q1: 60)
  //   cloneHardTtlMinutes          = absolute ceiling, even while in use (Q1: 480 = 8 h)
  //   clonePurgeAfterDays          = inactive-record purge window (owner 2026-10-01: 30)
  //   cloneDirectEgressPremiumOnly = direct egress is premium-only (owner 2026-10-01)
  //   cloneRelayRequired           = relay mode FAILS CLOSED when the relay is down
  // Both TTL numbers are stamped onto each CloneJob at creation, so changing a
  // value here never retroactively kills an already-running session. Everything
  // is admin-adjustable at runtime; nothing is hardwired.
  cloneSessionsEnabled         Boolean @default(true)
  cloneMaxConcurrent           Int     @default(2)
  clonePerUserCap              Int     @default(1)
  hostedPoolSize               Int     @default(1)
  cloneIdleTtlMinutes          Int     @default(60)
  cloneHardTtlMinutes          Int     @default(480)
  clonePurgeAfterDays          Int     @default(30)
  cloneDirectEgressPremiumOnly Boolean @default(true)
  cloneRelayRequired           Boolean @default(true)

  // TASK_105 — the resource governor's PRESSURE MODEL. Every threshold is an
  // AdminSetting so nothing is hardwired (CROSS-TRACK RULE 7); the defaults
  // below are deliberately chosen so that turning the governor OFF (the
  // default) changes NOTHING, and even enabling it with default numbers only
  // reacts when the box is genuinely under pressure.
  //   governorEnabled              = master switch. false => every feature keeps
  //                                  today's plain cap behaviour, and the
  //                                  governor never persists a queue row.
  //   governorRamWarnPct           = RAM used % at which the box is "warned":
  //                                  premium stops bypassing a full feature.
  //   governorRamHardPct           = RAM used % at which the box is "full":
  //                                  EVERYONE queues (premium included).
  //   governorSwapHardMb           = swap in use (MB) that counts as "full" even
  //                                  if RAM% looks okay.
  //   governorQueueTimeoutSec      = how long a queued request waits before it is
  //                                  released by the sweep (never wedged forever).
  //   governorStarvationPromoteMin = a free/trial request that has waited this
  //                                  long is promoted to the premium class, so
  //                                  premium traffic cannot starve free users.
  governorEnabled              Boolean @default(false)
  governorRamWarnPct           Int     @default(75)
  governorRamHardPct           Int     @default(90)
  governorSwapHardMb           Int     @default(1024)
  governorQueueTimeoutSec      Int     @default(900)
  governorStarvationPromoteMin Int     @default(10)

  // Task 56 — admin-toggleable maintenance windows. Two SEPARATE flags, not one:
  // web pages and the EXE-API traffic share one backend today but will split onto
  // their own hostname under the domain-separation plan, so keep them independent
  // now rather than refactor later. maintenanceModeWeb is checked by app/proxy.ts
  // (which serves the maintenance page for everything but /admin/** and static
  // assets); maintenanceModeExeApi is checked for /api/exe* + /api/exe-license*
  // requests, which return 503 { maintenance: true } instead of proceeding — the
  // EXE's hosted-fetch wrapper watches for that shape.
  maintenanceModeWeb    Boolean @default(false)
  maintenanceModeExeApi Boolean @default(false)

  // TASK_127 — device screenshot monitoring (Phase 1: automated capture).
  // Phase 1 is what actually spends real RAM on this box (each capture is a real
  // headless Chromium), so its concurrency cap is a governor feature like every
  // other RAM-holding mechanism — added to TASK_105's registry as
  // `deviceScreenshots`, never enforced with a second, parallel counter.
  //   screenshotMonitoringEnabled    = master switch. false (the default) =>
  //                                    the sweep captures nothing at all.
  //   screenshotCapturesMaxConcurrent = how many captures may run AT ONCE.
  //                                    Owner, 2026-09-27: start at 2, measure
  //                                    what 1 does to RAM, then tune here.
  //   screenshotCaptureIntervalMinutes = per-device cadence between captures.
  //   screenshotRetentionDays        = how long raw frames stay on disk before
  //                                    the sweep deletes them (frames are the
  //                                    sensitive artefact — a retention policy
  //                                    is part of the feature, not a follow-up).
  screenshotMonitoringEnabled      Boolean @default(false)
  screenshotCapturesMaxConcurrent  Int     @default(2)
  screenshotCaptureIntervalMinutes Int     @default(60)
  screenshotRetentionDays          Int     @default(14)
  // TASK_152 M6 — the capture SCHEDULER's two dials. Both are admin settings
  // (CROSS-TRACK RULE 7 — nothing hardwired) and both are ADDITIVE with a
  // default that reproduces today's behaviour exactly (a 1-user box with the
  // governor off never rotates and never consults headroom).
  //
  //   screenshotHeadroomRamPct = the RAM used % below which the box counts as
  //                              having headroom, so a lone monitoring user may
  //                              run captures SIMULTANEOUSLY up to the cap. The
  //                              default 0 means INHERIT governorRamWarnPct —
  //                              deliberately NOT a third hardcoded number: the
  //                              warn line is already the exact "box is still
  //                              healthy" boundary (premium bypass uses the same
  //                              `level === normal` test). An admin who wants the
  //                              owner's ~60% sets this to 60 here; anything
  //                              > 0 is clamped to <= governorRamHardPct so a
  //                              headroom line can never sit above the hard line.
  //   screenshotRotationSliceMinutes = when a user's eligible devices exceed
  //                              their granted slots, how long one ROTATION
  //                              slice holds before the per-user cursor advances
  //                              to the next slice (owner's figure: every
  //                              20-30 min; default 25). A shorter/longer cadence
  //                              is a dial, never a code change.
  screenshotHeadroomRamPct         Int     @default(0)
  screenshotRotationSliceMinutes   Int     @default(25)

  // TASK_155 P1 — Task 155 "Workers & Pages" hosting, FILES engine. Every cap is
  // an AdminSetting (CROSS-TRACK RULE 7 — nothing hardwired; owner 2026-10-01:
  // "we can add to the admin where those limits can be easily changed"). Purely
  // ADDITIVE and OFF by default: hostingEnabled=false means the whole surface is
  // dark, so applying this migration changes no existing behaviour.
  //
  //   hostingEnabled                 = master switch. false (the default) => the
  //                                    Hosting tab + every /api/hosting* route
  //                                    are inert ("dark" per PLAN §9 P1).
  //   hostingProvider                = which storage engine serves NEW uploads.
  //                                    "local" (our own metal, free, no third
  //                                    party) is the v1 default; "cloudflare"
  //                                    (Pages Direct Upload) and "external"
  //                                    (a generic pluggable provider) are
  //                                    registered but not yet implemented — see
  //                                    lib/hosting/providers/index.ts. A stored
  //                                    value the registry doesn't know falls back
  //                                    to "local" rather than failing a request.
  //   hostingFreeStorageQuotaMb      = per-user total bytes allowed (MB). 1024.
  //   hostingFreeMaxFileSizeMb       = per-file ceiling (MB). 512.
  //   hostingFreeMaxFiles            = per-user file COUNT. 500 (bounds inodes).
  //   hostingFreeMaxBandwidthGbPerMonth = per-user downloads served / calendar
  //                                    month (GB). 50. Downloads are the real cost.
  //   hostingPremiumStorageQuotaMb   = larger quota for premium/BYO (MB). 10240.
  //   hostingPagesMaxAssetMb         = Cloudflare Pages per-asset ceiling (MB).
  //                                    20 — MUST stay < 25: Cloudflare 500s above
  //                                    25 MiB (TASK_155 §9 R3, witnessed live), so
  //                                    we pre-validate and never forward oversize.
  //   hostingPlatformTokenTtlHours   = how long a platform-token "try it" project
  //                                    lives before reclaim (hours). 24 (owner §13).
  //   hostingModulePriceUsd          = price of the `hosting_module` store product.
  hostingEnabled                    Boolean @default(false)
  hostingProvider                   String  @default("local")
  hostingFreeStorageQuotaMb         Int     @default(1024)
  hostingFreeMaxFileSizeMb          Int     @default(512)
  hostingFreeMaxFiles               Int     @default(500)
  hostingFreeMaxBandwidthGbPerMonth Int     @default(50)
  hostingPremiumStorageQuotaMb      Int     @default(10240)
  hostingPagesMaxAssetMb            Int     @default(20)
  hostingPlatformTokenTtlHours      Int     @default(24)
  hostingModulePriceUsd             Float   @default(9)
  // TASK_155 P2 — user-owned redirect links (the /r/<token> promotion). Per free user.
  hostingFreeMaxLinks               Int     @default(50)
  // TASK_155 P4 — links get premium the same way files do (PLAN §17.2): premium
  // swaps to this dial, free keeps hostingFreeMaxLinks above. Same §14 mechanism.
  hostingPremiumMaxLinks            Int     @default(500)

  // TASK_155 P3 — the Pages/premium + folder→preview→publish dials (PLAN §16.3/§16.6,
  // owner 2026-10-02: "nothing that using premium is capped" is a PRODUCT rule, not
  // a licence — premium still has its OWN cap family so our shared Cloudflare
  // account cannot be abused). Same mechanism as every other cap: a named
  // AdminSetting field, read server-side on every request, admin-editable live.
  //
  //   hostingPremiumMaxProjects          = premium projects per user. 25 (the shared
  //                                        account holds 100 — R1 — so four heavy
  //                                        users can't consume it).
  //   hostingPremiumMaxFilesPerProject   = files per project. 2000 (a fifth of the
  //                                        20000 Direct-Upload ceiling, R19).
  //   hostingPremiumMaxBandwidthGbPerMonth = soft abuse alert, not a bill (Pages
  //                                        static egress is free). 200.
  //   hostingPremiumDeploymentsPerDay    = preview+publish = 2 deploys; 50 is
  //                                        generous for a builder, hostile to a script.
  //   hostingPreviewTtlHours             = an unpublished preview is swept after
  //                                        this long. 72 (a weekend review).
  //   hostingMaxZipMb                    = upload archive ceiling (MB). 2048.
  //   hostingMaxZipEntries               = entries per archive, EXACTLY the
  //                                        Direct-Upload ceiling (R19). 20000.
  //   hostingMaxHeavyJobsPerUser         = the §16.6 single-slot lock: one heavy
  //                                        hosting job (extract/deploy) per tenant.
  //   hostingPublishedRevisionsKept      = one-click "undo my last publish" without
  //                                        unbounded storage. 3.
  hostingPremiumMaxProjects         Int     @default(25)
  hostingPremiumMaxFilesPerProject  Int     @default(2000)
  hostingPremiumMaxBandwidthGbPerMonth Int  @default(200)
  hostingPremiumDeploymentsPerDay   Int     @default(50)
  hostingPreviewTtlHours            Int     @default(72)
  hostingMaxZipMb                   Int     @default(2048)
  hostingMaxZipEntries              Int     @default(20000)
  hostingMaxHeavyJobsPerUser        Int     @default(1)
  hostingPublishedRevisionsKept     Int     @default(3)

  // TASK_155 P6a (PLAN §19) — the platform Cloudflare kill-switch. When FALSE the
  // Premium (ours) site engine is down with a plain-language message, without a
  // redeploy and without touching any HostingPlatformAccount row. Same §14
  // mechanism: an admin-editable AdminSetting read server-side on every deploy.
  // Default TRUE so a P6a deploy with zero platform rows fails on the empty
  // roster (setup message), not on a dark master switch.
  hostingPlatformCfEnabled          Boolean @default(true)

  // TASK_157 Phase 1 — the platform-premium domain registry (PLAN_TASK_157 §3).
  // Empty string means "not configured yet": the resolver then serves the free
  // Cloudflare host, exactly as before this migration, so both dials are additive
  // and OFF by default. Edited live from the admin panel, read server-side on
  // every publish — the same §14 mechanism as every other dial.
  //
  //   hostingPremiumSiteDomain = base zone for premium SITES: a site becomes
  //                              <slug>.<hostingPremiumSiteDomain>. It must be a
  //                              zone in the SAME Cloudflare account as the Pages
  //                              project, or the custom domain can never activate.
  //   hostingPremiumLinkDomain = full HOST for premium LINK redirects
  //                              (e.g. go.instaweb.top) — a host, not a zone,
  //                              because the host is what becomes the Worker route.
  hostingPremiumSiteDomain          String  @default("")
  hostingPremiumLinkDomain          String  @default("")

  // TASK_157 Phase 2 — per-purpose platform-account PINNING.
  //
  // WHY THIS EXISTS. One HostingPlatformAccount row carries BOTH a Pages token
  // and an optional Workers/DNS token, and rotation picks the lowest-priority
  // healthy row for BOTH callers: sites.ts asks for the first healthy row,
  // links-engine asks for the first healthy row that has a Workers token. So a
  // dedicated links account cannot be expressed by priority alone — whichever
  // order the admin picks, the new account either serves links too but also
  // silently takes over site deploys, or it never wins links at all. The owner
  // asked for exactly one thing here: premium LINKS on their own Cloudflare
  // account, with the Pages/free side left alone. Priority cannot say that; two
  // explicit pins can.
  //
  // Values are Cloudflare ACCOUNT IDs (not row ids) because that is the identity
  // Cloudflare itself understands, and it survives deleting/re-adding a row.
  // Empty = unpinned = today's priority rotation, byte-for-byte unchanged.
  //
  // A pin FAILS LOUDLY when its account is missing, disabled or unhealthy. It
  // never falls back to another row: silently publishing premium links to the
  // free account's subdomain is precisely the mixing these pins exist to stop.
  hostingPremiumLinksAccountId     String  @default("")
  hostingPremiumSitesAccountId     String  @default("")

  // TASK_156 C1 (scaffolding, owner 2026-10-01) — the Cyber Lab's dials belong on
  // AdminSetting from day one (CROSS-TRACK RULE 7; PLAN_TASK_156 §7 C1). The owner
  // asked for "all caps for the workers and cyberlab ... available for edit in
  // admin" up front, so these columns + the admin panel land NOW, before the lab
  // itself — nothing reads them yet, they are all defaulted, and the migration is
  // additive, so this changes no behaviour.
  //
  //   cyberlabEnabled                 = master switch; false => lab dark (mirrors
  //                                     hostingEnabled).
  //   cyberlabFreeMaxConcurrentRanges = how many lab ranges one user may hold
  //                                     active at once. 1 (serialize, never share).
  //   cyberlabFreeMaxRangeMinutes     = hard TTL for a range before it is torn down.
  //   cyberlabRangeRamMb              = RAM reserved per range host (the scarce
  //                                     resource the owner called out — "if it's
  //                                     going to take a lot of ram").
  //   cyberlabHostRamBudgetMb         = total RAM the lab hosts may use; the
  //                                     resource governor (TASK_105) queues against
  //                                     this so a lab run never starves the app.
  //   cyberlabMaxTargetsPerScenario   = attested targets cap (legal spine, §5).
  //   cyberlabMaxEpisodesPerMonth     = per-user evidence-bundle cap.
  //   cyberlabModulePriceUsd          = price of the `cyberlab_module` product.
  cyberlabEnabled                   Boolean @default(false)
  cyberlabFreeMaxConcurrentRanges   Int     @default(1)
  cyberlabFreeMaxRangeMinutes       Int     @default(30)
  cyberlabRangeRamMb                Int     @default(2048)
  cyberlabHostRamBudgetMb           Int     @default(8192)
  cyberlabMaxTargetsPerScenario     Int     @default(10)
  cyberlabMaxEpisodesPerMonth       Int     @default(20)
  cyberlabModulePriceUsd            Float   @default(29)

  // TASK_156 C1 — the Lab* cap family: the §5.2 sentinel dials + the §12.1 research
  // cadence + the C0 consent-gate version. ADDITIVE to the D1-P2 `cyberlab*` dials
  // above (do not re-do the `cyberlab*` dials) and driven by the §12.8 ruling: C1
  // gains the LabToolCatalog + the read-only Research page, so the sentinel/research
  // dials land with it. Same mechanism as every other cap (CROSS-TRACK RULE 7): named
  // AdminSetting fields, read server-side on every request, admin-editable live, so a
  // limit change needs no redeploy. Nothing here is enforced yet (the engine is C2+);
  // the values are read by lib/lab/* and shown in admin/panel from day one.
  //
  //   cyberlabConsentTermsVersion         = the AUP version the gate enforces (§12.9 /
  //                                         C0). Bump it and EVERY user must re-accept,
  //                                         because the acceptance is recorded per version.
  //   cyberlabMaxTargetsPerUser           = total attested targets one user may hold
  //                                         (the allow-list size; §5.2.1).
  //   cyberlabMaxRunsPerDay               = runs one user may start per calendar day.
  //   cyberlabSentinelDnsQueriesPerMinute = §5.2.4/§12.3 DNS velocity dial.
  //   cyberlabSentinelEntropyThreshold    = §12.3 DNS-entropy exfil score, 0–100.
  //   cyberlabSentinelFreezeOnRefusals    = §5.2.1/§8.2 non-attested-target refusals
  //                                         before the account auto-freezes.
  //   cyberlabToolStaleAfterDays          = §12.1 default stale-after window applied to
  //                                         a LabToolCatalog row when none is given.
  //   cyberlabResearchRefreshDays         = §12.1 research cadence (feed re-pull window).
  cyberlabConsentTermsVersion         String @default("2026-10-02")
  cyberlabMaxTargetsPerUser           Int    @default(50)
  cyberlabMaxRunsPerDay               Int    @default(10)
  cyberlabSentinelDnsQueriesPerMinute Int    @default(600)
  cyberlabSentinelEntropyThreshold    Int    @default(40)
  cyberlabSentinelFreezeOnRefusals    Int    @default(3)
  cyberlabToolStaleAfterDays          Int    @default(180)
  cyberlabResearchRefreshDays         Int    @default(30)
}

model Mailbox {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  label             String
  host              String
  port              Int
  // SMTP AUTH username only, going forward. For a relay service like Resend this
  // is the literal "resend" (password = API key), independent of the From address.
  username          String
  // Task 30, item 4 — the addresses mail is actually sent AS. An empty array ([])
  // means "same as the SMTP username", which is every non-relay mailbox's
  // real-world behavior. Multiple entries rotate across recipients at queue-build
  // time (each item stores the resolved value on EmailQueueItem.resolvedFromAddress),
  // so one SMTP account can send as admin@/outreach@/hello@ etc. Replaces the old
  // single `fromAddress` column (additive migration, backfilled into a 1-item array).
  fromAddresses     String[]         @default([])
  encryptedPassword String
  passwordIv        String
  passwordTag       String
  secure            Boolean          @default(true)
  // Task 26, Piece 5a — explicit opt-in ONLY for the "None (port 25, unencrypted
  // relay)" security mode. Default false: the send path then ALWAYS enforces TLS
  // (requireTLS), even on port 587/25, so the old ambiguous "Use TLS checkbox" can
  // never silently pick the wrong handshake again. `secure` itself is derived from
  // port (port 465 => implicit TLS) at write time, not from this flag.
  allowInsecure     Boolean          @default(false)
  dailyLimit        Int              @default(40)
  sentToday         Int              @default(0)
  sentTodayDate     String?
  active            Boolean          @default(true)
  lastTestedAt      DateTime?
  lastTestOk        Boolean?
  // Premium — route this mailbox's outbound SMTP connection through one of
  // SpaceWorker's regional exit nodes (lib/exit-nodes.ts: "us" | "ca" | "uk")
  // instead of connecting directly from this server's own (European
  // datacenter) IP. null = direct, the default and the only option on a
  // free-tier account. See TASK_134 for what this does and does NOT fix
  // (it does not affect SPF/DKIM alignment for domains we don't control).
  sendRegion        String?
  createdAt         DateTime         @default(now())
  queueItems        EmailQueueItem[]

  @@index([userId])
}

model EmailCampaign {
  id                    String                @id @default(cuid())
  userId                String
  user                  User                  @relation(fields: [userId], references: [id])
  name                  String
  // Legacy single-value fields — kept for back-compat only; new campaigns write
  // their content as 1+ CampaignVariant rows and leave these empty.
  subject               String                @default("")
  bodyHtml              String                @default("")
  // Task 29, item 4 — independent subject and body lists for cross-combined
  // rotation. Empty ([]) for legacy pair-based campaigns, which keep using
  // CampaignVariant rows (see EmailQueueItem.variantId below). When populated,
  // recipient *i* resolves to subjects[i % len] + bodies[i % len] independently —
  // a single-item list is held constant (i % 1 === 0) while the other dimension
  // still rotates. Additive, so every pre-Task-29 campaign path is untouched.
  subjects              String[]              @default([])
  bodies                String[]              @default([])
  // Task 144 — how the bodies above are interpreted and sent:
  //   "html" (default) — sent as HTML with a derived plaintext alternative.
  //   "text"           — sent as a PLAIN-TEXT-ONLY message (single text/plain
  //                      part, no HTML body at all).
  // Why this exists: an HTML-only single-part message is a well-documented spam
  // heuristic, and "text" is the strongest available lever against it short of
  // changing domain authentication — it removes the markup heuristics entirely
  // rather than trying to defeat them. It is a CAMPAIGN-level field on purpose,
  // not a test-only toggle: a test that sends a different shape from the real
  // send cannot predict the real send, and this codebase already paid for that
  // lesson once (see lib/campaign-message.ts — the test send used to go out
  // HTML-only while the real send included a plaintext part).
  bodyFormat            String                @default("html")
  searchJobId           String?
  // "draft" | "pending_test_confirm" | "sending" | "done" | ...
  // New campaigns start at "pending_test_confirm": a real send is gated behind the
  // test-send-confirm step (the drain route only processes status "sending").
  status                String                @default("pending_test_confirm")
  // Tier 1 trial — when the CURRENT active-sending stretch began (null when not
  // actively sending). Set on every transition INTO "sending"; cleared (and the
  // stretch's elapsed seconds logged to ToolUsageLog) on every transition OUT of
  // "sending" (done / paused_deliverability / stopped). Kept null until the
  // first real send — a campaign sitting at "pending_test_confirm" accrues
  // nothing. One per running stretch, never a running total: today's mailer
  // usage is a SUM over ToolUsageLog rows (AiUsageLog precedent), so per-day
  // correctness survives pauses/resumes across UTC midnights.
  sendingStartedAt      DateTime?
  // Which of the user's mailboxes this campaign's sends rotate across (true
  // in-run sender rotation, replacing the old single `mailboxId` at creation).
  mailboxIds            String[]              @default([])
  // Task 26, Piece 5b — how many recipients share a mailbox/subject before the
  // rotation advances to the next. Default 1 = old per-recipient rotation
  // (non-breaking). Clamped server-side to [1, 1000]. Stored so the from-leads
  // add-to-existing route can keep rotating on the same cadence.
  rotateEvery           Int                   @default(1)
  // Task 29, item 6 — the batch gate: the mail-queue drain dispatches up to this
  // many recipients per campaign per tick, then re-checks deliverability on the
  // campaign's test mailbox and pauses if the probe didn't land in the inbox.
  batchSize             Int                   @default(50)
  // Human-assisted deliverability fallback: when set, EVERY deliverability
  // probe for this campaign (the initial test-send-confirm gate AND every
  // later batch-gate check) targets this plain address instead of a
  // registered SeedMailbox. There's no IMAP access to an arbitrary recipient,
  // so placement is never auto-verified here — the initial check passes on a
  // successful SMTP send (the human then eyeballs their own inbox before
  // clicking Confirm), and every batch probe always reports landedIn:"unknown",
  // which is exactly what keeps the batch gate pausing for a human decision on
  // every batch rather than auto-continuing. Set either up front (the
  // campaign-create "use this recipient as my test target" option) or
  // reactively after the platform seed mailbox's automated check fails.
  testRecipientOverride String?
  // 2026-09-28 — the test-send flow's own settings, deliberately SEPARATE from
  // everything a real send reads. A campaign's owner does a lot of trial and
  // error before letting it run ("did it land?", "was it the subject?", "was it
  // the From address?"), and that experimenting must never leak into the live
  // send.
  //
  // testRecipientPool: the addresses the user is willing to test against, so
  // switching the test target mid-flow is one click instead of retyping. Each
  // entry is a plain address the user can open themselves — there's no IMAP
  // access to it, so placement is never auto-verified (same trade-off as
  // testRecipientOverride above); the active one is still that field, this is
  // just the shortlist it's chosen from.
  //
  // testFromOverride: the From address EVERY test send should use instead of
  // the mailbox's normal fromAddresses rotation. This is the "is the From
  // address what's triggering spam?" lever. Structurally incapable of affecting
  // a real send: nothing on the send path (mail-queue drain / transporterForMailbox)
  // reads this field — only the test-send and diagnostics routes do.
  testRecipientPool     String[]              @default([])
  // TASK_150 T5 — which of `testRecipientPool` ONE manual test send should go to
  // when the user wants several (or all) of them, rather than the single active
  // address in `testRecipientOverride` above. Order-preserving.
  //
  // Deliberately NOT a second store of the pool: the pool stays the only owner of
  // the address LIST, this is just the ticked subset of it (the test-recipient
  // route 400s on an entry the pool doesn't contain).
  //
  // "Not in use" is `[]`, not NULL: Prisma 6 rejects optional lists outright
  // ("Optional lists are not supported", P1012), so an additive non-breaking
  // column here means a defaulted list. `[]` is treated identically to unset
  // everywhere — test sends fall back to the single active target, and the batch
  // -gate probe (which reads only `testRecipientOverride`) is untouched — so every
  // pre-existing row behaves exactly as it did. Nothing on the real send path
  // reads it; only test-send does.
  testRecipientSelection String[]              @default([])
  testFromOverride      String?
  // Task 35 — configurable send pacing. The drain's per-send jitter is
  // `min + random * (max - min)` seconds; defaults (5/45) match the pre-Task-35
  // hardcoded `Math.random() * 40_000 + 5_000` exactly (zero behavior change for
  // existing campaigns). Bounds are clamped server-side so a user can never
  // configure a 0-0 "bot blast" — see POST /api/campaigns and the drain route.
  minSendDelaySeconds   Int                   @default(5)
  maxSendDelaySeconds   Int                   @default(45)
  // Task 33 — a temporary, human-approved "pinned override" window: a specific
  // proven-good subject/body/from combination locked onto the campaign for a
  // fixed number of upcoming sends (requested pinCount). While set, the
  // mail-queue drain sends every recipient this exact content instead of
  // consulting subjects[i % len]/bodies[i % len]/fromAddresses[i % len], and
  // decrements `remaining` per successful send. When `remaining` reaches 0 the
  // drain clears it and (on a clean finish — no spam hit through the window)
  // front-inserts the pinned content into the normal rotation (Task 32's
  // mechanic) so it keeps serving the campaign after the window too. A spam hit
  // during the window clears the pin and falls back to paused_deliverability.
  // Shape: { subject, bodyHtml, fromAddress, remaining }. null = not pinned.
  // Achieved as a JSON column — no separate table.
  pinnedOverride        Json?
  // A user opts a campaign of their own into the "My campaigns" group of the
  // campaigns page's template picker by flipping this on (default off — not
  // every one-off campaign should clutter that list). Admin's Campaign
  // Templates tab separately surfaces every savedAsTemplate row across ALL
  // users (with the owner's email) so an admin can review one and, on
  // approval, promote it into the system-owned "Ready-made templates" group.
  savedAsTemplate       Boolean               @default(false)
  // Set once an admin promotes this campaign into a general (system-owned)
  // template — the id of the CLONE that promotion created (never this row
  // itself; the original stays the user's own). Makes promotion idempotent:
  // the admin UI disables/relabels the button once this is set, so clicking
  // it twice can't create duplicate general templates. Null = not promoted
  // yet. Loosely referenced (no FK), same convention as searchJobId above —
  // the system template can be deleted independently without touching this.
  promotedTemplateId    String?
  createdAt             DateTime              @default(now())
  variants              CampaignVariant[]
  checks                DeliverabilityCheck[]
  items                 EmailQueueItem[]
  linkRedirects         LinkRedirect[]

  @@index([userId])
}

model CampaignVariant {
  id         String           @id @default(cuid())
  campaignId String
  campaign   EmailCampaign    @relation(fields: [campaignId], references: [id])
  subject    String
  bodyHtml   String
  createdAt  DateTime         @default(now())
  items      EmailQueueItem[]

  @@index([campaignId])
}

model EmailQueueItem {
  id                  String           @id @default(cuid())
  campaignId          String
  campaign            EmailCampaign    @relation(fields: [campaignId], references: [id])
  // Assigned at queue-creation time via round-robin across the campaign's
  // mailboxIds (true in-run rotation lives here, not in the drain route).
  mailboxId           String
  mailbox             Mailbox          @relation(fields: [mailboxId], references: [id])
  // Which variant (subject/body) this recipient actually resolved to.
  variantId           String?
  variant             CampaignVariant? @relation(fields: [variantId], references: [id])
  toEmail             String
  // Task 29, item 3 — how this recipient got onto the queue. "" (default) =
  // extracted/uploaded/picked lead; "manual_insert" = a test recipient a user
  // dropped into the queue at a chosen position. Lets the run-detail UI label it
  // distinctly from extracted/uploaded/picked leads.
  source              String           @default("")
  // Task 29, item 4 — resolved subject/body snapshots for decoupled campaigns
  // (EmailCampaign.subjects/bodies set). Populated on those; null on legacy
  // pair-based campaigns, which fall back to variant.subject / variant.bodyHtml.
  resolvedSubject     String?
  resolvedBodyHtml    String?
  // Task 30, item 4 — the From address this specific recipient's send resolved
  // to at queue-build time (mailbox.fromAddresses[i % len] rotation). null = the
  // mailbox has no from addresses configured (drain falls back to SMTP username).
  resolvedFromAddress String?
  // Per-recipient merge variables from the uploaded CSV (extra columns).
  // { "firstName": "Ada", "company": "ACME", ... }
  variables           Json?
  status              String           @default("queued")
  sentAt              DateTime?
  error               String?
  // Classifies `error` into something the drain can actually act on, instead
  // of every SMTP failure landing in one undifferentiated bucket:
  // "hard_bounce" (permanent — SMTP 5xx like 550/551/553, or a bounce-address
  // pattern) never retries and feeds the Suppression list; "soft_bounce"
  // (temporary — 4xx like 421/450/452) is eligible for retry via
  // nextAttemptAt; "rate_limited" (e.g. 421/450 specifically from throttling,
  // or 550 5.7.1 style provider throttling) retries with backoff like a soft
  // bounce; "auth_failed" (SMTP 535 etc.) is a mailbox-credential problem, not
  // a per-recipient one — never retried per-item, surfaced to the owner
  // instead. null while queued/sent.
  errorCategory       String?
  // Retry support — a soft_bounce/rate_limited item becomes eligible for the
  // drain to re-select it once now() >= nextAttemptAt, up to a capped number
  // of attempts (see lib/deliverability.ts's retry backoff). A hard_bounce or
  // auth_failed item is never retried (nextAttemptAt stays null).
  attempts            Int              @default(0)
  nextAttemptAt       DateTime?
  createdAt           DateTime         @default(now())

  @@index([campaignId, status])
  @@index([mailboxId, status])
  @@index([variantId])
  @@index([status, nextAttemptAt])
}

// A per-user suppression list — an address that hard-bounced or was reported
// as a complaint is never queued into a future campaign of that user's again
// (see lib/campaign-recipients.ts). Deliberately per-user, not global: one
// user's bounce history says nothing about whether another user's (different
// mailbox, different content) send to the same address would also bounce.
model Suppression {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  // Always lowercased/trimmed before write and lookup — matching how
  // toEmail/CSV emails are normalized elsewhere in the mailer.
  email     String
  // "hard_bounce" | "complaint" | "manual"
  reason    String
  createdAt DateTime @default(now())

  @@unique([userId, email])
  @@index([userId])
}

model SeedMailbox {
  id                String                @id @default(cuid())
  // Task 29, item 5 — ownership. null = the platform-shared seed (today's
  // default, bootstrapped by lib/seed-mailbox.ts from env); set = a user's own
  // registered test account (created via POST /api/test-mailboxes). A user with
  // no own row keeps using the platform default, exactly as before — additive.
  userId            String?
  user              User?                 @relation(fields: [userId], references: [id])
  // Platform-owned deliverability seed account (typically only one row for v1).
  label             String
  host              String
  port              Int
  username          String                @unique
  encryptedPassword String
  passwordIv        String
  passwordTag       String
  secure            Boolean               @default(true)
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now())
  checks            DeliverabilityCheck[]

  @@index([userId])
}

model DeliverabilityCheck {
  id                String        @id @default(cuid())
  campaignId        String
  campaign          EmailCampaign @relation(fields: [campaignId], references: [id])
  // Nullable: a check against a registered SeedMailbox (platform default or a
  // user's own IMAP account) sets this; a check that instead targeted a plain
  // ad-hoc recipient (no IMAP credentials to poll — see overrideRecipient) has
  // no SeedMailbox row at all.
  seedMailboxId     String?
  seedMailbox       SeedMailbox?  @relation(fields: [seedMailboxId], references: [id])
  // The human-assisted fallback: when a campaign has no pollable seed mailbox
  // (the platform default failed, or the user opted to test against their own
  // address instead), the test message goes straight to this address and
  // "delivered" means "the SMTP send succeeded" — there's no IMAP account to
  // poll, so placement is never auto-verified; the human checks their own
  // inbox and clicks Confirm. Exactly one of seedMailboxId/overrideRecipient
  // is set per check.
  overrideRecipient String?
  // "pending" | "delivered" | "failed"
  status            String        @default("pending")
  // Task 29, item 6 — where the test message actually landed, from a spam-aware
  // IMAP poll. null on legacy checks / before the check runs; "inbox" | "spam" |
  // "unknown" afterward. "unknown" is what the batch gate needs to force a human
  // eyeball instead of auto-continuing. Always "unknown" for an overrideRecipient
  // check (no IMAP access), which is exactly what keeps the batch gate pausing
  // on every batch rather than auto-continuing.
  landedIn          String?
  messageId         String?
  error             String?
  createdAt         DateTime      @default(now())
  checkedAt         DateTime?

  @@index([campaignId, createdAt])
}

model Payment {
  id           String                       @id @default(cuid())
  userId       String
  user         User                         @relation(fields: [userId], references: [id])
  kind         String // "btc" | "usdt_trc20" — the PAYMENT METHOD, not the product
  amountUsd    Float
  // Task 44 — nullable: a buyer who doesn't know how to find their tx hash can
  // submit without one, staying "pending" for manual admin review only (never
  // auto-verified, never auto-rejected by the 24h poller timeout — see
  // app/api/internal/payment-verify/route.ts's explicit txHash-not-null filter
  // and app/api/billing/submit/route.ts's early return before any on-chain
  // check). Postgres allows multiple NULLs under @unique, so this never
  // collides between different no-hash submissions.
  txHash       String?                      @unique
  toAddress    String
  // Task 42 — which product this payment bought. Distinct from `kind` (the
  // payment METHOD). Defaulted so every pre-existing row is correctly the only
  // product that has ever existed. "web_subscription" | "extractor_exe" |
  // "mailer_exe" | "combined_exe" | "automation_exe".
  product      String                       @default("web_subscription")
  // 2026-09-20 — owner: "if anyone wants to buy more on there license they
  // can buy for 1 year, and also for 1 month, just let the calculator do
  // its thing". EXE-only; null means "the product's standard term"
  // (EXE_LICENSE_DAYS, 180 = 6 months) — every pre-existing row and every
  // web_subscription payment stays null, unaffected. Set at checkout time,
  // read back by issueExeLicense (lib/license-service.ts) to mint the
  // license for the ACTUAL term paid for instead of always 180 days.
  durationDays Int?
  status       String                       @default("pending") // "pending" | "approved" | "flagged" | "rejected"
  autoApproved Boolean                      @default(false)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  attempts     PaymentVerificationAttempt[]
  exeLicense   ExeLicense?

  @@index([userId])
  @@index([status])
}

// Task 42 — an issued desktop-app (EXE) license. Created exactly once per
// approved EXE payment via lib/license-service.ts. `issuedAt + 180 days` is the
// real term (a 6-month, non-perpetual license, decided 2026-09-14 superseding
// Part A's original perpetual note). `licenseKey` uses the proven Lead Extractor
// Pro format (lib/exe-license.ts) — the key's own `expires_at` payload field
// carries the authoritative expiry, which the dashboard/email surface.
model ExeLicense {
  id                          String    @id @default(cuid())
  userId                      String
  user                        User      @relation(fields: [userId], references: [id])
  paymentId                   String    @unique
  payment                     Payment   @relation(fields: [paymentId], references: [id])
  product                     String // matches Payment.product
  licenseKey                  String    @unique
  issuedAt                    DateTime  @default(now())
  // Task 45 — a short-lived, single-use claim token backing the "view my
  // license" link emailed to the buyer. Only the SHA-256 hash of the random half
  // is stored (never the raw token), `ExpiresAt` is set at issuance, and
  // `ConsumedAt` flips on a successful claim to make it single-use. All three are
  // null for licenses issued before this feature existed (no emailed claim link
  // for them — a pre-existing buyer still reaches /dashboard/licenses by logging
  // in as a real customer).
  licenseClaimTokenHash       String?   @unique
  licenseClaimTokenExpiresAt  DateTime?
  licenseClaimTokenConsumedAt DateTime?

  // Task 47 — one-time machine binding via a "claim" step. Issuance produces an
  // UNBOUND key (a purchase reference the EXE must never accept); a claim re-signs
  // that key with the buyer's device machine_id and records the binding here. All
  // four are set exactly once, on the first successful claim:
  //   boundMachineId    — the hardware id the key is now locked to (same format
  //                       getMachineId() produces, lowercased).
  //   boundMachineLabel — optional buyer/admin-chosen cosmetic label ("Office PC").
  //   boundLicenseKey   — the RE-SIGNED, machine-bound activation key the buyer
  //                       actually enters into the EXE (decodes with machine_id).
  //   boundAt           — when the claim happened (boundAt + original expiry is
  //                       the real term — a claim never resets the 180 days).
  // All nullable so every pre-existing (pre-feature) row correctly reads as
  // "unclaimed" — no machine info was ever bound for them either.
  boundMachineId    String?
  boundMachineLabel String?
  boundLicenseKey   String?
  boundAt           DateTime?

  // Task 47 addition — an admin device-transfer moves an already-bound license
  // from one machine to another (a deliberate support action, the only place a
  // binding is intentionally overwritten). Each successful transfer appends an
  // ExeLicenseTransfer audit row (see below) so "who moved what, when" survives
  // for support disputes.
  transfers ExeLicenseTransfer[]

  @@index([userId])
}

// Task 47 addition — append-only audit log of every admin device transfer for an
// EXE license. Written ATOMICALLY with the rebind (same $transaction as the
// ExeLicense.boundMachineId overwrite) so a transfer can never be recorded
// without its rebind or vice-versa. This is the durable record of the admin
// support action that deliberately moves a license to a replacement machine;
// the one-device guarantee in lib/exe-license-bind.ts is preserved because only
// a transfer (never the claim/bind path) may overwrite an existing binding.
//
// fromMachineId/toMachineId mirror the same lowercased machine_id format as
// ExeLicense.boundMachineId (getMachineId() output). fromMachineLabel is a
// snapshot of the binding being replaced, so the record is meaningful even if
// the ExeLicense row is later edited again.
model ExeLicenseTransfer {
  id               String     @id @default(cuid())
  exeLicenseId     String
  exeLicense       ExeLicense @relation(fields: [exeLicenseId], references: [id])
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  // The machine the license was bound to BEFORE this transfer. NULL only if the
  // row was somehow unbound (won't happen — a transfer requires an existing
  // binding — but kept nullable so the log can never fail to describe a move).
  fromMachineId    String?
  toMachineId      String
  fromMachineLabel String?
  toMachineLabel   String?
  // Optional support note — "replaced laptop after recall" etc. Free-form, kept
  // short; the admin UI caps it.
  note             String?
  transferredAt    DateTime   @default(now())

  @@index([exeLicenseId, transferredAt])
  @@index([userId])
}

// 2026-09-20 — owner: "a subtab showing every free users device active for
// that 24hrs, and can leave after they get binded." Server-side visibility
// into the EXE's silent 24h trial (lib/license-state.ts), which is otherwise
// ENTIRELY local to each machine — the admin has no way to see it today.
// Pinged (upsert) by the EXE-local /api/exe-license/status route whenever a
// device is in trial, fire-and-forget, same as every other admin-alert
// integration this session — a ping failure must never affect the trial
// gate itself. No user/email FK: a trial is anonymous by design, identified
// only by machineId (+ product, since one machine could run more than one
// EXE variant). The admin subtab computes "still active" as
// now - startedAt < 24h (the exact same rule lib/license-state.ts's
// trialActive() uses) and excludes any row whose machineId+product now has a
// bound ExeLicense — "leaves" the trial list once claimed, since it's no
// longer a free/trial device at that point.
model ExeTrialSession {
  id           String   @id @default(cuid())
  machineId    String
  product      String
  // Task 58 — the email the user entered at trial-start (required before a NEW
  // trial can begin; no more anonymous first launch). Nullable only for legacy
  // rows created before this field existed — the first email-carrying request
  // from the same device back-fills it.
  email        String?
  machineLabel String?
  startedAt    DateTime
  lastSeenAt   DateTime @default(now())

  @@unique([machineId, product])
  @@index([startedAt])
}

model PaymentVerificationAttempt {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  success   Boolean
  note      String?
  checkedAt DateTime @default(now())
}

model BrowserProfile {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  name             String
  dirPath          String // absolute path — never exposed to client
  status           String           @default("idle") // "idle" | "in_use"
  // Per-profile BYO proxy settings (Task 7). host/scheme/username are plaintext;
  // the combined "scheme://user:pass@host:port" connection string is stored
  // AES-256-GCM encrypted in byoProxyAuth (same pattern as Mailbox's SMTP
  // password). Only used when a session is started with proxyMode = "byo".
  byoProxyHost     String?
  byoProxyPort     Int?
  byoProxyScheme   String? // "http" | "https" | "socks5" | "socks5h"
  byoProxyUsername String?
  byoProxyAuth     String? // encrypted device connection string — never exposed to client
  lastUsedAt       DateTime?
  createdAt        DateTime         @default(now())
  sessions         BrowserSession[]

  @@unique([userId, name])
  @@index([userId])
}

model BrowserSession {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  profileId        String
  profile          BrowserProfile @relation(fields: [profileId], references: [id])
  // "starting" | "running" | "stopped" | "failed"
  status           String         @default("starting")
  proxyMode        String         @default("free") // "free" | "byo"
  exitNodeId       String? // which free exit node, when proxyMode = "free"
  // Real public IP this session actually egressed through, observed live via
  // a "what's my IP" check at session-start time — NOT re-derived from
  // exitNodeId + the current exit-nodes.ts config, since that mapping can
  // (and has) changed over time. This is the field an abuse/legal inquiry
  // about a specific real-world IP actually needs; exitNodeId alone can't
  // answer "what IP was this session really seen as" after a later config
  // change. Null if the live check failed — never blocks session launch.
  exitIpSnapshot   String?
  // Snapshot of the proxy actually routing this session — written at start time
  // so an edit to a profile's BYO settings never silently changes a live route.
  byoProxyHost     String?
  byoProxyPort     Int?
  byoProxyScheme   String?
  byoProxyUsername String?
  byoProxyAuth     String? // encrypted connection string, same scheme as BrowserProfile
  // Tunnel/container id the browser subsystem reports back for this session.
  containerId      String?
  // Neko's per-session auto-generated login password (browser-server/server.ts) —
  // embedded into connectUrl's ?pwd= query param so Neko's own login screen never
  // shows; never returned as a bare field (see browser-session-serialize.ts).
  nekoPassword     String?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime       @default(now())
  // Soft-delete: a customer "deleting" an ended session from their own
  // history hides it from their list only — the row (and its proxyMode/
  // exitNodeId/containerId/timestamps) stays intact for the admin audit
  // endpoint, which has no other record of past sessions.
  hiddenAt         DateTime?

  @@index([userId, status])
  @@index([profileId])
}

model NotificationLog {
  id           String   @id @default(cuid())
  userId       String? // null for admin-only notifications (no specific user)
  user         User?    @relation(fields: [userId], references: [id])
  eventType    String // e.g. "verification_code", "payment_pending", "payment_confirmed"
  channel      String // "email" | "telegram" — SpaceWorker is email-only for now, kept generic
  recipient    String // the email address or chat id actually targeted, for audit purposes
  outcome      String   @default("sent") // "sent" | "failed"
  errorMessage String? // populated when outcome is "failed"
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model SearchJob {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  query             String
  // Which template this search was created from: "lead" | "hr" | "plain" (extensible).
  template          String         @default("lead")
  params            Json
  status            String         @default("queued") // "queued" | "running" | "done" | "failed" | "paused" | "stopped"
  lane              String
  workerJobId       String?
  error             String?
  // Task 13 resumable jobs: non-null only while paused, holding enough to resume
  // from the next unprocessed query instead of restarting (processedQueries,
  // nextQueryIndex, seenUrls, foundLeads). Cleared when a paused job is resumed.
  resumeState       Json?
  // Set only when a job transitions to "paused" — the cooldown clock the
  // dispatcher's auto-resume check (outage pauses only, see resumeState's
  // pauseReason) uses to decide "enough time has passed, try again."
  pausedAt          DateTime?
  // How many times the dispatcher's Phase C has auto-resumed this job for an
  // "outage" pause. Capped (see app/api/internal/dispatch/route.ts) so a
  // durable, non-transient block (confirmed real for Google on this VPS —
  // see worker/automation.py's CAPTCHA notes) can't thrash forever, repeatedly
  // consuming its lane's only concurrency slot — after the cap it stays
  // "paused" for a human to look at instead of auto-retrying indefinitely.
  outageResumeCount Int            @default(0)
  // Task 14 live activity feed: the worker's current crawler step ("Searching: …",
  // "Visiting page N of Google results", "Reading a PDF at …"), written by the
  // dispatcher's per-tick poll while the job runs. Nullable and additive — left as
  // whatever the last "running" tick wrote after the job stops (done/paused/failed
  // branches do NOT clear it), so "where did it get to" survives the job.
  currentStep       String?
  // Task 15 stall detection: when currentStep's VALUE last actually changed
  // (not just when the dispatcher last polled — a poll that returns the same
  // step text again is exactly the "no real progress" case this needs to
  // catch, so re-stamping on every tick regardless of content would hide the
  // one thing this field exists to detect).
  currentStepAt     DateTime?
  // Tier 1 trial — wall-clock start of the job's most recent "running" stint.
  // Set when the dispatcher flips the job to running (Phase A admission); used to
  // meter ACTUAL elapsed runtime (dispatch start → terminal state) per tool per
  // UTC day, not each internal queued chunk. Cleared once the run is recorded in
  // ToolUsageLog so a later resume starts a fresh window. Null until first dispatch.
  trialStartedAt    DateTime?
  createdAt         DateTime       @default(now())
  queueEntry        JobQueueEntry?
  leads             Lead[]

  @@index([userId, createdAt])
}

model JobQueueEntry {
  id           String    @id @default(cuid())
  searchJobId  String    @unique
  searchJob    SearchJob @relation(fields: [searchJobId], references: [id])
  priorityTier Int
  lane         String
  status       String    @default("queued")
  createdAt    DateTime  @default(now())

  @@index([lane, status, priorityTier, createdAt])
}

model Lead {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  searchJobId      String
  searchJob        SearchJob @relation(fields: [searchJobId], references: [id])
  email            String?
  phone            String?
  contactName      String?
  businessName     String?
  website          String?
  sourceUrl        String?
  snippet          String?
  createdAt        DateTime  @default(now())
  // Task 26, Piece 3 — email deliverability validation. "unchecked" (the default)
  // means never validated; "valid" means both a syntactically-correct address and
  // an MX-record-bearing domain (see lib/email-validator.ts); "invalid" carries a
  // validationError explaining why. Additive and nullable-safe for existing rows.
  //
  // TASK_150 T2 — a FOURTH value, "duplicate", is deliberately its own state and
  // is NEVER folded into "invalid". "invalid" means the MX lookup failed; a
  // duplicate is a perfectly deliverable address that this user already has from
  // an earlier session. Conflating them would silently corrupt the owner's
  // invalid count (and the "Delete N invalid" action would throw away good
  // leads). See lib/lead-duplicates.ts for the (per-USER, case-insensitive)
  // dedupe that writes it.
  validationStatus String    @default("unchecked") // "unchecked" | "valid" | "invalid" | "duplicate"
  validationError  String?
  validatedAt      DateTime?
  // TASK_150 T2 — the EARLIER lead this row repeats, set only when
  // validationStatus is "duplicate". Deliberately a plain nullable column, not a
  // relation/FK: it is a marker for the UI and for delete-duplicates, and a
  // self-FK would make deleting the earlier lead (delete-invalid, a job delete)
  // fail or cascade in ways nothing here wants. Safe to point at a row that has
  // since been removed — that simply reads as "the original is gone"; the
  // duplicate itself is still a real, deletable row.
  duplicateOfId    String?

  // Was @@unique([searchJobId, sourceUrl]) -- a REAL, confirmed root-cause bug
  // (Task 25): that constraint means at most ONE lead can ever be saved per
  // page/PDF per job, no matter how many distinct emails extraction actually
  // finds there. Confirmed live: a real membership-directory PDF containing
  // 105 unique emails reliably extracts all 105 (verified directly against
  // the worker's own extract_lead_pdf), yet the SAME job's persisted leads
  // showed exactly 1 row for that URL -- app/api/internal/dispatch/route.ts's
  // `prisma.lead.createMany({ ..., skipDuplicates: true })` silently dropped
  // the other 104 as "duplicates" purely because they shared a sourceUrl,
  // regardless of having entirely different emails. This is almost certainly
  // the dominant reason every real job all session undercounted so
  // severely relative to what search/extraction/concurrency fixes proved
  // was actually being found -- none of those fixes could matter once the
  // database was discarding the results before they ever reached the UI.
  // The corrected constraint keeps the original's real purpose (never save
  // the exact same email twice from the same page, e.g. across a paused/
  // resumed job re-visiting a URL) while allowing the many distinct emails a
  // single rich document legitimately contains.
  @@unique([searchJobId, sourceUrl, email])
  @@index([userId, searchJobId])
  // TASK_150 T2 — the dedupe's own access path. Uniqueness is PER JOB (the
  // constraint above), which is exactly the reported bug: two sessions are two
  // SearchJobs, so the same address is legitimately stored twice and extraction
  // has no knowledge of previous sessions. Finding "does this user already have
  // this address" therefore has to be scoped [userId, email], not per job.
  @@index([userId, email])
}

// Task 27, Part B — manual automation builder. A saved, re-runnable, gated
// configuration a user can trigger manually or schedule daily.
model CampaignAutomation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  name   String

  // Lead source — extraction (this automation's own saved find/location/params,
  // the exact same param keys POST /api/jobs already reads) OR a personal
  // uploaded list (personalListId = an upload SearchJob's id, template:"upload").
  leadSource      String   @default("extract") // "extract" | "personal_list"
  findTerms       String[] @default([])
  locationTerms   String[] @default([])
  params          Json? // engine, maxResults, minResults, pagesPerQuery, resultMode, emailDomains
  // Task 29, item 2 — personal_list source can now select MULTIPLE uploaded
  // lists (replaces the old single personalListId). A run pulls validated leads
  // from every selected SearchJob id, deduping by email across all of them.
  personalListIds String[] @default([])

  // Campaign + mailbox — HARD GATE per Task 09: both required to even CREATE
  // this row. campaignTemplateId references one of the user's OWN EmailCampaign
  // rows (tier (a) template); each run clones it into a fresh EmailCampaign.
  campaignTemplateId String
  mailboxIds         String[] @default([])

  // Trigger
  triggerMode     String  @default("manual") // "manual" | "daily"
  scheduleHour    Int? // 0-23, UTC — only meaningful when daily
  scheduleEnabled Boolean @default(true) // pause/resume a daily automation

  createdAt DateTime                @default(now())
  lastRunAt DateTime?
  runCount  Int                     @default(0)
  runs      CampaignAutomationRun[]

  @@index([userId])
  @@index([triggerMode, scheduleEnabled])
}

// One row per execution of a CampaignAutomation. Extraction runs async through
// the normal SearchJob pipeline; an internal sweep advances a run from
// extraction to the send phase once its SearchJob reaches a terminal state.
model CampaignAutomationRun {
  id           String             @id @default(cuid())
  automationId String
  automation   CampaignAutomation @relation(fields: [automationId], references: [id])

  startedAt             DateTime  @default(now())
  extractionCompletedAt DateTime?
  completedAt           DateTime?
  // "running" | "needs_confirmation" | "done" | "failed" | "stopped"
  status                String    @default("running")

  leadSource          String // snapshot of the automation's leadSource at run time
  searchJobId         String? // the SearchJob this run used
  leadsExtracted      Int? // number of VALIDATED leads eligible for sending
  campaignId          String? // the EmailCampaign this run created/queued
  emailsSent          Int? // recipients queued into the campaign at the send phase
  emailsSentByMailbox Json? // { [mailboxId]: count } — rotation visibility
  errorMessage        String?

  @@index([automationId, startedAt])
}

// Task 30, item 3 — optional link-redirect cloaking. The task explicitly scopes
// this to "doesn't visually announce itself as a tracking/redirect link", not
// cryptographic security: the token is a public opaque lookup key (the route is
// world-readable), so it carries no secret. Out of scope: per-click timestamps,
// per-recipient attribution, domain rotation, automatic (non-optional) wrapping.
model LinkRedirect {
  id         String         @id @default(cuid())
  // Opaque, url-safe lookup key for GET /r/<token>. __no secret__ — the counter
  // is a plain aggregate, and an unknown/expired token must 404 cleanly.
  token      String         @unique
  // TASK_155 P2 — owner (owner, 2026-10-01): user-owned short links. A NULL
  // userId is the anonymous campaign-cloaked link Task 30 created (unknown to any
  // account); a non-NULL userId is a link the user created in the Hosting tab.
  // Plain scalar, matching HostedAsset.userId, so the User model needs no edit.
  userId     String?
  // TASK_155 P2 — optional friendly slug, so /r/<slug> resolves as well as
  // /r/<token>. Validated against SLUG_RE (lib/hosting/rules.ts) before it is
  // stored; NULL for token-only links (every anonymous link today).
  slug       String?        @unique
  campaignId String?
  campaign   EmailCampaign? @relation(fields: [campaignId], references: [id])
  // The real destination this cloaked link redirects to.
  target     String
  // Optional friendly label (e.g. the link's anchor text) for the create-modal
  // preview; informational only.
  label      String?
  // Plain per-link click counter (aggregate only, no timestamps/attribution).
  clickCount Int            @default(0)
  createdAt  DateTime       @default(now())

  // TASK_155 P6c — the LINKS engine. Additive only, every column has a default or
  // is nullable, so all 12 Task 30 campaign links (userId NULL) read back as
  // engine "local" and keep resolving on /r/<token> exactly as they did.
  // "local"   — our metal, resolved by app/r/[token] (always still available)
  // "cloudflare" — a per-user Cloudflare Worker serves the 302 on <customHost>
  engine String @default("local")
  // Which credential published it: a HostingCredential id (BYO), or NULL when the
  // platform roster served it. attribution only — never a secret.
  credentialId String?
  // The one-script-per-user name (sw-<hash>) and the route pattern it is bound to.
  // Both are needed at TEARDOWN to find what to delete, which is why they are
  // stored rather than recomputed from the zone.
  workerName   String?
  routePattern String?
  // The host the Worker answers on, e.g. "go.instaweb.top".
  customHost String?
  // "pending" | "live" | "error". An error here must NOT hide the link: /r still
  // works, so the user's link exists either way.
  deployStatus String @default("pending")
  // Plain-language reason from Cloudflare, safe to show the user. No tokens.
  deployError String?

  @@index([campaignId])
  @@index([userId])
  @@index([engine])
}

// TASK_155 P2 — a user's own hosting credential (BYO Cloudflare account id +
// API token), so a file can be hosted on the platform engine OR the user's own
// account. The owner (2026-10-01): "option for users to add their own cf tokens
// and id, and if users add multiple like 3, we should be able to switch between
// them for hosting". `isDefault` marks the one used unless a request picks
// another, so N credentials are representable before any multi-select UI lands.
//
// The token is NEVER stored in plaintext and is NEVER returned by any route: it
// is encrypted at rest with the existing MAILBOX_ENCRYPTION_KEY helpers
// (lib/mailbox-crypto.ts), the same AES-256-GCM pattern the SMTP passwords use.
// `tokenHint` keeps the last 4 chars only, so the UI can label a credential
// without ever holding the secret.
model HostingCredential {
  id        String   @id @default(cuid())
  userId    String
  // Which engine this credential is for: "cloudflare" today (an R2/S3 or other
  // engine can reuse the same row shape).
  provider  String   @default("cloudflare")
  // The user's own account identifier (Cloudflare account id). Not a secret.
  accountId String
  // A human label so several credentials are distinguishable ("Work", "Trial").
  label     String
  // AES-256-GCM ciphertext of the API token — never plaintext, never returned.
  tokenCiphertext String
  tokenIv         String
  tokenTag        String
  // Last 4 chars of the token, for a non-secret UI hint only.
  tokenHint String
  // TASK_155 P6c — the SECOND Cloudflare token: the one that can publish
  // Worker scripts and edit DNS (`Workers Scripts:Edit` + `DNS:Edit`). The
  // Pages token above is scoped to Pages and CANNOT upload a Worker script, so
  // links get their own credential rather than widening the Pages token.
  // OPTIONAL and independently encrypted with the same AES-256-GCM helpers;
  // NULL = the user never added one, and the link engine stays on its local
  // /r/<token> fallback. Never plaintext, never returned — only the hint.
  workerTokenCiphertext String?
  workerTokenIv         String?
  workerTokenTag        String?
  // Last 4 chars of the Workers token, for a non-secret UI hint only.
  workerTokenHint String   @default("")
  // Plain-language reason the Workers token failed to verify, or NULL when
  // healthy/absent. Never contains the token.
  workerTokenError String?
  // The credential used when a request does not name one. Exactly one row per
  // user+provider is default; the API clears the previous default on switch.
  isDefault Boolean  @default(false)
  // "active" | "revoked" — revoked rows are kept for audit, never used.
  status    String   @default("active")
  // TASK_155 P3 — verify-on-save (§16.4: "Verify on save, and re-verify on use").
  // Last time `GET /user/tokens/verify` (+ a cheap Pages read) confirmed the token.
  // NULL = never verified (e.g. added while offline). The UI shows this as the
  // "last-verified" stamp on the Connection chooser row.
  lastVerifiedAt DateTime?
  // Plain-language reason the last verify failed, or NULL when healthy. A non-null
  // value marks the row RED and the engine fails CLOSED — it never silently falls
  // back to the platform account. Never contains the token.
  verifyError    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, provider])
}

// TASK_155 P6a (PLAN §19) — OUR Cloudflare accounts, managed by the admin and
// rotated across premium users ("ours should be the premium"). Deliberately NOT
// a HostingCredential: there is no userId (ownership is the platform) and no
// isDefault (rotation is `priority`). Same AES-256-GCM token discipline — the
// token is NEVER plaintext and NEVER returned by any route; the view carries
// only `tokenHint` (last 4 chars). Rotation = the healthy row with the LOWEST
// priority serves; unhealthy rows (verifyError non-null or status != "active")
// are SKIPPED, never used. Purely ADDITIVE: no existing table changes shape.
model HostingPlatformAccount {
  id        String   @id @default(cuid())
  // Cloudflare account id (not a secret) — shown in the admin list.
  accountId String
  // Human label ("cf-main", "cf-backup-2").
  label     String
  // AES-256-GCM ciphertext of the API token — never plaintext, never returned.
  tokenCiphertext String
  tokenIv         String
  tokenTag        String
  // Last 4 chars of the token, for a non-secret UI hint only.
  tokenHint String @default("")
  // TASK_155 P6c — the SECOND token for this platform account: the one that can
  // publish Worker scripts and edit DNS (`Workers Scripts:Edit` + `DNS:Edit`).
  // The Pages token above cannot upload a Worker script, so the owner pastes a
  // Workers/DNS token here and can REPLACE it from this panel at any time
  // without disturbing the Pages rotation. OPTIONAL and independently encrypted
  // with the same AES-256-GCM helpers; NULL = links keep the local /r/<token>
  // fallback. Never plaintext, never returned by any route — only the hint.
  workerTokenCiphertext String?
  workerTokenIv         String?
  workerTokenTag        String?
  // Last 4 chars of the Workers token, for a non-secret UI hint only.
  workerTokenHint String @default("")
  // TASK_157 Phase 1 — the workers.dev subdomain we have CONFIGURED for this
  // account (e.g. "spaceworker"). This is ACCOUNT-scoped in Cloudflare, not
  // per-Worker, so it lives here and not on a single link. It is public data (it
  // is part of the hostname), never a secret. NULL = we never set it; Cloudflare's
  // own value is authoritative. Set live from the admin panel; changing it
  // re-points every Worker in the account at once, which is why the panel warns.
  workersDevSubdomain String?
  // Plain-language reason the Workers token failed to verify, or NULL when
  // healthy/absent. Never contains the token.
  workerTokenError String?
  // TASK_158 W0 — the THIRD token: the account-scoped ZONES token, the one that
  // can CREATE a zone and manage its DNS (`Account -> Zone Settings:Edit` +
  // `Zone:DNS:Edit` + zone create). Probing showed every token we hold is
  // REFUSED zone creation with `403 com.cloudflare.api.account.zone.create`, so
  // until one of these exists, user-owned custom domains stay a two-step job
  // (verify ownership, then the owner adds the domain in Cloudflare).
  //
  // Stored SEPARATELY and OPTIONALLY for exactly the reason the Pages and Workers
  // tokens are: a Cloudflare token is scoped, and widening one of the others to
  // reach zones would hand every site deploy a zone-admin credential. NULL = this
  // row cannot create zones, which is NOT an error — it is the normal state until
  // an account-scoped token is configured. Same AES-256-GCM helpers, never
  // plaintext, never returned by any route — the view carries only the hint.
  zoneTokenCiphertext String?
  zoneTokenIv         String?
  zoneTokenTag        String?
  // Last 4 chars of the Zones token, for a non-secret UI hint only.
  zoneTokenHint String @default("")
  // Plain-language reason the Zones token failed to verify, or NULL when
  // healthy/absent. Never contains the token.
  zoneTokenError String?
  // Rotation order: the healthy row with the LOWEST priority serves. 1 = primary.
  priority  Int      @default(100)
  // "active" | "disabled" — disabled rows are kept, never used.
  status    String   @default("active")
  // Same health contract as HostingCredential: NULL lastVerifiedAt = never
  // verified; non-null verifyError marks the row RED and rotation skips it.
  // Never contains the token.
  lastVerifiedAt DateTime?
  verifyError    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority])
}


// Task 31, item 3 — the Automations "Ask the agent" feature. Threads, messages,
// and TTL-gated pending actions that implement the approval-gated tool calling
// (Channelry's "Agent Decider System" precedent, reimplemented here in the
// SpaceWorker schema — no shared library across the two repos). The agent never
// creates a real SearchJob or EmailCampaign; it only proposes one as an
// AgentPendingAction row. A human approval (PATCH .../approve) executes it for
// real through the exact same creation helpers POST /api/jobs and POST
// /api/campaigns use.

model AgentThread {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]

  @@index([userId])
}

model AgentMessage {
  id           String      @id @default(cuid())
  threadId     String
  thread       AgentThread @relation(fields: [threadId], references: [id])
  // "user" | "assistant" — every row is a literal turn in the chat panel.
  role         String
  content      String
  // Snapshot of the pending job/campaign the assistant proposed (the tool_call
  // channelryAiChat returned), so the plan card can be re-rendered without
  // re-deriving it from free text on every reload.
  toolCall     Json?
  // Task 37 — snapshot of an inline structured pick (lead-source dropdown,
  // upload dropzone, or mailbox picker) the assistant offered, so a reload
  // still renders the widget instead of losing it. Mutually exclusive with
  // toolCall (a turn either proposes or asks a structured question).
  inlineWidget Json?
  createdAt    DateTime    @default(now())

  @@index([threadId, createdAt])
}

model AgentPendingAction {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  // "job" | "campaign"
  kind               String
  // "pending" | "approved" | "rejected" | "expired" | "executed". A proposal is
  // only ever turned into a REAL job/campaign exactly once, on explicit human
  // approval, via the "approved" -> "executed" transition.
  status             String   @default("pending")
  payload            Json
  // The assistant's prose that described this plan (shown as the plan card's
  // supporting text).
  proposal           String?
  // One-hour TTL: an unapproved plan silently expires rather than lingering.
  expiresAt          DateTime
  executedJobId      String?
  executedCampaignId String?
  createdAt          DateTime @default(now())

  @@index([userId, status])
}

// Task 40 — per-user daily AI cost attribution. An append-only audit log of the
// REAL cost Channelry reported for each completed AI call (never an estimate),
// mirroring this codebase's preference for auditable rows over mutable counters
// (DeliverabilityCheck, NotificationLog). "Today" is a SUM over rows with
// createdAt >= startOfTodayUTC — correct even under concurrent requests, where a
// mutable counter would need a transaction to avoid a race. Enforced + written
// in lib/agent.ts's runAgentTurn (the one user-facing channelryAiChat call site).
//
// Units are hundredths of a cent everywhere to match Channelry's own usage block
// (cost_hundredths_cent) and User.aiDailyCapHundredthsCent — never divide by 100.
// The admin test-connection button is deliberately NOT logged here (it's an
// admin diagnostic, not a real user's usage).
model AiUsageLog {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  // The REAL cost_hundredths_cent Channelry returned for this call. Always the
  // reported value verbatim (rounded to an int for storage); 0-cost rows are
  // skipped so the log only ever holds meaningful, real spend.
  costHundredthsCent Int
  // e.g. "agent_turn". A future caller's event name, kept free-form (no enum)
  // so new callers don't require a migration to start logging.
  eventType          String
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

// Tier 1 trial — append-only per-user, per-tool usage audit log, mirroring the
// proven AiUsageLog pattern (Task 40): "today" is a SUM over rows with
// createdAt/usedOn >= startOfTodayUTC, race-safe under concurrency unlike a
// mutable counter. One row is written per completed tool run (a SearchJob
// extraction or an EmailCampaign send batch macro-window), carrying the ACTUAL
// elapsed wall-clock seconds of that run — never a reserved/declared duration.
//
// Which "tool" a row belongs to is the tool family (BUILD_TARGET contract, and
// what the EXE products/Payment rows name): extractor / mailer / combined /
// automation. The four web-app product surfaces map directly: lead extraction =
// extractor, outreach campaigns = mailer, an extraction feeding a campaign in
// one flow = combined, an automation-scheduled run = automation. A given lane/
// pipeline always maps to exactly one tool so a user can never spend the trial
// twice on the same feature under a different name.
//
// Tier 1 users are hard-capped at 900s per tool per UTC day at admission; tier 5
// (Premium) is exempt and never logs here. Enforced in
// app/api/internal/dispatch/route.ts Phase A (before a job/campaign is claimed).
model ToolUsageLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  // Tool family this run belonged to: "extractor" | "mailer" | "combined" |
  // "automation" (see toolForLane mapping in lib/trial.ts). Free-form string on
  // storage, bounded at the write site so new tools don't need a migration.
  tool           String
  lane           String
  // The ACTUAL wall-clock seconds of this run (dispatch start → terminal state).
  elapsedSeconds Int
  // UTC day this usage counted toward — YYYY-MM-DD, matching startOfTodayUTC().
  // Written at run completion so a run spanning UTC midnight lands wholly on the
  // day it STARTED, giving a predictable, easy-to-explain boundary.
  usedOn         String
  // The SearchJob / EmailCampaign this run measured (for auditing).
  jobId          String?
  createdAt      DateTime @default(now())

  @@index([userId, tool, usedOn])
  @@index([userId, createdAt])
}

// ============================================================================
// Task 92 — Assistant foundation (device layer + entitlements core).
// Plan: PLAN_NOW_ASSISTANT_AND_CYBER_LAB.md §SCHEMA + §CROSS-TRACK RULES.
// The Device* family is the SHARED device layer every device-side feature
// (Vantra plugin, Browser Clone, Cyber Lab) must consume — nobody invents
// their own identity, approval, audit, or panic primitives (Michael directive).
// Audit rows deliberately survive the deletion of the thing they audited:
// pendingActionId/cloneId are PLAIN SCALARS (no FK, no cascade) on purpose.
// ============================================================================

model Device {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  name                 String
  // "workstation" | "hosted" — hosted = a SpaceWorker-run PC (Browser Clone
  // destination, arriving in Task 97); everything else is the user's own.
  deviceKind           String    @default("workstation")
  // Device identity = the user's Vantra agent (plan: VantraLink arrives in
  // Task 93, so this is nullable until provisioning wires it). Unique so a
  // heartbeat can look the device up by agent id alone.
  vantraAgentId        String?   @unique
  // "online" | "offline" | "asleep" | "unknown" — derived from heartbeat age.
  status               String    @default("unknown")
  osName               String?
  osVersion            String?
  // Free-form hardware summary snapshot (cpu/ram/disk) from the agent.
  hardwareSummary      Json?
  lastSeenAt           DateTime?
  // 2026-09-26 — the device-status sweep's own memory of what it last saw for
  // THIS device, distinct from `status` (which is a broader derived label
  // including "asleep"/"unknown"). Null means "never swept yet" so a brand
  // new device's first sweep never fires a spurious online/offline
  // notification — same reasoning as Vantra's DeviceStatusSnapshot.
  lastNotifiedOnline   Boolean?
  // TASK_119: live session capture credential (SHA-256 hash only, never raw token).
  // Unique, nullable (only devices capable of live capture have this set).
  // Revoke by setting to null; cleared on job teardown.
  liveCaptureTokenHash String?   @unique

  // TASK_123 (B12) — Wake-on-LAN P1. Recorded OURSELVES at setup time
  // (lib/clone-setup.ts, the same SYSTEM-side block that writes
  // live-capture.json) — never sourced from MeshCentral's `if<node>` record,
  // which is the target's own self-reported MAC (root cause R1) and useless
  // for waking a machine that's already asleep. `powerLanSubnet` is the
  // computed /24 (e.g. "192.168.0.0/24") lib/wol.ts's selectWolPeer matches
  // peers against — D2, never MeshCentral's same-mesh relay (R2).
  powerMac                    String?
  powerLanIp                  String?
  powerLanSubnet              String?
  powerMacUpdatedAt           DateTime?
  // TASK_127 — per-device OPT-IN for Phase 1 screenshot monitoring. This is the
  // consent boundary the task doc makes non-negotiable ("Any capture without the
  // device owner's explicit per-device opt-in" is an explicit non-goal), so it is
  // a per-DEVICE switch, not merely a global admin toggle: one device being
  // monitored must never silently monitor the user's other machines. Default
  // false — a device nobody opted in is never captured.
  screenshotMonitoringEnabled Boolean   @default(false)
  // TASK_128 — which org the agent was last listed under, stamped by
  // syncDevices() from the Vantra `sw/devices` response: "public" until the
  // Vantra auto-move lands, "private" after. Existing rows default to
  // "public" (the additive migration changes no behaviour), so the row can
  // honestly show `Public` / `Private` and the onboarding strip never claims a
  // move that did not happen.
  tier                        String    @default("public")
  // 2026-09-27 — per-device schedule override. Null (the default) means "use
  // the admin's global screenshotCaptureIntervalMinutes" — most devices never
  // need this. Set means THIS device is captured on its own cadence instead,
  // e.g. compressing a test window to 1 minute without touching every other
  // opted-in device's schedule.
  screenshotIntervalMinutesOverride Int?
  // 2026-09-27 — "start monitoring N minutes after this device comes back
  // online," for a device that's opted in while offline (or regularly sleeps)
  // — a grace period so capture doesn't start the instant the machine wakes,
  // before whoever's using it has settled in. Null/0 = start as soon as it's
  // online and due, same as today's behaviour.
  screenshotWakeDelayMinutes  Int?
  // Internal bookkeeping (never user-set directly): when THIS module last
  // observed the device transition offline -> online. Cleared back to null
  // the moment it's seen offline again, so the delay above is measured from
  // the MOST RECENT wake, never a stale one. Deliberately owned entirely by
  // lib/device-screenshots.ts (set/cleared inside listDueDevices) rather than
  // the heartbeat ingest path, so this feature needs no changes there.
  screenshotOnlineSinceAt     DateTime?
  // TASK_128 §15 — soft removal (the owner's Delete button, both tiers). A real
  // `db.device.delete()` is not available here: every Device child foreign key
  // except DeviceScreenshot/DeviceOnboarding defaults to RESTRICT, and a device
  // ALWAYS has DeviceHeartbeat rows, so a hard delete would throw a
  // foreign-key violation — and clearing the children first would destroy the
  // audit trail the console's Activity tab is built on. `removedAt` set ⇒ the
  // device is gone from the list and its console (filtered at the query, not
  // cosmetically), the Vantra/TRMM agent is really gone (the delete route
  // uninstalls it FIRST, and refuses to set this column if that failed), and
  // the machine's history is preserved.
  removedAt                   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heartbeats            DeviceHeartbeat[]
  capabilities          DeviceCapability[]
  jobs                  DeviceJob[]
  actions               DeviceAction[]
  queuedCommands        DeviceQueuedCommand[]
  pinRequests           DevicePinRequest[]
  powerPolicy           DevicePowerPolicy?
  outgoingRelationships DeviceRelationship[]   @relation("sourceDevice")
  incomingRelationships DeviceRelationship[]   @relation("targetDevice")
  audits                DeviceAudit[]
  // TASK_127 — Phase 1 captured frames for this device.
  screenshots           DeviceScreenshot[]
  // TASK_128 — the visible onboarding-quarantine state machine (one row while
  // the device is public / being moved; terminal once released or failed).
  onboarding            DeviceOnboarding?
  // Task 97 — Browser Clone. A device can be the capture SOURCE (the user's
  // work PC) and/or the clone DESTINATION (a hosted clone PC, deviceKind
  // "hosted"), and it can host the egress relay and the browser sessions.
  cloneSourceJobs       CloneJob[]             @relation("cloneSource")
  cloneDestinationJobs  CloneJob[]             @relation("cloneDestination")
  relays                RelayHealth[]
  hostedSessions        HostedBrowserSession[]

  // TASK_152 M5 — screen-monitoring trigger config + cooldown state.
  screenTriggers        ScreenTrigger[]
  screenTriggerStates   ScreenTriggerState[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, powerLanSubnet])
}

model DeviceHeartbeat {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id])
  agentVersion String?
  ipAddress    String?
  // Strictly whitelisted telemetry ONLY (heartbeats, sampling counters, reach
  // flags). Never generalized into a "collect arbitrary data" sink — plan
  // CROSS-TRACK RULE 2 (telemetry is a lesser secrets class but still scoped).
  telemetry    Json?
  createdAt    DateTime @default(now())

  @@index([deviceId, createdAt])
}

model DeviceCapability {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  // e.g. "wake" | "script-run" | "remote-session" | "browser-clone-source".
  // Metadata only — the ABILITY to do something, not a queued thing to do.
  capability String
  enabled    Boolean  @default(true)
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([deviceId, capability])
  @@index([deviceId])
}

model DeviceJob {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id])
  jobType    String
  // "queued" | "running" | "succeeded" | "failed" | "cancelled".
  status     String    @default("queued")
  payload    Json?
  result     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([deviceId, status])
}

model DeviceAction {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id])
  // PLAIN SCALAR on purpose — the device-side lifecycle must survive a
  // pendingAction being deleted; the AgentPendingAction row itself is the
  // approval gate, this row is the device-side realization of it.
  pendingActionId String?
  actionType      String
  // "requested" | "approved" | "executing" | "executed" | "failed" |
  // "rejected" | "expired" | "cancelled".
  status          String    @default("requested")
  payload         Json?
  result          Json?
  error           String?
  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  executedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([deviceId, status])
  @@index([pendingActionId])
}

model DeviceAudit {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  // "user" | "agent" | "admin" | "system" | "device".
  actor     String   @default("system")
  // "web" | "telegram" | "api" | "device" | null.
  channel   String?
  event     String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

model DeviceRelationship {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  sourceDeviceId String
  sourceDevice   Device   @relation("sourceDevice", fields: [sourceDeviceId], references: [id])
  targetDeviceId String
  targetDevice   Device   @relation("targetDevice", fields: [targetDeviceId], references: [id])
  // "same-org-peer" | "relay" | "clone-source" | "clone-destination".
  relationType   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceDeviceId, targetDeviceId, relationType])
  @@index([userId])
}

model DevicePowerPolicy {
  id        String    @id @default(cuid())
  deviceId  String    @unique
  device    Device    @relation(fields: [deviceId], references: [id])
  // "off" | "timed" | "indefinite" (keep-awake; WoL state rides Device.status).
  mode      String    @default("off")
  until     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ActivityRollup {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  // UTC midnight of the covered day; unique per user so a re-fired sweep
  // can't double-digest (idempotency guard).
  rollupDate           DateTime
  digestText           String
  // Plain scalar — the rollup must survive thread deletion.
  agentThreadId        String?
  // REAL Channelry cost of producing this digest (AiUsageLog eventType
  // "assistant_digest" holds the matching spend row).
  aiCostHundredthsCent Int      @default(0)
  deliveredChannels    String[] @default([])
  createdAt            DateTime @default(now())

  @@unique([userId, rollupDate])
  @@index([userId, rollupDate])
}

// Task 92 + plan §COMMERCIAL C1 — THE entitlement gate. Every feature checks
// capabilities here, never tiers (lib/entitlements.ts is the only reader).
// Tier 5 implicitly allows every key (premium reversion from lib/premium.ts),
// so a row is only needed for grants that must survive a downgrade.
// Expiry mirrors Task 55 lazy semantics: expired => deny + stamp revokedAt once.
model UserEntitlement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  // One of lib/entitlements.ts ENTITLEMENT_KEYS ("extractor" | "mailer" |
  // "assistant" | "devices" | "cyberlab").
  key       String
  // "module" | "admin_grant" | "trial".
  source    String    @default("module")
  // NULL = never expires; non-NULL = lazy-reverted on read (Task 55 pattern).
  expiresAt DateTime?
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// Plan §SCHEMA — canonical PRODUCT audit for gated agent/device actions.
// pendingActionId / sourceDeviceId / destinationDeviceId / cloneId are plain
// scalars so audits survive deletion of the audited object (same rule as
// DeviceAction). Low-level RMM/Mesh logs stay infrastructure-only.
model AgentActionAudit {
  id                  String   @id @default(cuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id])
  pendingActionId     String?
  action              String
  // "created" | "approved" | "rejected" | "executed" | "failed" | "expired".
  status              String
  initiatingChannel   String   @default("web") // "web" | "telegram" | "api" | "system"
  approvalChannel     String? // "web" | "telegram" | "admin"
  sourceDeviceId      String?
  destinationDeviceId String?
  cloneId             String?
  detail              Json?
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([pendingActionId])
}

// Task 93 — the SpaceWorker↔Vantra plugin link. Exactly ONE per user
// (userId unique): enabling the Assistant provisions a hidden Vantra org
// named `sw-<userId>` (server-side, via Vantra's /api/internal/sw/* routes,
// bearer-authed with VANTRA_INTERNAL_TOKEN — that env var exists ONLY on the
// VPS .env, added by hand over ssh; NEVER committed, NEVER rsynced — deploys
// use rsync --exclude='.env', codified in HOW_WE_MOVE_FAST.md §2).
// agentTokenEnc: reserved for a future per-org agent credential (NULL today;
// the Vantra API key never leaves Vantra's server). installTokenHash: SHA-256
// of the one-time install-link token (the raw token exists only in the
// user's browser at click time). Status: "pending_install" | "active" |
// "revoked" | "error". Deleting the link never deletes audit rows.
model VantraLink {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  orgId                 String
  orgName               String
  agentTokenEnc         String?
  status                String    @default("pending_install")
  installTokenHash      String?
  installTokenExpiresAt DateTime?
  installUrl            String?
  lastSyncedAt          DateTime?
  lastError             String?
  // The Vantra org's agent-domain tier at last sync ("public" | "private").
  // The Add-a-device panel's Public/Private toggle reads this: the toggle is
  // enabled only while the user's org has the private tier (premium, admin
  // granted); free/trial users have a public-only org and the toggle is
  // disabled. Storing the tier per link keeps the decision local — no Vantra
  // round-trip just to render the panel.
  orgTier               String    @default("public")
  // The private-tier companion org (`sw-<userId>-p` in Vantra), provisioned
  // on demand once the user's premium/admin gate passes. Devices added via
  // the public link silently auto-move into it (Vantra Task 64); the
  // Add-a-device Private tab mints its PowerShell install command directly.
  privateOrgId          String?
  // Last-minted private PowerShell install command (masked in the UI until
  // the user reveals it). Re-minted on demand; never shown without session.
  privatePsCommand      String?
  privatePsExpiresAt    DateTime?
  // Task 121 (OOB-13) — the PUBLIC install artifact. A public mint used to ask
  // Vantra for a download URL and then re-ask on EVERY link open; with the
  // launcher ZIP (Vantra's own Add-a-device artifact, renameable) that would
  // mean a secret-bearing generator call per click, so the minted result is
  // remembered here instead (§4a, Q1 decided).
  // `installerUrl` is the raw generator/agent download URL and is SERVER-ONLY:
  // the redirect in resolveInstallToken is the only place it is read, and it is
  // never serialised into a view model, API response, log line or audit row
  // (`toView` is the only shape that leaves lib/vantra-link). The row already
  // stores something strictly more sensitive — `privatePsCommand`, a complete
  // install command carrying a token — so this is not a new exposure class.
  installerUrl          String?
  // The sanitised { zipName, updateLinkName, innerFolder } the user chose, so a
  // re-mint (a row minted before this change, or one whose stored URL was
  // cleared) reuses their names instead of resetting them to the defaults.
  installerNamesJson    String?
  // "zip" | "exe" — "zip" ⇒ the public link serves the launcher ZIP; NULL ⇒ a
  // pre-Task-121 row, which keeps behaving exactly like before.
  installerKind         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([orgId])
  @@index([status])
}

// ============================================================================
// Task 95 — Devices v2 tool parity (remote control / maintenance / PIN /
// queued commands). SpaceWorker-side mirrors of the Vantra plugin mechanics,
// keyed to OUR Device rows so ownership + audit stay in OUR db.
// ============================================================================

// Mirror of Vantra's QueuedAgentCommand (Task 18 there): a command queued for
// an OFFLINE device, fired by the online-transition sweep on the Vantra side
// (app/api/internal/telegram-device-check fireQueuedCommands). SpaceWorker
// stores its own row so the user sees/cancels THEIR commands with OUR
// ownership checks; vantraQueueId links to the Vantra row for status polling.
// timeoutSeconds matches Vantra's ceiling (90) so a queued command can never
// outrun what a live run allows.
model DeviceQueuedCommand {
  id               String    @id @default(cuid())
  deviceId         String
  device           Device    @relation(fields: [deviceId], references: [id])
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  // "cmd" | "powershell" (Vantra's shell enum).
  shell            String    @default("powershell")
  cmd              String
  timeoutSeconds   Int       @default(30)
  runAsUser        Boolean   @default(false)
  // "queued" | "sent" | "failed" | "cancelled".
  status           String    @default("queued")
  vantraQueueId    String?
  error            String?
  // Schedule flavor: "next_checkin" fires on the device's next online poll;
  // "after_wake" additionally waits `wakeDelayMinutes` from the moment the
  // device COMES ON (online transition) before firing — the user-visible
  // "run 10/20 min after the device comes on" option.
  scheduleKind     String    @default("next_checkin")
  wakeDelayMinutes Int       @default(0)
  createdAt        DateTime  @default(now())
  sentAt           DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([deviceId, status])
  @@index([userId, createdAt])
}

// Task 95 — one PIN-unlock request (Vantra's DeviceCredentialRequest pattern,
// minimized): a one-time token goes into the on-device prompt; the device
// POSTs the typed PIN to OUR public callback, we store it HERE and the user
// copies it from the Devices page. The pin is stored as the user gave it
// (short-lived secret, row prunable) — never logged, never in audit detail.
model DevicePinRequest {
  id          String    @id @default(cuid())
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  pinLength   Int
  // "pending" | "submitted" | "expired" | "cancelled".
  status      String    @default("pending")
  // TASK_148 — "customer" | "admin". WHICH side asked for this PIN.
  //
  // This column exists for one reason: silence. executePinRequest stores the
  // COLLECTED PIN on this row, and the owner's console reads the table by
  // {deviceId, userId} with no other filter — so an admin-collected PIN would
  // appear in the reported user's own PIN panel, PIN and all. Rows written by
  // the admin tools are marked "admin" and excluded from that list; the admin
  // reads them through app/api/admin/**. Default keeps every pre-existing row a
  // customer row.
  origin      String    @default("customer")
  tokenHash   String    @unique
  expiresAt   DateTime
  pin         String?
  submittedAt DateTime?
  sourceIp    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deviceId, status])
  @@index([userId, createdAt])
}

// ============================================================================
// Task 97 — Browser Clone
// ----------------------------------------------------------------------------
// Moves a user's browser environment (Chrome/Edge/Firefox profile: cookies,
// sessions, extensions) from their work PC (Device A, `deviceKind
// "workstation"`) to a hosted SpaceWorker PC (Device B, `deviceKind "hosted"`),
// then lets the user drive that browser from the SpaceWorker web app — egressing
// as the work PC's network identity via the CloneRelay, never the hosted PC's.
//
// Michael's directive (plan §PRIORITY P2) is the design law here: the clone is
// a first-class CAPABILITY of the shared device layer, NOT a parallel subsystem.
// Consequently this section deliberately REUSES rather than duplicates:
//   - device identity      -> Device / DeviceHeartbeat (Task 92)
//   - the approval gate    -> AgentPendingAction via pendingActionId (ONE gate;
//                             agent-initiated clones only — a manual owner clone
//                             executes directly, like every other manual tool)
//   - audit                -> AgentActionAudit (action "browser-clone", carrying
//                             sourceDeviceId / destinationDeviceId / cloneId)
//   - device communication -> VantraLink / internal sw routes (no new transport)
//   - lifecycle + revocation -> `status` here, wired into the SAME total panic
//                             switch (lib/devices.ts panicStopAllDevices)
//   - credential boundary  -> clone material is a HIGHER security class than
//                             telemetry (CROSS-TRACK RULE 6): the AI/agent layer
//                             receives capabilities + results, NEVER raw cookies,
//                             passwords or session tokens. Raw capture material
//                             lives only in the agent->agent transfer.
// ============================================================================

// The egress relay a clone browser must exit through. One row per source device
// (the work PC runs michael/browser-clone/cmd/relay). Doubles as the registry
// AND the current health record — health fields are updated in place, mirroring
// Device.status/lastSeenAt rather than an append-only log, because the only
// question the launch path asks is "is this relay usable RIGHT NOW?".
//
// The relay token is a security-class secret: only its SHA-256 is stored, and
// the raw value is handed to the agent at launch via the job env — never
// persisted, never logged (MT-1 contract: no plaintext secrets anywhere).
model RelayHealth {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  // Device A — the work PC that hosts the relay (originates the user's IP).
  deviceId            String
  device              Device    @relation(fields: [deviceId], references: [id])
  // Reachable address the launched browser is pointed at, e.g. "127.0.0.1:8118"
  // (agent-forwarded) or "host:port" when the work PC exposes it directly.
  addr                String
  tokenHash           String
  // "unknown" | "up" | "down"
  status              String    @default("unknown")
  lastSeenAt          DateTime?
  lastCheckAt         DateTime?
  // Consecutive failed probes. Drives the fail-closed gate (deliverable 4) and
  // the agent-side watchdog that kills a clone whose relay dropped.
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  cloneJobs CloneJob[]

  @@unique([deviceId])
  @@index([userId, status])
}

// One clone attempt end-to-end. The record is kept (audit value) — only the
// STAGING MATERIAL (the encrypted capture on the hosted PC) is deleted on
// revoke/expiry, and inactive records are purged after `clonePurgeAfterDays`
// (owner 2026-10-01: users may also delete their own records).
model CloneJob {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  // Device A — capture source (the user's work PC).
  sourceDeviceId      String
  sourceDevice        Device       @relation("cloneSource", fields: [sourceDeviceId], references: [id])
  // Device B — clone destination (a hosted clone PC from the pooled host).
  // Nullable: capture starts before a pool slot is granted, so a job can exist
  // (and be retried) while the resource governor is holding it in the queue.
  destinationDeviceId String?
  destinationDevice   Device?      @relation("cloneDestination", fields: [destinationDeviceId], references: [id])
  relayId             String?
  relay               RelayHealth? @relation(fields: [relayId], references: [id])
  // Lifecycle (TASK_109 canonical union — TEXT, not a DB enum, the codebase's
  // style, with this list as the documented value set):
  //   requested | awaiting_source | awaiting_capture | capturing | captured
  //   | transferring | received | injecting | ready | launching | active
  //   terminal: expired_idle | expired_hard | revoked | deleted | failed
  // TASK_119A V9: awaiting_capture is a hosted `live` job's own wait state —
  // see lib/clone.ts's PIPELINE_NEXT doc comment for why it is not a reuse
  // of awaiting_source.
  // Forward-only; the UI maps these to human copy, never raw enums (DESIGN §3).
  status              String       @default("pending")
  // Kept separate from `status` because a clone can be fully captured and
  // transferred yet never launched, and a launched clone can be stopped without
  // ending its record. "not_launched" | "launching" | "running" | "stopped".
  launchState         String       @default("not_launched")
  // The ONE gate. Set when the clone came from an approved agent-initiated
  // proposal; NULL for a manual owner-initiated clone (no approval — owner rule:
  // approvals are for agents only). PLAIN SCALAR, deliberately FK-less: an audit
  // row must survive the thing it audited (plan RULE 5), so revoking/purging the
  // proposal can never cascade a clone record away.
  pendingActionId     String?
  // The ENGINE-side registry id (`hack-browser-clone` clone id on the work PC).
  // Also a plain scalar, not a row in this DB: it is stamped into every
  // AgentActionAudit row (action "browser-clone") so this record and the engine's
  // own append-only audit can be correlated. NULL until the capture step returns.
  cloneId             String?
  // Egress policy ACTUALLY used: "relay" (same IP as the work PC — default,
  // fails closed) | "direct" (hosted PC's own IP — PREMIUM ONLY, explicit
  // `--proxy-optional` path). Never a silent fallback; also written to the audit.
  egressMode          String       @default("relay")
  // TASK_119: session delivery mode. "fresh" (route 3, existing, logs in for
  // itself) | "live" (new, carries user's real session via CDP). Default "fresh"
  // means existing behaviour is unchanged.
  sessionMode         String       @default("fresh")
  browser             String
  // TASK_97/PLAN call this `browserProfileRef` — kept as `profileName` because
  // DESIGN_BROWSER_CLONE_UI_AND_FLOW §3 maps the UI's "Browser / profile" column
  // to exactly `browser, profileName`. Same value: the engine profile name.
  profileName         String?
  // Encrypted capture location on the hosted PC. Cleared (and the material
  // deleted) on revoke/expiry/purge — records outlive material by design.
  stagingRef          String?
  // Evidence only — sizes and counts, never content.
  archiveBytes        Int?
  fileCount           Int?
  // MT-1 capture exit code: 0 success | 1 partial | 2 fail.
  captureExitCode     Int?
  error               String?
  // Q1 (DESIGN_BROWSER_CLONE_UI_AND_FLOW §7): both come from AdminSetting
  // (cloneIdleTtlMinutes / cloneHardTtlMinutes) and are stamped per job so a later
  // admin change never retroactively expires a live session.
  idleExpiresAt       DateTime?
  expiresAt           DateTime?
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  // 30-day inactive purge (owner 2026-10-01). Swept by the clone-sweep timer.
  purgeAfter          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  session HostedBrowserSession?

  // Read paths the UI + sweeps actually use (TASK_107 deliverable 1):
  //   history list            -> userId + createdAt
  //   "clones of this device" -> sourceDeviceId / destinationDeviceId + status
  //   idle-TTL sweep          -> status + idleExpiresAt
  //   hard-TTL sweep          -> status + expiresAt
  //   record purge sweep      -> status + purgeAfter
  @@index([userId, createdAt])
  @@index([sourceDeviceId, status])
  @@index([destinationDeviceId, status])
  @@index([status, idleExpiresAt])
  @@index([status, expiresAt])
  @@index([status, purgeAfter])
}

// The live browser process on the hosted PC that a clone launched. This is the
// RAM consumer the admin caps (`cloneMaxConcurrent` / `clonePerUserCap`) and the
// thing the panic switch must kill. Exists only while the session runs.
model HostedBrowserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  // The hosted clone PC running the browser.
  deviceId         String
  device           Device    @relation(fields: [deviceId], references: [id])
  cloneJobId       String?   @unique
  cloneJob         CloneJob? @relation(fields: [cloneJobId], references: [id])
  // "starting" | "running" | "stopped" | "failed"
  status           String    @default("starting")
  // Loopback CDP/debug endpoint on the hosted PC that the viewer drives.
  cdpPort          Int?
  viewUrl          String?
  // The address the session actually egressed as, captured at launch: the proof
  // that "same IP" really meant the work PC's IP (relay) or the hosted PC's
  // (direct). Recorded, never inferred.
  egressIp         String?
  egressMode       String    @default("relay")
  // TASK_119: live session capture metadata (NEVER stores values, counts only).
  // Present only for sessionMode="live" clones; null for "fresh".
  sessionMode      String? // "fresh" | "live"; redundant with CloneJob but stamped here for audit
  cookieCount      Int? // count of cookies captured, never values
  domainCount      Int? // count of unique cookie domains
  sessionTruncated Boolean   @default(false) // whether the jar was incomplete
  capturedAt       DateTime? // when the capture was ingest'd
  startedAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  stoppedAt        DateTime?
  expiresAt        DateTime?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([deviceId, status])
}

// TASK_105 — the resource governor's durable WAIT LIST.
//
// One row per admission request the governor could not grant immediately. The
// point of persisting it is the acceptance rule "a queued request survives a
// service restart": the in-memory notion of a queue lives here instead, so
// `systemctl restart spaceworker` loses nothing. The sweep timer drains it
// (deploy/governor-sweep.timer) and every caller re-checks its own entry.
//
// Deliberately SEPARATE from DeviceJob (the clone pipeline's own "queued"
// projection, lib/clone.ts): DeviceJob is clone-specific, while this table
// holds every high-RAM feature (clone sessions, the hosted pool, extraction
// lanes, browser sessions, device actions). `feature` + `ref` is what makes a
// repeated request idempotent — a clone polling its admission three times
// (create → capture step → launch step) re-uses ONE row and keeps ONE position.
//
// Status union (TEXT + documented, the codebase style — no DB enum):
//   queued | granted | released | expired | cancelled
//     queued    = waiting; counted by the admin panel's "queued" column
//     granted   = admitted (terminal for that ref — the admission record)
//     released  = a grant that is no longer meaningful (sweep closes it so the
//                 table cannot grow without bound)
//     expired   = waited past governorQueueTimeoutSec without a slot
//     cancelled = the caller (or the global panic switch) withdrew it
model GovernorQueueEntry {
  id          String    @id @default(cuid())
  // Registry key: "dispatchLight" | "dispatchHeavy" | "browserSessions" |
  // "vantraLinks" | "deviceActions" | "cloneSessions" | "hostedPool".
  feature     String
  userId      String
  // Operational wait state, NOT an audit record, so it cascades with the user
  // (plan RULE 5 applies to audit rows, which must outlive their subject; a
  // stale wait-list row for a deleted account has nothing to preserve).
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The caller's stable handle (e.g. a CloneJob id). Two requests with the same
  // (feature, ref) share ONE row, which is how FIFO position stays stable while
  // a caller polls. NULL when the caller has no durable id.
  ref         String?
  // Class at enqueue time: "premium" | "standard" | "trial".
  priority    String    @default("standard")
  status      String    @default("queued")
  // FIFO rank snapshot (1 = next), recomputed whenever the queue is read. The
  // authoritative order is always recomputed from the rows; this is the number
  // the UI shows ("2 ahead of you").
  position    Int       @default(0)
  // Set when a free/trial request has waited past
  // governorStarvationPromoteMin and is promoted into the premium class.
  promotedAt  DateTime?
  // Why it was queued (or released) — a stable machine-ish reason string.
  reason      String?
  requestedAt DateTime  @default(now())
  grantedAt   DateTime?
  // requestedAt + governorQueueTimeoutSec, stamped at enqueue so the sweep needs
  // no settings read to find expired rows.
  expiresAt   DateTime?
  expiredAt   DateTime?

  @@index([feature, status, priority, requestedAt])
  @@index([feature, ref, status])
  @@index([userId, status])
  @@index([status, expiresAt])
}

// TASK_127 Phase 1 — one captured FRAME of a device's screen.
//
// The bytes NEVER live in Postgres. A frame row holds a RELATIVE path under the
// screenshot root (resolved by lib/device-screenshots.ts), matching this
// codebase's existing discipline of keeping large/sensitive artefacts out of the
// database (worker files, browser profiles). Base64-in-a-column was explicitly
// ruled out by the task doc — a day of frames would bloat every backup and every
// query that touches the row.
//
// A row is ALSO the slot. `status = "capturing"` is exactly what the governor's
// `deviceScreenshots` liveCount counts, so a capture holds its admission for
// precisely as long as it is really running — the same "the live count IS the
// slot" design a CloneJob uses (TASK_105 has no explicit release call). That is
// why the row is created BEFORE the browser starts and updated when it finishes,
// and why the sweep reaps rows stuck in "capturing": a worker killed mid-capture
// must never wedge the concurrency cap forever.
//
// Status union (TEXT + documented, the codebase style — no DB enum):
//   capturing | captured | failed
//     capturing = in flight right now; HOLDS a governor slot
//     captured  = a real frame is on disk at filePath
//     failed    = no frame; failureReason says why (offline, no_session, timeout)
model DeviceScreenshot {
  id            String    @id @default(cuid())
  deviceId      String
  // Operational capture state, not an audit record — cascades with its device
  // and user (same reasoning as GovernorQueueEntry: a frame of a deleted
  // account's screen has nothing to preserve, and the file is deleted with it).
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "capturing" | "captured" | "failed"
  status        String    @default("capturing")
  // Path RELATIVE to the screenshot root — never absolute (so the root can move
  // without rewriting rows), and never the bytes themselves.
  filePath      String?
  bytes         Int?
  width         Int?
  height        Int?
  // Why a failed capture failed — a stable machine-ish reason string.
  failureReason String?
  // ---------------------------------------------------------------------
  // TASK_152 M3 — the per-frame SUMMARY (the owner's "summary section").
  //
  // TWO INDEPENDENT AXES, deliberately kept apart:
  //   failureReason describes the CAPTURE (did we get a frame at all?).
  //   summaryError  describes the SUMMARISATION (why is there no summary?).
  // A captured frame with no summary is NORMAL, never an error: it may not
  // have been summarised yet, or the owner's daily AI budget ran out. The UI
  // must not render a missing summary as a capture failure.
  //
  // summary       = the AI-written description of what was on screen. NULL
  //                 until summarisation succeeds (or if it never can).
  // summaryError  = why a CAPTURED frame has no summary — "cap_exhausted",
  //                 "ai_unavailable", "summary_parse_failed", ... NULL when a
  //                 summary exists OR summarisation was never attempted.
  // summaryModel  = which model/route produced the text (cost-gate audit).
  // summarisedAt  = when the summary was written.
  // imagePurgedAt = set by retention when the RAW image was deleted but the
  //                 SUMMARY was kept (purgeExpiredFrames: text outlives pixels
  //                 — deliberate and documented, not an accident).
  summary       String?
  summaryError  String?
  summaryModel  String?
  summarisedAt  DateTime?
  imagePurgedAt DateTime?
  // ---------------------------------------------------------------------
  // TASK_157 — the FREE TEXT LAYER (OCR), which is now the PRIMARY source
  // for a summary rather than a fallback.
  //
  // The relay's vision leg is DOWN (live probe 2026-10-02: messages+tools+
  // image_url returns 502 "AI service temporarily unavailable"), while the
  // same relay answers plain TEXT calls with a 200. So the image can no longer
  // be the thing we send. Instead we read the words OFF the frame locally
  // (tesseract.js — no network, no key, no meter) and summarise THAT.
  //
  // This is the owner's "if the summary doesn't work, users still get the
  // extraction" guarantee made real: ocrText survives cap_exhausted,
  // ai_unavailable and a bad day, because nothing about producing it depends
  // on the AI at all.
  //
  // ocrText is deliberately NULLABLE and additive: a frame captured before this
  // column existed simply has null here and is rendered as before.
  ocrText       String?
  // Set when the frame's text was read. Separate from ocrText's own emptiness
  // so "OCR ran and found nothing on a black screen" (ocrText = "") is
  // distinguishable from "OCR has not run yet" (null).
  ocrAt         DateTime?
  // 0-100 OCR engine confidence, kept for the UI to explain a poor read and
  // for triage (a frame below ~40 is usually a blank/locked screen).
  ocrConfidence Int?
  // TASK_152 M5 — set the moment this frame's summary has been CHECKED against
  // the owner's triggers (whether or not one fired). This is what makes the
  // trigger pass a one-shot work queue instead of re-scanning every summary on
  // every sweep: a frame is evaluated once, then never looked at again. Null on
  // every pre-M5 frame and on any frame whose summary does not exist yet — the
  // pass selects `summary != null AND triggerEvaluatedAt IS NULL`.
  triggerEvaluatedAt DateTime?
  // The UTC day this frame belongs to, stamped at insert so Phase 2's daily
  // summary is one indexed range read instead of a timezone computation per row.
  summaryDate   DateTime
  // When the frame was actually TAKEN (set on completion, not on insert — the
  // row is created before the browser launches so it can hold the slot).
  capturedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Read paths that actually exist (TASK_107 discipline — index what is queried):
  //   the governor's live count    -> status ("capturing")
  //   a device's frames for a day  -> deviceId + summaryDate
  //   the retention purge          -> summaryDate + status
  //   a user's recent frames       -> userId + createdAt
  //   the trigger pass's work queue -> summaryDate + triggerEvaluatedAt (TASK_152 M5)
  @@index([status])
  @@index([deviceId, summaryDate, status])
  @@index([userId, createdAt])
  @@index([summaryDate, status])
  @@index([summaryDate, triggerEvaluatedAt])
}

// TASK_152 M6 — the capture scheduler's PERSISTED per-user ROTATION cursor.
//
// WHY THIS IS A TABLE AND NOT A MODULE VARIABLE: the whole point of rotation is
// that it survives a restart. A capture pass runs in a short-lived sweep process
// (deploy/screenshot-sweep.timer → app/api/internal/screenshot-sweep), so an
// in-memory cursor would reset to "start at the first device" on every tick and
// the LAST device would never be sampled. This row is the durable handoff.
//
// WHAT IT MEANS: `cursorDeviceId` is the LAST device the current slice served,
// and `rotatedAt` is when that slice was served. A pass reads the cursor, serves a
// slice of `min(granted slots, roster)` devices STARTING ONE STEP AFTER
// `cursorDeviceId` (wrapping), and — only once `rotatedAt` is older than the
// admin's `screenshotRotationSliceMinutes` — starts a fresh slice, moving the
// cursor to that slice's last device so the next window continues from there.
// Within the window a rotating user serves NOTHING (its other devices are simply
// deferred), which is what gives each device its 20-30 min turn. Nothing here
// gates admission: the governor's `deviceScreenshots` slot is still the ONLY
// thing that decides whether a capture may run (schema.prisma:298-303 forbids a
// parallel counter). This table only decides WHO to ASK about.
//
// ONE row per user (`@unique userId`). It is operational state, not an audit
// record, so it cascades with the account (same reasoning as GovernorQueueEntry).
model ScreenshotRotationCursor {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The LAST device the current rotation slice served. The next slice resumes one
  // step after it (wrapping), so the advance is correct even if the granted slot
  // count changes between slices. Nullable because the very first pass for a user
  // has no cursor yet (and because the device may later be removed — a dangling id
  // degrades to "start at the first eligible device").
  cursorDeviceId String?
  // When the current slice began. The cursor advances only once this is older
  // than screenshotRotationSliceMinutes, which is what makes a device hold its
  // turn for the owner's 20-30 min before the next device takes over.
  rotatedAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// TASK_152 M5 — a user-defined trigger for screen-monitoring notifications.
//
// FIRST VERSION IS TEXT/KEYWORD ONLY (the owner's example: "the screen shows a
// balance"). `keyword` is matched case-insensitively as a substring of the
// AI-written frame SUMMARY (DeviceScreenshot.summary) — there is NO visual or
// complex-event matching in this version, by design (stated in the writeup).
//
// Scope: deviceId null => every monitored device of this user; set => only that
// device. A trigger belongs to the USER (it is their notification) and is
// deleted with the account.
model ScreenTrigger {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // null = all of this user's monitored devices; set = this device only.
  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // The word/phrase to look for in a frame summary. Stored trimmed; matched
  // case-insensitively as a plain substring (never a regex — a user-supplied
  // regex is a cost/DoS foot-gun and buys nothing for this version).
  keyword  String
  // Optional human label used in the notification ("Balance shown"). Falls back
  // to the keyword when absent.
  label    String?
  // The per-trigger off switch, independent of the account master switch.
  enabled  Boolean @default(true)
  // Minimum minutes between two firings of THIS trigger on the SAME device.
  // Without this, a "balance" that stays on screen would fire on every capture.
  // Default 120 (2 hours); bounded 1..1440 at the API edge.
  cooldownMinutes Int @default(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states   ScreenTriggerState[]

  @@index([userId])
  @@index([userId, enabled])
}

// TASK_152 M5 — the COOLDOWN STATE for one (trigger, device) pair: when this
// trigger last fired for this device. A row appears only AFTER a firing, so a
// never-fired trigger has no row. This is STATE, not a delivery log — every
// actual delivery is recorded on the existing NotificationLog (never here).
model ScreenTriggerState {
  id          String        @id @default(cuid())
  triggerId   String
  trigger     ScreenTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  deviceId    String
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  lastFiredAt DateTime

  @@unique([triggerId, deviceId])
}

// TASK_152 M5 — one DELIVERED periodic screen-monitoring digest. Mirrors
// ActivityRollup's idempotency: unique (userId, windowStart) means a re-fired
// sweep can never double-send the same window. Covers ALL of the user's
// monitored devices for [windowStart, windowEnd) in ONE message.
model ScreenDigestRollup {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStart DateTime
  windowEnd   DateTime
  deviceCount Int
  digestText  String
  createdAt   DateTime @default(now())

  @@unique([userId, windowStart])
  @@index([userId, windowStart])
}

// TASK_128 — the device onboarding quarantine ("one process at a time").
//
// One row per device: the visible state machine behind the Devices-page strip.
// The public→private MOVE itself stays Vantra's (lib/device-auto-move.ts) — this
// row only records the SpaceWorker-side stages (hide@5, stay-on@10) and mirrors
// the release once the device is observed in the private org. `timerStartedAt`
// is COPIED from Vantra's DeviceAutoMove.timerStartedAt (never invented locally)
// so the countdown the owner sees is the same clock that will actually fire the
// move.
//
// GRACE, not a deadline (owner rule): the 20-minute window is the PLAN. A device
// still public at 20 is neither released nor failed — the row stays live and
// keeps being retried, and `releasedAt` is only ever set on a real release
// (observed private, or a free/trial account with no destination). Only the
// ceiling (ONBOARDING_CEILING_MINUTES) turns "still public" into `failed`.
//
// Status union (TEXT + documented, the codebase style — no DB enum):
//   pending | hiding | staying_on | moving | released | failed
//     pending    = idle / waiting for the next threshold
//     hiding     = the hide command is in flight (crash-safe claim)
//     staying_on = the indefinite keep-awake apply is in flight (crash-safe claim)
//     moving     = the window reached 15 min, so the move is due (non-terminal)
//     released   = terminal, SUCCESS: observed private, or no destination at all
//     failed     = terminal, and NEVER silent: a stage exhausted
//                  ONBOARDING_MAX_ATTEMPTS, or the ceiling passed with the device
//                  still public. The device is left Public and fully usable, and
//                  the row keeps a red badge plus a page-level alert naming it.
//
// Exactly-once discipline mirrors device-auto-move.ts: a `*DoneAt` timestamp —
// not a claim clock — is what makes a stage run once, and a row left in
// hiding/staying_on with its `*DoneAt` null by a dead request is re-adopted
// as unclaimed on the next sweep (no staleness timer). `claimAt` is diagnostic
// only and is never a gate.
model DeviceOnboarding {
  id               String    @id @default(cuid())
  deviceId         String    @unique
  // Operational lifecycle state, not an audit record — cascades with its device
  // and user (same reasoning as DeviceScreenshot: an onboarding row for a
  // deleted device has nothing to preserve).
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The Vantra agent id this row tracks (plain scalar — the row is operational
  // state keyed by our own Device.id, not a second identity layer).
  vantraAgentId    String
  // The public org the device was listed under, and the private companion it is
  // moving to. `destinationOrgId` is null for a free/trial account with no
  // private org — the UI words that as "stays on your public agent".
  sourceOrgId      String
  destinationOrgId String?
  // Copied from DeviceAutoMove.timerStartedAt on row creation. NEVER overwritten
  // by a later sync (an existing row keeps the clock that is already running).
  timerStartedAt   DateTime  @default(now())
  // The label the hide stage used ("Microsoft System Services" by default);
  // editable later from the console's existing Agent visibility card.
  hideLabel        String?
  // Set when the hide command reported success — the exactly-once gate for the
  // hide stage. `hideOutput` keeps the script's STEP: lines for the console.
  hideDoneAt       DateTime?
  hideOutput       String?
  // Set when setPowerPolicy("indefinite") applied — the exactly-once gate for
  // the stay-on stage (stopped by the technician from the console).
  stayOnDoneAt     DateTime?
  // When the device was observed in the private org (release via tier).
  movedAt          DateTime?
  // Set ONLY on a real release — observed private, or a free/trial account with
  // no destination at the plan. Never set on `failed`, so the row can never read
  // as a success it did not achieve.
  releasedAt       DateTime?
  // "pending" | "hiding" | "staying_on" | "moving" | "released" | "failed".
  status           String    @default("pending")
  // Per-stage transient-failure retries, capped by ONBOARDING_MAX_ATTEMPTS — a
  // stage that can never succeed must end `failed`, never retry forever. An
  // OFFLINE skip never increments this: an offline box retries indefinitely.
  attempts         Int       @default(0)
  // Why a row is not moving (a failed stage, or the ceiling with the device
  // still public). Surfaced in the console and the strip, never swallowed.
  lastError        String?
  // Diagnostic only — the last claim timestamp; never a staleness gate.
  claimAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Read paths that actually exist (TASK_107 discipline — index what is queried):
  //   the sweep's non-terminal scan -> status
  //   a user's onboarding rows      -> userId + status
  @@index([status])
  @@index([userId, status])
}

// TASK_139 — self-serve DKIM for mail we relay.
//
// SpaceWorker's own relay (127.0.0.1:587, OpenDKIM) exists so a customer's
// broken or unreachable third-party SMTP server cannot stop campaigns going
// out. Accepting the mail is only half of it: a recipient's server also has to
// believe the From domain is allowed to send, and that proof lives in the From
// domain's DNS. That is a one-time DNS edit the customer does themselves
// (exactly as Resend/SendGrid/Mailgun all require) — NOT a dependency on their
// mail server, and nothing here needs that server to be reachable or fixed.
//
// One row per (user, domain): the keypair we sign with, the exact record the
// customer must publish, and whether the published value actually matches it.
model SendingDomain {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Lowercased registrable name ("acme.com"). Unique per user rather than
  // globally: two tenants can legitimately each send as a domain they
  // separately control, and the relay's KeyTable is addressed by the full
  // "<selector>._domainkey.<domain>" key name anyway.
  domain           String
  selector         String   @default("sw")
  // "v=DKIM1; k=rsa; p=..." — the exact value to publish at
  // <selector>._domainkey.<domain>. Stored so verification can prove the value
  // that IS published matches the key we actually sign with: a stale or
  // mismatched record fails DKIM identically to "nothing published", and this
  // is the only way to tell those two apart.
  publicKeyTxt     String
  // The signing key itself, encrypted exactly like a mailbox password
  // (lib/mailbox-crypto, MAILBOX_ENCRYPTION_KEY). Stored so the key can be
  // re-installed after a relay rebuild or a failed install: without it, losing
  // /etc/opendkim would force every customer to publish a brand new DNS record.
  encryptedPrivateKey String
  privateKeyIv        String
  privateKeyTag       String
  // "pending" | "verified" | "invalid". DNS state only — see installedOnRelay
  // for the relay side, deliberately tracked separately so a later DNS lapse
  // cannot hide a key that is still installed (and vice versa).
  status           String   @default("pending")
  // True once the private key is on disk for OpenDKIM and listed in
  // KeyTable/SigningTable. A domain can be installed but not yet verified
  // (normal while DNS propagates) — signing then simply doesn't authenticate.
  installedOnRelay Boolean  @default(false)
  lastCheckedAt    DateTime?
  // One line per record ("DKIM: found; SPF: missing <ip>; DMARC: not found") so
  // the panel can say WHY a domain is not verified yet instead of a bare ✗.
  lastCheckDetail  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, domain])
  // Verification and the relay writer both look a domain up by name.
  @@index([domain])
}

// TASK_146 — admin-side device control: the append-only log of commands the
// admin ran on a customer's machine from /admin.
//
// Why a NEW table instead of reusing the existing audit rails: every one of
// them is read back into a surface the CUSTOMER can see, so writing an admin
// run there would not be silent —
//   • lib/digest.ts:59 collects DeviceAudit per user and prints the event names
//     into their daily digest email,
//   • DeviceQueuedCommand is listed by /api/devices/[deviceId]/queued-commands
//     and rendered in the console's Command tab,
//   • AgentActionAudit is the product-side "your activity" stream.
// This model has no reader anywhere outside app/api/admin/** — nothing in
// app/, components/ or lib/ queries it for a customer — so an admin run can
// never surface on the owner's side (explicit requirement: "all silent").
//
// deviceId/userId are plain strings with NO foreign keys ON PURPOSE: an audit
// row has to outlive the row it describes (same posture as DeviceAudit keeping
// its rows after a device is soft-deleted, TASK_128 §15).
model AdminDeviceCommand {
  id             String   @id @default(cuid())
  // Groups one bulk fan-out ("run this on 12 machines") — null for a single
  // run from the per-device console. Indexed so a batch can be read back.
  batchId        String?
  deviceId       String
  userId         String
  // Admin sessions are a shared passcode today (lib/admin-auth.ts: sub is
  // always "admin"), so this is constant for now — a column anyway so adding
  // per-admin accounts later is a value change, not a migration.
  actor          String   @default("admin")
  // TASK_147 — "command" | "remote-control". Opening the remote-control viewer
  // is not a command, but it IS something the admin did to a customer's machine
  // and has to be answerable later, so it rides this admin-only rail instead of
  // getting a second table. Default keeps every pre-existing row a command.
  kind           String   @default("command")
  shell          String   @default("powershell")
  cmd            String
  timeoutSeconds Int      @default(30)
  runAsUser      Boolean  @default(false)
  // "ok" | "failed".
  status         String
  output         String?
  error          String?
  createdAt      DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([userId, createdAt])
  @@index([batchId])
}

// TASK_155 P1 — the FILES engine. One row per hosted thing (a file today; pages
// and redirects reuse this shape in P2/P3 via `kind`). Deliberately mirrors the
// live LinkRedirect pattern (opaque `token` = lookup key, never a bearer secret)
// and the `/e/<name>` rename insight from PLAN §4: the SERVED filename is a
// column (`dispositionFilename` + `mime`), NEVER a namespace on disk, so a rename
// writes only this row and `sha256` (the bytes) is provably unchanged.
//
// `userId` is a plain scalar (no Prisma relation), matching AdminDeviceCommand
// above — this table never needs a User back-relation and adding one would edit
// the User model for no gain.
model HostedAsset {
  id        String  @id @default(cuid())
  userId    String
  // "file" today; "page" | "redirect" reserved for P2/P3.
  kind      String  @default("file")
  // The user's label / original filename (informational, shown in the list).
  name      String
  // Opaque, url-safe public lookup key for GET /hf/<token>. __no secret__ — like
  // LinkRedirect.token, an unknown/expired/private token must 404 cleanly.
  token     String  @unique
  // Optional friendly slug for the P2 short-link promotion (user-owned redirects).
  slug      String? @unique
  // Which storage engine holds the bytes: "local" (our metal) | "cloudflare"
  // (Pages) | "external" (pluggable). The bytes' LOCATION is `storagePath`
  // (provider-relative) or `externalId` (a remote key); never both required.
  provider  String  @default("local")
  storagePath  String?
  externalId   String?
  // Content hash — the acceptance anchor: sha256(before) == sha256(after) a rename.
  sha256    String
  bytes     Int
  mime      String
  // The filename sent in Content-Disposition. THIS is what "rename" changes.
  dispositionFilename String
  // "public" | "private" — private needs an authorised (session) download path.
  visibility String  @default("public")
  // "active" | "deleted" — soft delete so a mis-delete is recoverable + auditable.
  status     String  @default("active")
  expiresAt  DateTime?
  // Cached public URL (derived from HOSTING_PUBLIC_BASE_URL at upload time so a
  // host change does not silently rewrite already-handed-out links).
  url        String?
  downloadCount Int    @default(0)
  // Cumulative bytes served (bandwidth). BIGINT: a 50 GB/month cap exceeds Int32.
  bytesServed   BigInt @default(0)
  uploadIp      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([userId, status])
  @@index([status, expiresAt])
}

// TASK_155 P1 — per-user, per-calendar-month download bytes, so the bandwidth cap
// (§14 hostingFreeMaxBandwidthGbPerMonth) is enforced against a resettable counter
// rather than only the all-time HostedAsset.bytesServed. `period` is "YYYY-MM"
// (UTC) — a plain string so the key is human-readable in the DB and needs no TZ maths.
model HostingUsageMonthly {
  id          String   @id @default(cuid())
  userId      String
  period      String
  bytesServed BigInt   @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, period])
}

// TASK_155 P3 — a hosted SITE (a static folder that was zipped, extracted,
// previewed and published). PLAN §16.1/§16.2: the engine is a PER-ITEM column
// ("local" = our own metal, free; "cloudflare" = premium Pages), so a user can
// host one site on our server and another on Cloudflare at the same time. The
// account a site was built on is IMMUTABLE (moving it is the §16.2 migration).
//
// `previewToken` and `liveToken` are opaque, url-safe lookup keys (never secrets,
// exactly like HostedAsset.token) — the preview and live serve routes resolve a
// token to this row. A site is DARK until a revision is published: `liveToken`
// is NULL and the live URL 404s.
model HostingSite {
  id        String  @id @default(cuid())
  userId    String
  // The user's label for the site (informational).
  name      String
  // "local" | "cloudflare" — the §16.2 per-item engine.
  engine    String  @default("local")
  // The BYO/platform credential used for a cloudflare site (NULL = platform
  // account). Immutable once the site has a published revision.
  credentialId String?
  // Opaque preview lookup key for GET /pv/<token>/… . Minted at creation so the
  // first deploy can preview immediately. Never a secret.
  previewToken String @unique
  // Opaque LIVE lookup key for GET /hs/<token>/… . NULL until the first publish —
  // that is what makes a site "not live yet".
  liveToken    String? @unique
  // "draft" | "previewed" | "published" | "failed" — a coarse site state; the
  // per-revision state machine lives on HostingRevision.
  status    String  @default("draft")
  // Cloudflare project name for a premium site (slugified from `name`), NULL for
  // a local site. Used by the Pages REST client.
  cfProject String?
  // The live deployment URL (a *.pages.dev URL for premium, the /hs/<token> URL
  // for local) — cached so the UI can show it without recomputing.
  liveUrl   String?
  previewUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// TASK_155 P3 — one revision of a site: an uploaded+extracted tree that can be
// previewed and (deliberately) published. PLAN §16.1's four states are modelled
// here (`state`), and the last `hostingPublishedRevisionsKept` (default 3)
// published revisions are kept so "undo my last publish" is a DB pointer change,
// never a Cloudflare delete.
//
// `manifest` maps a site-relative path ("/index.html") to its content hash — the
// exact shape the Pages Direct-Upload `deployments` call wants (§9 T0), so a
// publish on the premium engine is a manifest-only call when the bytes are
// already uploaded. `storagePath` is the extracted staging tree on our metal
// (provider-relative), used by the local engine to serve preview/live.
model HostingRevision {
  id        String  @id @default(cuid())
  siteId    String
  userId    String
  // "uploaded" | "extracted" | "previewed" | "published" | "rejected" | "expired"
  // (the §16.1 state machine).
  state     String  @default("uploaded")
  // The original archive filename the user dropped (informational).
  archiveName String?
  // Bytes of the uploaded archive.
  archiveBytes Int    @default(0)
  // Extracted file count + total extracted bytes (what the quota counts).
  fileCount Int    @default(0)
  bytes     BigInt @default(0)
  // Path→hash manifest (Json) — see the model comment.
  manifest  Json?
  // Where the extracted tree lives on our metal (local engine).
  storagePath String?
  // Cloudflare deployment id + its URL (premium engine).
  cfDeploymentId String?
  cfUrl     String?
  // The revision's own preview token (local engine serves /pv/<token>/…), so each
  // revision previews independently.
  previewToken String @unique
  // When it was published to live (NULL until published).
  publishedAt DateTime?
  // When an unpublished preview expires (swept by a later job).
  expiresAt DateTime?
  // §16.6 heavy-load metrics, recorded so the later resource-governor task can
  // see and shape the load. peakRssMb is best-effort (the shell-out's own report).
  entries   Int    @default(0)
  durationMs Int   @default(0)
  peakRssMb Int    @default(0)
  // Why a revision was rejected (plain language), NULL when fine.
  rejection String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, state])
  @@index([userId, createdAt])
}

// TASK_155 P3 — the §16.6 single-slot lock + load metrics for a heavy hosting
// job (a zip extract or a Pages deploy). At most `hostingMaxHeavyJobsPerUser`
// rows are "running" for one user at a time, so two heavy ops never run at once
// for one tenant. Every job records bytesProcessed/entries/durationMs/peakRssMb
// so the LATER resource-governor task has real numbers to shape (A8: build first,
// update the governor later — this run does NOT touch lib/resource-governor.ts).
model HostingJob {
  id        String   @id @default(cuid())
  userId    String
  siteId    String?
  // "extract" | "deploy" | "upload".
  kind      String
  // "running" | "done" | "failed".
  status    String   @default("running")
  bytesProcessed BigInt @default(0)
  entries   Int      @default(0)
  durationMs Int     @default(0)
  peakRssMb Int      @default(0)
  error     String?
  startedAt DateTime @default(now())
  finishedAt DateTime?

  @@index([userId, status])
}


// ===========================================================================
// TASK_156 C1 — the Cyber Lab schema (PLAN_TASK_156 §6, extended by §12.1/§12.8).
// ===========================================================================
//
// Purely ADDITIVE: ten new EMPTY tables. Applying the C1 migration rewrites no
// existing row and changes no existing behaviour — nothing reads these yet (the
// engine is C2+, gated behind the AUP and the premium `cyberlab` entitlement).
//
// Every `userId`/`*Id` column is a plain scalar with an index and NO foreign key,
// on purpose — the same rule HostingSite / AgentActionAudit already follow: a lab
// attestation, consent record or evidence bundle must survive the deletion of the
// thing it describes, and a run must never be cascade-deleted by an unrelated
// cleanup. There is deliberately no "delete history" path (§5.2.6).
//
// §12.9 — where a field is named `author` or `audience` and documented "staff", read
// it as an AUDIENCE/tier label (internal/operator, usable before the L4 fences), NOT
// a staff-role gate. C1 builds no staff badge; the gate is the premium entitlement.

// §6 — a machine the engine may run on. NEVER the production VPS: enforced in code
// (lib/lab/gate.ts refuses a LabHost that resolves to the app host) AND surfaced as a
// warning in the admin Research page.
model LabHost {
  id          String   @id @default(cuid())
  label       String
  // "caldera" | "victim" | "relay" | "collector".
  kind        String
  // Never public: a private/LAN address or a device id. Admin-visible only.
  address     String
  // A reference to a secret (e.g. a HostingCredential id or an env key name) used to
  // reach the host — never the secret itself.
  authRef     String?
  enabled     Boolean  @default(false)
  ramBudgetMb Int      @default(2048)
  tags        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, enabled])
}

// §6 — an allow-listed scenario: the unit a user runs. `techniqueIds` are ATT&CK ids
// and `author` is an AUDIENCE/tier label (§12.9), not a role gate.
model LabScenario {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  // The lab class: "email" | "dns" | "server" | "network".
  klass                String
  // ATT&CK technique ids this scenario exercises (Json array of strings).
  techniqueIds         Json?
  adversaryProfile     String?
  requiredCapabilities Json?
  // Plain-language statement of the worst thing this can touch.
  blastRadius          String?
  cleanup              String?
  enabled              Boolean  @default(false)
  // §12.9 — an AUDIENCE label ("staff" = internal/operator tier), not a role.
  author               String   @default("staff")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([klass, enabled])
}

// §6 — one run instance of a scenario (the "range"): the pending→provisioning→active
// →tearing_down→torn_down|failed state machine, with a hard TTL and a verified teardown.
model LabRange {
  id                 String   @id @default(cuid())
  userId             String
  scenarioId         String
  // pending | provisioning | active | tearing_down | torn_down | failed.
  state              String   @default("pending")
  ttlExpiresAt       DateTime?
  // The LabConsent row in force when this run started (provenance for the audit).
  consentId          String?
  credentialRef      String?
  // The resource-governor slot this run holds (TASK_105 requestSlot). RECORDED here so
  // the later governor task can see the load — never a second admission authority.
  queuedSlotId       String?
  // Set only when a teardown was VERIFIED (§8.5); a failed teardown raises an incident.
  teardownVerifiedAt DateTime?
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, state])
  @@index([state, ttlExpiresAt])
}

// §6 — THE attested inventory item: the legal spine of the product (§5). Every
// scenario target must match a row here for that user, checked pre-flight.
// `kind` is "host" | "network" | "url" | "domain" | "email" — the last two are the
// §12.2/§12.3 email + DNS classes the owner's addendum added.
model LabTarget {
  id            String   @id @default(cuid())
  userId        String
  rangeId       String?
  kind          String
  value         String
  attestedAt    DateTime @default(now())
  attestationId String?
  createdAt     DateTime @default(now())

  @@unique([userId, kind, value])
  @@index([userId])
}

// §6 — the evidence bundle for a run: the timeline, the ATT&CK techniques observed,
// the telemetry signatures, and a signed manifest of the raw evidence files. C3 fills
// it; C1 only creates the table.
model LabEpisode {
  id                  String    @id @default(cuid())
  rangeId             String
  userId              String
  startedAt           DateTime?
  endedAt             DateTime?
  timeline            Json?
  techniques          Json?
  telemetrySignatures Json?
  outcome             String?
  // Paths + SHA-256 of the raw evidence (Json) — the artefact a simulator cannot fake.
  evidenceManifest    Json?
  // Signature over the manifest so an episode cannot be edited after the fact.
  signedHash          String?
  createdAt           DateTime  @default(now())

  @@index([rangeId])
  @@index([userId, createdAt])
}

// §6 — one finding from an episode, with a self-relation so a RETEST can point at the
// finding it re-tests (retest tracking without a second table).
model LabFinding {
  id          String    @id @default(cuid())
  episodeId   String
  userId      String
  severity    String
  title       String
  detail      String?
  // The finding this one re-tests (NULL = an original finding).
  retestOf    String?
  exportedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([episodeId])
  @@index([retestOf])
}

// §6 — a Sigma-class detection pack derived from an episode (C5). `audience` is an
// AUDIENCE/tier label (§12.9): "staff" | "pro" | "all".
model DetectionPack {
  id                   String    @id @default(cuid())
  version              String
  rulesJson            Json
  // The episode that validated this pack (C5 detect-then-defend loop).
  validatedByEpisodeId String?
  shippedAt            DateTime?
  audience             String    @default("staff")
  createdAt            DateTime  @default(now())

  @@index([audience])
}

// §6 — the AUP/consent record (C0). APPEND-ONLY: never updated, only superseded by a
// new row when the terms version changes. `hash` is a SHA-256 over the canonical terms
// text + userId + termsVersion, so the exact text a user accepted is provable later.
model LabConsent {
  id           String   @id @default(cuid())
  userId       String
  // The AUP version accepted (matches AdminSetting.cyberlabConsentTermsVersion).
  termsVersion String
  // What the user consented to: "lab" today (the AUP covers hosting + lab, §13.5).
  scope        String   @default("lab")
  signedAt     DateTime @default(now())
  ip           String?
  hash         String

  @@index([userId, termsVersion])
}

// §5.2 — the abuse sentinel's output: a refusal/anomaly becomes a report, the admin is
// notified, and the account may auto-freeze. Append-only; the status is the review state.
model LabAbuseReport {
  id               String    @id @default(cuid())
  userId           String
  rangeId          String?
  reason           String
  evidenceJson     Json?
  severity         String    @default("low")
  // open | frozen | cleared.
  status           String    @default("open")
  reviewedByAdminId String?
  createdAt        DateTime  @default(now())
  reviewedAt       DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
}

// §12.1 — THE research gate: one row per capability, added because it is CURRENT, not
// because it is famous. A row whose `staleAfter` has passed is HIDDEN from the UI
// automatically and shows "refresh required" in admin. This is the table that makes
// "not stale tools" a timestamp we can show rather than a claim.
//
// `audience` is an AUDIENCE/tier label (§12.9) — "staff" (internal/operator) | "pro" |
// "all" — NOT a role gate. `legalBasis` is the plain-language reason we may run it
// (every row carries one; email/DNS rows additionally carry an allow-list check).
model LabToolCatalog {
  id           String    @id @default(cuid())
  // The upstream capability this row describes, e.g. "nmap", "nuclei", "caldera".
  slug         String    @unique
  name         String
  // The lab class it serves: "email" | "dns" | "server" | "network".
  klass        String
  // "offensive" | "defensive" — the §5 matrix's Gate column reads off this.
  kind         String
  // ATT&CK technique id(s) this capability exercises (Json array of strings).
  techniqueIds Json?
  // The upstream version pinned at last review + when that version was released.
  upstreamVersion    String?
  upstreamReleasedAt DateTime?
  // ISO date of the last review — the acceptance evidence for the research gate.
  lastReviewedAt     DateTime?
  // §12.1 — a capability whose staleAfter has passed is hidden from the UI. NULL falls
  // back to `now + AdminSetting.cyberlabToolStaleAfterDays` when a row is minted.
  staleAfter         DateTime?
  // CVE history (Json array) + SPDX-ish licence id.
  cveHistory   Json?
  licence      String?
  // Which real-world campaigns/APT reports used it in the last 12–18 months.
  derivation   String?
  // §12.9 — an AUDIENCE label, not a role gate.
  audience     String    @default("staff")
  // Why we may run it (the §5 legal-basis note; not optional).
  legalBasis   String
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([klass, kind])
  @@index([enabled, staleAfter])
}

// ---------------------------------------------------------------------------
// TASK_157 Phase 4 — the USER'S OWN DOMAINS (the "Domains" wizard's target model).
//
// WHY THIS MODEL EXISTS (owner, 2026-10-03). The requirement is NOT "let users pick
// from the platform's zones". It is:
//
//   1. A user may add a domain THEY OWN (BYO Cloudflare, or bought from a
//      registrar the platform will later sync with).
//   2. A user may only ever select a domain they own. Platform zones — including
//      `instaweb.top` and `mainaccess.top` — are ADMIN-ONLY and must never appear
//      in a user's picker.
//   3. `mainaccess.top` is not to be used AT ALL (owner instruction).
//
// So the owning boundary is `ownerKind`, and it is enforced here in the schema as
// well as in the access layer: `ownerUserId` is set for a user's own domain and
// NULL for a platform one. A row is a USER's domain iff `ownerKind = "user"`, and
// every read path filters on that pair together (see lib/hosting/domain-registry.ts).
//
// WHY A TABLE AT ALL, when the user's own Cloudflare account can be listed live?
// Because the user may also buy a domain from an EXTERNAL REGISTRAR (planned). A
// registrant's zone is NOT in the user's Cloudflare account, so live discovery
// cannot see it — it has to be stored, then reconciled. `source` and
// `externalRef` are the seam for that sync, and they are deliberately nullable so
// the BYO path needs no merchant at all.
//
// `apex` is the registrable apex ("example.com") — the zone identity. `name` is the
// apex too, kept as the natural column name; UNIQUE is case-insensitive-safe because
// `apex` is always stored normalised lower-case by the registry before insert.
// ---------------------------------------------------------------------------
model UserDomain {
  id          String   @id @default(cuid())
  // The registrable apex, lower-cased: "example.com". UNIQUE across the whole
  // platform — two users can never claim the same apex, which is what stops one
  // user from taking a domain that belongs to another (or to the platform).
  apex        String   @unique
  // A user-facing label, defaulting to the apex.
  label       String   @default("")
  // --- THE OWNERSHIP BOUNDARY. "user" = that user owns it; "platform" = ours.
  ownerKind   String   @default("user")
  // Set ONLY when ownerKind = "user". NULL for a platform domain. Access checks
  // compare BOTH fields together: a domain is readable by user U iff
  // ownerKind = "user" AND ownerUserId = U. Never trust ownerKind alone.
  ownerUserId String?
  // How the domain entered the system:
  //   "byo"        — the user pointed us at their own Cloudflare account
  //   "registrar"  — bought through the external merchant (planned)
  //   "manual"     — added by an admin on the user's behalf
  source      String   @default("byo")
  // The merchant's own identifier for this purchase (order/registration id), so a
  // later sync can match rows without guessing. NULL for BYO/manual.
  externalRef String?
  // The Cloudflare zone id once we know it. NULL until Cloudflare reports one —
  // for a registrar domain that has not been pushed yet, and for "not yet added to
  // the user's Cloudflare account".
  zoneId      String?
  // "pending" (registered/added, not yet usable) | "active" | "error".
  // A pending domain is listed but NOT selectable — publishing onto it would fail.
  //
  // Cloudflare's own status is an OPEN enum (initializing/moved/deleted/...), so it
  // is NEVER stored raw: `normalizeZoneStatus` collapses it to pending/active on
  // every write, failing closed so an unfamiliar status cannot read as "ready". The
  // database CHECK refuses any value outside this set, which is why the collapse has
  // to happen first — an unnormalised "initializing" would fail the write and the
  // domain would then never update again.
  status      String   @default("pending")
  // The two Cloudflare-assigned nameservers, JSON array. Shown to the user so they
  // can set them at their registrar. NULL until Cloudflare assigns them.
  nameservers String?
  // The BYO credential this domain is reachable through, when source = "byo".
  // NULL for registrar domains (those use the platform's own account/merchant).
  credentialId String?
  // Plain-language status detail for the UI. Never contains a token.
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerKind, ownerUserId])
  @@index([ownerUserId, status])
}


// ---------------------------------------------------------------------------
// TASK_159 — SUPPORT TICKETS. Scope: PLAN_TASK_159_SUPPORT_TICKETS.md.
//
// Phase 1 = models + migration + user list/create/reply + admin queue/reply.
// Attachments, email notification, SLA timers, assignment, search are
// deliberately DEFERRED (plan §5) — none is needed to answer "my domain isn't
// showing up", which is the whole point of the feature.
//
// THE RULE THE WHOLE FEATURE IS BUILT AROUND (plan §2.1): a ticket never holds a
// credential. A domain is attached by ID REFERENCE, resolved server-side, never by
// copying the apex or a token into the body. Ticket bodies are user text that gets
// rendered in an admin UI and will eventually be emailed and searched; the moment a
// body may hold a raw token, the platform has built a paste-target for its own
// secrets.
// ---------------------------------------------------------------------------

model SupportTicket {
  id          String    @id @default(cuid())
  // Resolved from the SESSION on every write, never from a request body — reading
  // it from the body is how a crafted POST files a ticket against another user
  // (plan §2.2). Immutable: nothing in Phase 1 reassigns a ticket's owner.
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  // Deliberately a STRING, not a Postgres enum — same convention as
  // NotificationLog.outcome and UserDomain.status. The plan is explicit that
  // "waiting_on_customer" is inevitable, and an enum would make that state a
  // migration. For that reason there is intentionally NO CHECK constraint pinning
  // the set here: a CHECK would reintroduce exactly the migration the string was
  // chosen to avoid. Readers must treat ONLY the exact value "resolved" as closed;
  // anything else — including a value this code has never seen — still needs
  // attention, so a future "waiting_on_customer" can never silently drop out of the
  // admin queue.
  status      String    @default("open")
  subject     String
  // Free-text classification for the admin queue filter. NULL = unclassified,
  // which is distinct from "other" — a nil category means nobody has looked yet.
  category    String?
  priority    String?
  // THE DOMAIN LINK (plan §3.3). Points at UserDomain.id; the admin view JOINS to
  // read apex/status/owner. The apex is deliberately NOT copied here: a copied apex
  // goes stale the moment the domain is removed and then tells the admin something
  // false. Soft reference (no FK), matching UserDomain's own ownerUserId style; the
  // "must belong to this ticket's user" rule is enforced in the write path.
  domainRefId String?
  // Phase-1 placeholder for the wallet boundary (plan §6): a billing ticket should
  // reference a ledger entry by id, never copy an amount — a copied amount is a
  // second source of truth that will disagree with the ledger. Unused until the
  // wallet ships; present now so the seam is visible rather than retrofitted.
  walletRefId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  messages SupportMessage[]

  // The per-user listing ("my tickets, newest first") and the admin queue
  // ("open first, newest first") — the only two reads that exist in Phase 1.
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  // Cascade on purpose: a message has no meaning without its ticket, and this is
  // containment, not a retention policy. Deleting a ticket is an explicit act; it
  // must not leave orphaned bodies behind that no UI can ever show or erase.
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Exactly two writers exist in the whole design, and every reader branches on
  // this to decide how to render the bubble, so an unknown value has no correct
  // rendering. Closed set — pinned with a CHECK in the migration. (Contrast
  // SupportTicket.status above, which is deliberately EXTENSIBLE and therefore
  // deliberately un-CHECKed.)
  authorRole String
  // NULLABLE on purpose (plan §3.2): an admin replying from a personal account must
  // not become a hard dependency on that User row existing forever. There is no
  // relation, so no FK can break when an admin's account is removed.
  authorId   String?
  body       String
  createdAt  DateTime      @default(now())

  // The thread read: one ticket's messages in order.
  @@index([ticketId, createdAt])
}
