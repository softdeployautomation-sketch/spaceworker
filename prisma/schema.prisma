generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(cuid())
  email                    String                 @unique
  passwordHash             String
  emailVerified            Boolean                @default(false)
  // Tier 1 trial (Task: Tier 1 trial for all free users). Tier numbers:
  //   0 = legacy / nothing (inline EXE-buyer license_only accounts — see
  //       findOrCreateUser in app/api/billing/submit/route.ts, which MUST pin 0)
  //   1 = trial (15 min/day per tool, never prioritized over Premium)
  //   5 = Premium (the web subscription product — always grant exactly 5, see
  //       bumpWebTier in lib/license-service.ts)
  // 2/3/4 are deliberately reserved/unused headroom for future paid plans.
  // IMPORTANT: every "has Pro" branch must test `>= 5`, never `>= 1`, or a trial
  // user would silently get a paid feature and a paying customer would lose one.
  tier                     Int                    @default(1)
  // Task 55 — time-limited premium. In SpaceWorker, tier is per-User (unlike
  // Vantra's per-Organization). NULLABLE semantics differ from Vantra by design:
  //   - NULL on an EXISTING tier:5 user (created BEFORE this field existed) =
  //     GRANDFATHERED, never expires. The reversion check (premiumExpiresAt ===
  //     null) never touches them — never backfill a date here or you'd silently
  //     downgrade every existing paying customer.
  //   - NULL on a tier < 5 user = "not premium / free", meaningless.
  //   - non-NULL = a real premium term; every NEW grant / web-sub charge sets
  //     this. When it passes, the lazy check-on-read flips tier back to 1.
  premiumExpiresAt         DateTime?
  // Task 39 — per-channel notification prefs (lib/notify.ts fan-out). notifyEmail
  // / notifyAgent default ON so a user who never opens Settings keeps today's
  // behavior; notifyTelegram defaults OFF (it's a no-op until the user links
  // their chat anyway). telegramChatId is set only via the bot-linking webhook;
  // telegramLinkToken is a short-lived random token backing the Connect deep link,
  // cleared on a successful link.
  notifyEmail              Boolean                @default(true)
  notifyTelegram           Boolean                @default(false)
  notifyAgent              Boolean                @default(true)
  telegramChatId           String?
  telegramLinkToken        String?
  // Real evidence of ToS/AUP agreement at signup — null means a pre-existing
  // account created before this field existed, not that they never agreed.
  acceptedTermsAt          DateTime?
  // Task 40 — per-user daily AI cost cap, in hundredths of a cent. Default $2/day
  // (20000), a modest slice of the shared $50/day Channelry pool. Deliberately a
  // per-user, admin-adjustable value (not a global constant) so an admin can "add
  // more" to a power user live, per the ask. Enforced in runAgentTurn against a
  // SUM over today's AiUsageLog rows (append-only, race-safe — see AiUsageLog).
  aiDailyCapHundredthsCent Int                    @default(20000)
  // Task 92 — assistant foundation. digestEnabled gates the nightly assistant
  // digest (digest-sweep skips users who turn it off); deviceTelemetryEnabled
  // is the master WEB toggle for device telemetry ingest (heartbeat upsert
  // refuses when false — no tray in SpaceWorker, per plan decision M-scope).
  digestEnabled            Boolean                @default(true)
  deviceTelemetryEnabled   Boolean                @default(true)
  createdAt                DateTime               @default(now())
  verifications            VerificationCode[]
  rateLimits               RateLimitEvent[]
  mailboxes                Mailbox[]
  emailCampaigns           EmailCampaign[]
  payments                 Payment[]
  browserProfiles          BrowserProfile[]
  browserSessions          BrowserSession[]
  notificationLogs         NotificationLog[]
  searchJobs               SearchJob[]
  leads                    Lead[]
  campaignAutomations      CampaignAutomation[]
  seedMailboxes            SeedMailbox[]
  agentThreads             AgentThread[]
  agentPendingActions      AgentPendingAction[]
  aiUsageLogs              AiUsageLog[]
  toolUsageLogs            ToolUsageLog[]
  exeLicenses              ExeLicense[]
  exeLicenseTransfers      ExeLicenseTransfer[]
  // Task 92 — assistant foundation device layer + entitlements.
  devices                  Device[]
  deviceJobs               DeviceJob[]
  deviceActions            DeviceAction[]
  deviceRelationships      DeviceRelationship[]
  activityRollups          ActivityRollup[]
  userEntitlements         UserEntitlement[]
  agentActionAudits        AgentActionAudit[]
  vantraLink               VantraLink?
  // Task 95 — Devices v2 tool parity.
  deviceQueuedCommands     DeviceQueuedCommand[]
  devicePinRequests        DevicePinRequest[]
  // Task 97 — Browser Clone lifecycle records + relay registry + hosted sessions.
  cloneJobs                CloneJob[]
  relays                   RelayHealth[]
  hostedBrowserSessions    HostedBrowserSession[]
}

model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  // 2026-09-20 — Task 49 fix: a device-transfer confirmation code now reuses
  // this exact table/mechanism instead of inventing a new one, but issuing
  // one must never invalidate an unrelated pending signup-verification code
  // (or vice versa) for the same user — hence scoping by purpose. Every
  // pre-existing row is a real signup code, so the default keeps them
  // correctly classified with no backfill needed.
  purpose    String    @default("signup")
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  ip        String
  kind      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([ip, kind, createdAt])
}

model AdminSetting {
  id                      String   @id @default("singleton")
  updatedAt               DateTime @updatedAt
  btcWallet               String?
  usdtWallet              String? // USDT-TRC20 (Tron) — the original/default USDT chain
  // USDT-ERC20 (Ethereum) — a second USDT wallet so buyers on Ethereum-native
  // exchanges (which often don't support Tron withdrawals) can pay directly
  // instead of needing to bridge/swap first. Independent from usdtWallet —
  // both can be configured at once, admin picks which chains are live.
  usdtErc20Wallet         String?
  // Task 42 — one price per product sold on the store/landing page (all real
  // launch prices decided 2026-09-14, still admin-adjustable at runtime). The
  // old planPriceUsd field was renamed to webSubscriptionPriceUsd (same role,
  // new default 25 = the store's web-subscription price, superseding 9.99).
  webSubscriptionPriceUsd Float    @default(25) // /month
  extractorExePriceUsd    Float    @default(50) // one-time, 6-month term
  mailerExePriceUsd       Float    @default(50) // one-time, 6-month term
  combinedExePriceUsd     Float    @default(70) // one-time, 6-month term
  automationExePriceUsd   Float    @default(100) // one-time, 6-month term — top tier

  // Task 46 — admin admission control for the two mechanisms that actually spend
  // real RAM on this shared, resource-constrained VPS: search/extraction dispatch
  // (each running job is a real Playwright+Chromium process, one per lane today)
  // and interactive browser sessions (each is a full Neko streaming container).
  // Defaults exactly match today's hardcoded behavior — purely additive, zero
  // change until an admin actually touches a toggle or number.
  dispatchLightEnabled         Boolean @default(true)
  dispatchLightMaxConcurrent   Int     @default(1)
  dispatchHeavyEnabled         Boolean @default(true)
  dispatchHeavyMaxConcurrent   Int     @default(1)
  browserSessionsEnabled       Boolean @default(true)
  browserSessionsMaxConcurrent Int     @default(3)

  // Task 93 (CROSS-TRACK RULE 7) — per-feature admin limits for the Vantra
  // plugin: link provisioning rate + device-action concurrency. Live counts
  // are surfaced alongside in the admin panel (admission-control pattern).
  vantraLinksEnabled         Boolean @default(true)
  vantraLinksMax             Int     @default(100)
  deviceActionsEnabled       Boolean @default(true)
  deviceActionsMaxConcurrent Int     @default(3)

  // Task 97/107 (CROSS-TRACK RULE 7 + TASK_105 governor) — Browser Clone limits.
  // A cloned browser is a live Chromium process on the POOLED hosted PC, so it
  // is a first-class RAM consumer like the two mechanisms above. These key names
  // ARE the contract (TASK_107 deliverable 2); TASK_109/112 read them only
  // through lib/clone-settings.ts and never touch this table directly.
  //   cloneSessionsEnabled         = master on/off; a pause blocks NEW starts only
  //   cloneMaxConcurrent           = concurrent live clone sessions (engine-wide)
  //   clonePerUserCap              = of those, how many one user may hold at once
  //   hostedPoolSize               = hosted clone PCs provisioned to serve them
  //   cloneIdleTtlMinutes          = idle TTL before teardown (Q1: 60)
  //   cloneHardTtlMinutes          = absolute ceiling, even while in use (Q1: 480 = 8 h)
  //   clonePurgeAfterDays          = inactive-record purge window (owner 2026-10-01: 30)
  //   cloneDirectEgressPremiumOnly = direct egress is premium-only (owner 2026-10-01)
  //   cloneRelayRequired           = relay mode FAILS CLOSED when the relay is down
  // Both TTL numbers are stamped onto each CloneJob at creation, so changing a
  // value here never retroactively kills an already-running session. Everything
  // is admin-adjustable at runtime; nothing is hardwired.
  cloneSessionsEnabled         Boolean @default(true)
  cloneMaxConcurrent           Int     @default(2)
  clonePerUserCap              Int     @default(1)
  hostedPoolSize               Int     @default(1)
  cloneIdleTtlMinutes          Int     @default(60)
  cloneHardTtlMinutes          Int     @default(480)
  clonePurgeAfterDays          Int     @default(30)
  cloneDirectEgressPremiumOnly Boolean @default(true)
  cloneRelayRequired           Boolean @default(true)

  // Task 56 — admin-toggleable maintenance windows. Two SEPARATE flags, not one:
  // web pages and the EXE-API traffic share one backend today but will split onto
  // their own hostname under the domain-separation plan, so keep them independent
  // now rather than refactor later. maintenanceModeWeb is checked by app/proxy.ts
  // (which serves the maintenance page for everything but /admin/** and static
  // assets); maintenanceModeExeApi is checked for /api/exe* + /api/exe-license*
  // requests, which return 503 { maintenance: true } instead of proceeding — the
  // EXE's hosted-fetch wrapper watches for that shape.
  maintenanceModeWeb    Boolean @default(false)
  maintenanceModeExeApi Boolean @default(false)
}

model Mailbox {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  label             String
  host              String
  port              Int
  // SMTP AUTH username only, going forward. For a relay service like Resend this
  // is the literal "resend" (password = API key), independent of the From address.
  username          String
  // Task 30, item 4 — the addresses mail is actually sent AS. An empty array ([])
  // means "same as the SMTP username", which is every non-relay mailbox's
  // real-world behavior. Multiple entries rotate across recipients at queue-build
  // time (each item stores the resolved value on EmailQueueItem.resolvedFromAddress),
  // so one SMTP account can send as admin@/outreach@/hello@ etc. Replaces the old
  // single `fromAddress` column (additive migration, backfilled into a 1-item array).
  fromAddresses     String[]         @default([])
  encryptedPassword String
  passwordIv        String
  passwordTag       String
  secure            Boolean          @default(true)
  // Task 26, Piece 5a — explicit opt-in ONLY for the "None (port 25, unencrypted
  // relay)" security mode. Default false: the send path then ALWAYS enforces TLS
  // (requireTLS), even on port 587/25, so the old ambiguous "Use TLS checkbox" can
  // never silently pick the wrong handshake again. `secure` itself is derived from
  // port (port 465 => implicit TLS) at write time, not from this flag.
  allowInsecure     Boolean          @default(false)
  dailyLimit        Int              @default(40)
  sentToday         Int              @default(0)
  sentTodayDate     String?
  active            Boolean          @default(true)
  lastTestedAt      DateTime?
  lastTestOk        Boolean?
  createdAt         DateTime         @default(now())
  queueItems        EmailQueueItem[]

  @@index([userId])
}

model EmailCampaign {
  id                    String                @id @default(cuid())
  userId                String
  user                  User                  @relation(fields: [userId], references: [id])
  name                  String
  // Legacy single-value fields — kept for back-compat only; new campaigns write
  // their content as 1+ CampaignVariant rows and leave these empty.
  subject               String                @default("")
  bodyHtml              String                @default("")
  // Task 29, item 4 — independent subject and body lists for cross-combined
  // rotation. Empty ([]) for legacy pair-based campaigns, which keep using
  // CampaignVariant rows (see EmailQueueItem.variantId below). When populated,
  // recipient *i* resolves to subjects[i % len] + bodies[i % len] independently —
  // a single-item list is held constant (i % 1 === 0) while the other dimension
  // still rotates. Additive, so every pre-Task-29 campaign path is untouched.
  subjects              String[]              @default([])
  bodies                String[]              @default([])
  searchJobId           String?
  // "draft" | "pending_test_confirm" | "sending" | "done" | ...
  // New campaigns start at "pending_test_confirm": a real send is gated behind the
  // test-send-confirm step (the drain route only processes status "sending").
  status                String                @default("pending_test_confirm")
  // Tier 1 trial — when the CURRENT active-sending stretch began (null when not
  // actively sending). Set on every transition INTO "sending"; cleared (and the
  // stretch's elapsed seconds logged to ToolUsageLog) on every transition OUT of
  // "sending" (done / paused_deliverability / stopped). Kept null until the
  // first real send — a campaign sitting at "pending_test_confirm" accrues
  // nothing. One per running stretch, never a running total: today's mailer
  // usage is a SUM over ToolUsageLog rows (AiUsageLog precedent), so per-day
  // correctness survives pauses/resumes across UTC midnights.
  sendingStartedAt      DateTime?
  // Which of the user's mailboxes this campaign's sends rotate across (true
  // in-run sender rotation, replacing the old single `mailboxId` at creation).
  mailboxIds            String[]              @default([])
  // Task 26, Piece 5b — how many recipients share a mailbox/subject before the
  // rotation advances to the next. Default 1 = old per-recipient rotation
  // (non-breaking). Clamped server-side to [1, 1000]. Stored so the from-leads
  // add-to-existing route can keep rotating on the same cadence.
  rotateEvery           Int                   @default(1)
  // Task 29, item 6 — the batch gate: the mail-queue drain dispatches up to this
  // many recipients per campaign per tick, then re-checks deliverability on the
  // campaign's test mailbox and pauses if the probe didn't land in the inbox.
  batchSize             Int                   @default(50)
  // Human-assisted deliverability fallback: when set, EVERY deliverability
  // probe for this campaign (the initial test-send-confirm gate AND every
  // later batch-gate check) targets this plain address instead of a
  // registered SeedMailbox. There's no IMAP access to an arbitrary recipient,
  // so placement is never auto-verified here — the initial check passes on a
  // successful SMTP send (the human then eyeballs their own inbox before
  // clicking Confirm), and every batch probe always reports landedIn:"unknown",
  // which is exactly what keeps the batch gate pausing for a human decision on
  // every batch rather than auto-continuing. Set either up front (the
  // campaign-create "use this recipient as my test target" option) or
  // reactively after the platform seed mailbox's automated check fails.
  testRecipientOverride String?
  // Task 35 — configurable send pacing. The drain's per-send jitter is
  // `min + random * (max - min)` seconds; defaults (5/45) match the pre-Task-35
  // hardcoded `Math.random() * 40_000 + 5_000` exactly (zero behavior change for
  // existing campaigns). Bounds are clamped server-side so a user can never
  // configure a 0-0 "bot blast" — see POST /api/campaigns and the drain route.
  minSendDelaySeconds   Int                   @default(5)
  maxSendDelaySeconds   Int                   @default(45)
  // Task 33 — a temporary, human-approved "pinned override" window: a specific
  // proven-good subject/body/from combination locked onto the campaign for a
  // fixed number of upcoming sends (requested pinCount). While set, the
  // mail-queue drain sends every recipient this exact content instead of
  // consulting subjects[i % len]/bodies[i % len]/fromAddresses[i % len], and
  // decrements `remaining` per successful send. When `remaining` reaches 0 the
  // drain clears it and (on a clean finish — no spam hit through the window)
  // front-inserts the pinned content into the normal rotation (Task 32's
  // mechanic) so it keeps serving the campaign after the window too. A spam hit
  // during the window clears the pin and falls back to paused_deliverability.
  // Shape: { subject, bodyHtml, fromAddress, remaining }. null = not pinned.
  // Achieved as a JSON column — no separate table.
  pinnedOverride        Json?
  createdAt             DateTime              @default(now())
  variants              CampaignVariant[]
  checks                DeliverabilityCheck[]
  items                 EmailQueueItem[]
  linkRedirects         LinkRedirect[]

  @@index([userId])
}

model CampaignVariant {
  id         String           @id @default(cuid())
  campaignId String
  campaign   EmailCampaign    @relation(fields: [campaignId], references: [id])
  subject    String
  bodyHtml   String
  createdAt  DateTime         @default(now())
  items      EmailQueueItem[]

  @@index([campaignId])
}

model EmailQueueItem {
  id                  String           @id @default(cuid())
  campaignId          String
  campaign            EmailCampaign    @relation(fields: [campaignId], references: [id])
  // Assigned at queue-creation time via round-robin across the campaign's
  // mailboxIds (true in-run rotation lives here, not in the drain route).
  mailboxId           String
  mailbox             Mailbox          @relation(fields: [mailboxId], references: [id])
  // Which variant (subject/body) this recipient actually resolved to.
  variantId           String?
  variant             CampaignVariant? @relation(fields: [variantId], references: [id])
  toEmail             String
  // Task 29, item 3 — how this recipient got onto the queue. "" (default) =
  // extracted/uploaded/picked lead; "manual_insert" = a test recipient a user
  // dropped into the queue at a chosen position. Lets the run-detail UI label it
  // distinctly from extracted/uploaded/picked leads.
  source              String           @default("")
  // Task 29, item 4 — resolved subject/body snapshots for decoupled campaigns
  // (EmailCampaign.subjects/bodies set). Populated on those; null on legacy
  // pair-based campaigns, which fall back to variant.subject / variant.bodyHtml.
  resolvedSubject     String?
  resolvedBodyHtml    String?
  // Task 30, item 4 — the From address this specific recipient's send resolved
  // to at queue-build time (mailbox.fromAddresses[i % len] rotation). null = the
  // mailbox has no from addresses configured (drain falls back to SMTP username).
  resolvedFromAddress String?
  // Per-recipient merge variables from the uploaded CSV (extra columns).
  // { "firstName": "Ada", "company": "ACME", ... }
  variables           Json?
  status              String           @default("queued")
  sentAt              DateTime?
  error               String?
  createdAt           DateTime         @default(now())

  @@index([campaignId, status])
  @@index([mailboxId, status])
  @@index([variantId])
}

model SeedMailbox {
  id                String                @id @default(cuid())
  // Task 29, item 5 — ownership. null = the platform-shared seed (today's
  // default, bootstrapped by lib/seed-mailbox.ts from env); set = a user's own
  // registered test account (created via POST /api/test-mailboxes). A user with
  // no own row keeps using the platform default, exactly as before — additive.
  userId            String?
  user              User?                 @relation(fields: [userId], references: [id])
  // Platform-owned deliverability seed account (typically only one row for v1).
  label             String
  host              String
  port              Int
  username          String                @unique
  encryptedPassword String
  passwordIv        String
  passwordTag       String
  secure            Boolean               @default(true)
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now())
  checks            DeliverabilityCheck[]

  @@index([userId])
}

model DeliverabilityCheck {
  id                String        @id @default(cuid())
  campaignId        String
  campaign          EmailCampaign @relation(fields: [campaignId], references: [id])
  // Nullable: a check against a registered SeedMailbox (platform default or a
  // user's own IMAP account) sets this; a check that instead targeted a plain
  // ad-hoc recipient (no IMAP credentials to poll — see overrideRecipient) has
  // no SeedMailbox row at all.
  seedMailboxId     String?
  seedMailbox       SeedMailbox?  @relation(fields: [seedMailboxId], references: [id])
  // The human-assisted fallback: when a campaign has no pollable seed mailbox
  // (the platform default failed, or the user opted to test against their own
  // address instead), the test message goes straight to this address and
  // "delivered" means "the SMTP send succeeded" — there's no IMAP account to
  // poll, so placement is never auto-verified; the human checks their own
  // inbox and clicks Confirm. Exactly one of seedMailboxId/overrideRecipient
  // is set per check.
  overrideRecipient String?
  // "pending" | "delivered" | "failed"
  status            String        @default("pending")
  // Task 29, item 6 — where the test message actually landed, from a spam-aware
  // IMAP poll. null on legacy checks / before the check runs; "inbox" | "spam" |
  // "unknown" afterward. "unknown" is what the batch gate needs to force a human
  // eyeball instead of auto-continuing. Always "unknown" for an overrideRecipient
  // check (no IMAP access), which is exactly what keeps the batch gate pausing
  // on every batch rather than auto-continuing.
  landedIn          String?
  messageId         String?
  error             String?
  createdAt         DateTime      @default(now())
  checkedAt         DateTime?

  @@index([campaignId, createdAt])
}

model Payment {
  id           String                       @id @default(cuid())
  userId       String
  user         User                         @relation(fields: [userId], references: [id])
  kind         String // "btc" | "usdt_trc20" — the PAYMENT METHOD, not the product
  amountUsd    Float
  // Task 44 — nullable: a buyer who doesn't know how to find their tx hash can
  // submit without one, staying "pending" for manual admin review only (never
  // auto-verified, never auto-rejected by the 24h poller timeout — see
  // app/api/internal/payment-verify/route.ts's explicit txHash-not-null filter
  // and app/api/billing/submit/route.ts's early return before any on-chain
  // check). Postgres allows multiple NULLs under @unique, so this never
  // collides between different no-hash submissions.
  txHash       String?                      @unique
  toAddress    String
  // Task 42 — which product this payment bought. Distinct from `kind` (the
  // payment METHOD). Defaulted so every pre-existing row is correctly the only
  // product that has ever existed. "web_subscription" | "extractor_exe" |
  // "mailer_exe" | "combined_exe" | "automation_exe".
  product      String                       @default("web_subscription")
  // 2026-09-20 — owner: "if anyone wants to buy more on there license they
  // can buy for 1 year, and also for 1 month, just let the calculator do
  // its thing". EXE-only; null means "the product's standard term"
  // (EXE_LICENSE_DAYS, 180 = 6 months) — every pre-existing row and every
  // web_subscription payment stays null, unaffected. Set at checkout time,
  // read back by issueExeLicense (lib/license-service.ts) to mint the
  // license for the ACTUAL term paid for instead of always 180 days.
  durationDays Int?
  status       String                       @default("pending") // "pending" | "approved" | "flagged" | "rejected"
  autoApproved Boolean                      @default(false)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  attempts     PaymentVerificationAttempt[]
  exeLicense   ExeLicense?

  @@index([userId])
  @@index([status])
}

// Task 42 — an issued desktop-app (EXE) license. Created exactly once per
// approved EXE payment via lib/license-service.ts. `issuedAt + 180 days` is the
// real term (a 6-month, non-perpetual license, decided 2026-09-14 superseding
// Part A's original perpetual note). `licenseKey` uses the proven Lead Extractor
// Pro format (lib/exe-license.ts) — the key's own `expires_at` payload field
// carries the authoritative expiry, which the dashboard/email surface.
model ExeLicense {
  id                          String    @id @default(cuid())
  userId                      String
  user                        User      @relation(fields: [userId], references: [id])
  paymentId                   String    @unique
  payment                     Payment   @relation(fields: [paymentId], references: [id])
  product                     String // matches Payment.product
  licenseKey                  String    @unique
  issuedAt                    DateTime  @default(now())
  // Task 45 — a short-lived, single-use claim token backing the "view my
  // license" link emailed to the buyer. Only the SHA-256 hash of the random half
  // is stored (never the raw token), `ExpiresAt` is set at issuance, and
  // `ConsumedAt` flips on a successful claim to make it single-use. All three are
  // null for licenses issued before this feature existed (no emailed claim link
  // for them — a pre-existing buyer still reaches /dashboard/licenses by logging
  // in as a real customer).
  licenseClaimTokenHash       String?   @unique
  licenseClaimTokenExpiresAt  DateTime?
  licenseClaimTokenConsumedAt DateTime?

  // Task 47 — one-time machine binding via a "claim" step. Issuance produces an
  // UNBOUND key (a purchase reference the EXE must never accept); a claim re-signs
  // that key with the buyer's device machine_id and records the binding here. All
  // four are set exactly once, on the first successful claim:
  //   boundMachineId    — the hardware id the key is now locked to (same format
  //                       getMachineId() produces, lowercased).
  //   boundMachineLabel — optional buyer/admin-chosen cosmetic label ("Office PC").
  //   boundLicenseKey   — the RE-SIGNED, machine-bound activation key the buyer
  //                       actually enters into the EXE (decodes with machine_id).
  //   boundAt           — when the claim happened (boundAt + original expiry is
  //                       the real term — a claim never resets the 180 days).
  // All nullable so every pre-existing (pre-feature) row correctly reads as
  // "unclaimed" — no machine info was ever bound for them either.
  boundMachineId    String?
  boundMachineLabel String?
  boundLicenseKey   String?
  boundAt           DateTime?

  // Task 47 addition — an admin device-transfer moves an already-bound license
  // from one machine to another (a deliberate support action, the only place a
  // binding is intentionally overwritten). Each successful transfer appends an
  // ExeLicenseTransfer audit row (see below) so "who moved what, when" survives
  // for support disputes.
  transfers ExeLicenseTransfer[]

  @@index([userId])
}

// Task 47 addition — append-only audit log of every admin device transfer for an
// EXE license. Written ATOMICALLY with the rebind (same $transaction as the
// ExeLicense.boundMachineId overwrite) so a transfer can never be recorded
// without its rebind or vice-versa. This is the durable record of the admin
// support action that deliberately moves a license to a replacement machine;
// the one-device guarantee in lib/exe-license-bind.ts is preserved because only
// a transfer (never the claim/bind path) may overwrite an existing binding.
//
// fromMachineId/toMachineId mirror the same lowercased machine_id format as
// ExeLicense.boundMachineId (getMachineId() output). fromMachineLabel is a
// snapshot of the binding being replaced, so the record is meaningful even if
// the ExeLicense row is later edited again.
model ExeLicenseTransfer {
  id               String     @id @default(cuid())
  exeLicenseId     String
  exeLicense       ExeLicense @relation(fields: [exeLicenseId], references: [id])
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  // The machine the license was bound to BEFORE this transfer. NULL only if the
  // row was somehow unbound (won't happen — a transfer requires an existing
  // binding — but kept nullable so the log can never fail to describe a move).
  fromMachineId    String?
  toMachineId      String
  fromMachineLabel String?
  toMachineLabel   String?
  // Optional support note — "replaced laptop after recall" etc. Free-form, kept
  // short; the admin UI caps it.
  note             String?
  transferredAt    DateTime   @default(now())

  @@index([exeLicenseId, transferredAt])
  @@index([userId])
}

// 2026-09-20 — owner: "a subtab showing every free users device active for
// that 24hrs, and can leave after they get binded." Server-side visibility
// into the EXE's silent 24h trial (lib/license-state.ts), which is otherwise
// ENTIRELY local to each machine — the admin has no way to see it today.
// Pinged (upsert) by the EXE-local /api/exe-license/status route whenever a
// device is in trial, fire-and-forget, same as every other admin-alert
// integration this session — a ping failure must never affect the trial
// gate itself. No user/email FK: a trial is anonymous by design, identified
// only by machineId (+ product, since one machine could run more than one
// EXE variant). The admin subtab computes "still active" as
// now - startedAt < 24h (the exact same rule lib/license-state.ts's
// trialActive() uses) and excludes any row whose machineId+product now has a
// bound ExeLicense — "leaves" the trial list once claimed, since it's no
// longer a free/trial device at that point.
model ExeTrialSession {
  id           String   @id @default(cuid())
  machineId    String
  product      String
  // Task 58 — the email the user entered at trial-start (required before a NEW
  // trial can begin; no more anonymous first launch). Nullable only for legacy
  // rows created before this field existed — the first email-carrying request
  // from the same device back-fills it.
  email        String?
  machineLabel String?
  startedAt    DateTime
  lastSeenAt   DateTime @default(now())

  @@unique([machineId, product])
  @@index([startedAt])
}

model PaymentVerificationAttempt {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  success   Boolean
  note      String?
  checkedAt DateTime @default(now())
}

model BrowserProfile {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  name             String
  dirPath          String // absolute path — never exposed to client
  status           String           @default("idle") // "idle" | "in_use"
  // Per-profile BYO proxy settings (Task 7). host/scheme/username are plaintext;
  // the combined "scheme://user:pass@host:port" connection string is stored
  // AES-256-GCM encrypted in byoProxyAuth (same pattern as Mailbox's SMTP
  // password). Only used when a session is started with proxyMode = "byo".
  byoProxyHost     String?
  byoProxyPort     Int?
  byoProxyScheme   String? // "http" | "https" | "socks5" | "socks5h"
  byoProxyUsername String?
  byoProxyAuth     String? // encrypted device connection string — never exposed to client
  lastUsedAt       DateTime?
  createdAt        DateTime         @default(now())
  sessions         BrowserSession[]

  @@unique([userId, name])
  @@index([userId])
}

model BrowserSession {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  profileId        String
  profile          BrowserProfile @relation(fields: [profileId], references: [id])
  // "starting" | "running" | "stopped" | "failed"
  status           String         @default("starting")
  proxyMode        String         @default("free") // "free" | "byo"
  exitNodeId       String? // which free exit node, when proxyMode = "free"
  // Real public IP this session actually egressed through, observed live via
  // a "what's my IP" check at session-start time — NOT re-derived from
  // exitNodeId + the current exit-nodes.ts config, since that mapping can
  // (and has) changed over time. This is the field an abuse/legal inquiry
  // about a specific real-world IP actually needs; exitNodeId alone can't
  // answer "what IP was this session really seen as" after a later config
  // change. Null if the live check failed — never blocks session launch.
  exitIpSnapshot   String?
  // Snapshot of the proxy actually routing this session — written at start time
  // so an edit to a profile's BYO settings never silently changes a live route.
  byoProxyHost     String?
  byoProxyPort     Int?
  byoProxyScheme   String?
  byoProxyUsername String?
  byoProxyAuth     String? // encrypted connection string, same scheme as BrowserProfile
  // Tunnel/container id the browser subsystem reports back for this session.
  containerId      String?
  // Neko's per-session auto-generated login password (browser-server/server.ts) —
  // embedded into connectUrl's ?pwd= query param so Neko's own login screen never
  // shows; never returned as a bare field (see browser-session-serialize.ts).
  nekoPassword     String?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime       @default(now())
  // Soft-delete: a customer "deleting" an ended session from their own
  // history hides it from their list only — the row (and its proxyMode/
  // exitNodeId/containerId/timestamps) stays intact for the admin audit
  // endpoint, which has no other record of past sessions.
  hiddenAt         DateTime?

  @@index([userId, status])
  @@index([profileId])
}

model NotificationLog {
  id           String   @id @default(cuid())
  userId       String? // null for admin-only notifications (no specific user)
  user         User?    @relation(fields: [userId], references: [id])
  eventType    String // e.g. "verification_code", "payment_pending", "payment_confirmed"
  channel      String // "email" | "telegram" — SpaceWorker is email-only for now, kept generic
  recipient    String // the email address or chat id actually targeted, for audit purposes
  outcome      String   @default("sent") // "sent" | "failed"
  errorMessage String? // populated when outcome is "failed"
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model SearchJob {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  query             String
  // Which template this search was created from: "lead" | "hr" | "plain" (extensible).
  template          String         @default("lead")
  params            Json
  status            String         @default("queued") // "queued" | "running" | "done" | "failed" | "paused" | "stopped"
  lane              String
  workerJobId       String?
  error             String?
  // Task 13 resumable jobs: non-null only while paused, holding enough to resume
  // from the next unprocessed query instead of restarting (processedQueries,
  // nextQueryIndex, seenUrls, foundLeads). Cleared when a paused job is resumed.
  resumeState       Json?
  // Set only when a job transitions to "paused" — the cooldown clock the
  // dispatcher's auto-resume check (outage pauses only, see resumeState's
  // pauseReason) uses to decide "enough time has passed, try again."
  pausedAt          DateTime?
  // How many times the dispatcher's Phase C has auto-resumed this job for an
  // "outage" pause. Capped (see app/api/internal/dispatch/route.ts) so a
  // durable, non-transient block (confirmed real for Google on this VPS —
  // see worker/automation.py's CAPTCHA notes) can't thrash forever, repeatedly
  // consuming its lane's only concurrency slot — after the cap it stays
  // "paused" for a human to look at instead of auto-retrying indefinitely.
  outageResumeCount Int            @default(0)
  // Task 14 live activity feed: the worker's current crawler step ("Searching: …",
  // "Visiting page N of Google results", "Reading a PDF at …"), written by the
  // dispatcher's per-tick poll while the job runs. Nullable and additive — left as
  // whatever the last "running" tick wrote after the job stops (done/paused/failed
  // branches do NOT clear it), so "where did it get to" survives the job.
  currentStep       String?
  // Task 15 stall detection: when currentStep's VALUE last actually changed
  // (not just when the dispatcher last polled — a poll that returns the same
  // step text again is exactly the "no real progress" case this needs to
  // catch, so re-stamping on every tick regardless of content would hide the
  // one thing this field exists to detect).
  currentStepAt     DateTime?
  // Tier 1 trial — wall-clock start of the job's most recent "running" stint.
  // Set when the dispatcher flips the job to running (Phase A admission); used to
  // meter ACTUAL elapsed runtime (dispatch start → terminal state) per tool per
  // UTC day, not each internal queued chunk. Cleared once the run is recorded in
  // ToolUsageLog so a later resume starts a fresh window. Null until first dispatch.
  trialStartedAt    DateTime?
  createdAt         DateTime       @default(now())
  queueEntry        JobQueueEntry?
  leads             Lead[]

  @@index([userId, createdAt])
}

model JobQueueEntry {
  id           String    @id @default(cuid())
  searchJobId  String    @unique
  searchJob    SearchJob @relation(fields: [searchJobId], references: [id])
  priorityTier Int
  lane         String
  status       String    @default("queued")
  createdAt    DateTime  @default(now())

  @@index([lane, status, priorityTier, createdAt])
}

model Lead {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  searchJobId      String
  searchJob        SearchJob @relation(fields: [searchJobId], references: [id])
  email            String?
  phone            String?
  contactName      String?
  businessName     String?
  website          String?
  sourceUrl        String?
  snippet          String?
  createdAt        DateTime  @default(now())
  // Task 26, Piece 3 — email deliverability validation. "unchecked" (the default)
  // means never validated; "valid" means both a syntactically-correct address and
  // an MX-record-bearing domain (see lib/email-validator.ts); "invalid" carries a
  // validationError explaining why. Additive and nullable-safe for existing rows.
  validationStatus String    @default("unchecked") // "unchecked" | "valid" | "invalid"
  validationError  String?
  validatedAt      DateTime?

  // Was @@unique([searchJobId, sourceUrl]) -- a REAL, confirmed root-cause bug
  // (Task 25): that constraint means at most ONE lead can ever be saved per
  // page/PDF per job, no matter how many distinct emails extraction actually
  // finds there. Confirmed live: a real membership-directory PDF containing
  // 105 unique emails reliably extracts all 105 (verified directly against
  // the worker's own extract_lead_pdf), yet the SAME job's persisted leads
  // showed exactly 1 row for that URL -- app/api/internal/dispatch/route.ts's
  // `prisma.lead.createMany({ ..., skipDuplicates: true })` silently dropped
  // the other 104 as "duplicates" purely because they shared a sourceUrl,
  // regardless of having entirely different emails. This is almost certainly
  // the dominant reason every real job all session undercounted so
  // severely relative to what search/extraction/concurrency fixes proved
  // was actually being found -- none of those fixes could matter once the
  // database was discarding the results before they ever reached the UI.
  // The corrected constraint keeps the original's real purpose (never save
  // the exact same email twice from the same page, e.g. across a paused/
  // resumed job re-visiting a URL) while allowing the many distinct emails a
  // single rich document legitimately contains.
  @@unique([searchJobId, sourceUrl, email])
  @@index([userId, searchJobId])
}

// Task 27, Part B — manual automation builder. A saved, re-runnable, gated
// configuration a user can trigger manually or schedule daily.
model CampaignAutomation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  name   String

  // Lead source — extraction (this automation's own saved find/location/params,
  // the exact same param keys POST /api/jobs already reads) OR a personal
  // uploaded list (personalListId = an upload SearchJob's id, template:"upload").
  leadSource      String   @default("extract") // "extract" | "personal_list"
  findTerms       String[] @default([])
  locationTerms   String[] @default([])
  params          Json? // engine, maxResults, minResults, pagesPerQuery, resultMode, emailDomains
  // Task 29, item 2 — personal_list source can now select MULTIPLE uploaded
  // lists (replaces the old single personalListId). A run pulls validated leads
  // from every selected SearchJob id, deduping by email across all of them.
  personalListIds String[] @default([])

  // Campaign + mailbox — HARD GATE per Task 09: both required to even CREATE
  // this row. campaignTemplateId references one of the user's OWN EmailCampaign
  // rows (tier (a) template); each run clones it into a fresh EmailCampaign.
  campaignTemplateId String
  mailboxIds         String[] @default([])

  // Trigger
  triggerMode     String  @default("manual") // "manual" | "daily"
  scheduleHour    Int? // 0-23, UTC — only meaningful when daily
  scheduleEnabled Boolean @default(true) // pause/resume a daily automation

  createdAt DateTime                @default(now())
  lastRunAt DateTime?
  runCount  Int                     @default(0)
  runs      CampaignAutomationRun[]

  @@index([userId])
  @@index([triggerMode, scheduleEnabled])
}

// One row per execution of a CampaignAutomation. Extraction runs async through
// the normal SearchJob pipeline; an internal sweep advances a run from
// extraction to the send phase once its SearchJob reaches a terminal state.
model CampaignAutomationRun {
  id           String             @id @default(cuid())
  automationId String
  automation   CampaignAutomation @relation(fields: [automationId], references: [id])

  startedAt             DateTime  @default(now())
  extractionCompletedAt DateTime?
  completedAt           DateTime?
  // "running" | "needs_confirmation" | "done" | "failed" | "stopped"
  status                String    @default("running")

  leadSource          String // snapshot of the automation's leadSource at run time
  searchJobId         String? // the SearchJob this run used
  leadsExtracted      Int? // number of VALIDATED leads eligible for sending
  campaignId          String? // the EmailCampaign this run created/queued
  emailsSent          Int? // recipients queued into the campaign at the send phase
  emailsSentByMailbox Json? // { [mailboxId]: count } — rotation visibility
  errorMessage        String?

  @@index([automationId, startedAt])
}

// Task 30, item 3 — optional link-redirect cloaking. The task explicitly scopes
// this to "doesn't visually announce itself as a tracking/redirect link", not
// cryptographic security: the token is a public opaque lookup key (the route is
// world-readable), so it carries no secret. Out of scope: per-click timestamps,
// per-recipient attribution, domain rotation, automatic (non-optional) wrapping.
model LinkRedirect {
  id         String         @id @default(cuid())
  // Opaque, url-safe lookup key for GET /r/<token>. __no secret__ — the counter
  // is a plain aggregate, and an unknown/expired token must 404 cleanly.
  token      String         @unique
  campaignId String?
  campaign   EmailCampaign? @relation(fields: [campaignId], references: [id])
  // The real destination this cloaked link redirects to.
  target     String
  // Optional friendly label (e.g. the link's anchor text) for the create-modal
  // preview; informational only.
  label      String?
  // Plain per-link click counter (aggregate only, no timestamps/attribution).
  clickCount Int            @default(0)
  createdAt  DateTime       @default(now())

  @@index([campaignId])
}

// Task 31, item 3 — the Automations "Ask the agent" feature. Threads, messages,
// and TTL-gated pending actions that implement the approval-gated tool calling
// (Channelry's "Agent Decider System" precedent, reimplemented here in the
// SpaceWorker schema — no shared library across the two repos). The agent never
// creates a real SearchJob or EmailCampaign; it only proposes one as an
// AgentPendingAction row. A human approval (PATCH .../approve) executes it for
// real through the exact same creation helpers POST /api/jobs and POST
// /api/campaigns use.

model AgentThread {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]

  @@index([userId])
}

model AgentMessage {
  id           String      @id @default(cuid())
  threadId     String
  thread       AgentThread @relation(fields: [threadId], references: [id])
  // "user" | "assistant" — every row is a literal turn in the chat panel.
  role         String
  content      String
  // Snapshot of the pending job/campaign the assistant proposed (the tool_call
  // channelryAiChat returned), so the plan card can be re-rendered without
  // re-deriving it from free text on every reload.
  toolCall     Json?
  // Task 37 — snapshot of an inline structured pick (lead-source dropdown,
  // upload dropzone, or mailbox picker) the assistant offered, so a reload
  // still renders the widget instead of losing it. Mutually exclusive with
  // toolCall (a turn either proposes or asks a structured question).
  inlineWidget Json?
  createdAt    DateTime    @default(now())

  @@index([threadId, createdAt])
}

model AgentPendingAction {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  // "job" | "campaign"
  kind               String
  // "pending" | "approved" | "rejected" | "expired" | "executed". A proposal is
  // only ever turned into a REAL job/campaign exactly once, on explicit human
  // approval, via the "approved" -> "executed" transition.
  status             String   @default("pending")
  payload            Json
  // The assistant's prose that described this plan (shown as the plan card's
  // supporting text).
  proposal           String?
  // One-hour TTL: an unapproved plan silently expires rather than lingering.
  expiresAt          DateTime
  executedJobId      String?
  executedCampaignId String?
  createdAt          DateTime @default(now())

  @@index([userId, status])
}

// Task 40 — per-user daily AI cost attribution. An append-only audit log of the
// REAL cost Channelry reported for each completed AI call (never an estimate),
// mirroring this codebase's preference for auditable rows over mutable counters
// (DeliverabilityCheck, NotificationLog). "Today" is a SUM over rows with
// createdAt >= startOfTodayUTC — correct even under concurrent requests, where a
// mutable counter would need a transaction to avoid a race. Enforced + written
// in lib/agent.ts's runAgentTurn (the one user-facing channelryAiChat call site).
//
// Units are hundredths of a cent everywhere to match Channelry's own usage block
// (cost_hundredths_cent) and User.aiDailyCapHundredthsCent — never divide by 100.
// The admin test-connection button is deliberately NOT logged here (it's an
// admin diagnostic, not a real user's usage).
model AiUsageLog {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  // The REAL cost_hundredths_cent Channelry returned for this call. Always the
  // reported value verbatim (rounded to an int for storage); 0-cost rows are
  // skipped so the log only ever holds meaningful, real spend.
  costHundredthsCent Int
  // e.g. "agent_turn". A future caller's event name, kept free-form (no enum)
  // so new callers don't require a migration to start logging.
  eventType          String
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

// Tier 1 trial — append-only per-user, per-tool usage audit log, mirroring the
// proven AiUsageLog pattern (Task 40): "today" is a SUM over rows with
// createdAt/usedOn >= startOfTodayUTC, race-safe under concurrency unlike a
// mutable counter. One row is written per completed tool run (a SearchJob
// extraction or an EmailCampaign send batch macro-window), carrying the ACTUAL
// elapsed wall-clock seconds of that run — never a reserved/declared duration.
//
// Which "tool" a row belongs to is the tool family (BUILD_TARGET contract, and
// what the EXE products/Payment rows name): extractor / mailer / combined /
// automation. The four web-app product surfaces map directly: lead extraction =
// extractor, outreach campaigns = mailer, an extraction feeding a campaign in
// one flow = combined, an automation-scheduled run = automation. A given lane/
// pipeline always maps to exactly one tool so a user can never spend the trial
// twice on the same feature under a different name.
//
// Tier 1 users are hard-capped at 900s per tool per UTC day at admission; tier 5
// (Premium) is exempt and never logs here. Enforced in
// app/api/internal/dispatch/route.ts Phase A (before a job/campaign is claimed).
model ToolUsageLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  // Tool family this run belonged to: "extractor" | "mailer" | "combined" |
  // "automation" (see toolForLane mapping in lib/trial.ts). Free-form string on
  // storage, bounded at the write site so new tools don't need a migration.
  tool           String
  lane           String
  // The ACTUAL wall-clock seconds of this run (dispatch start → terminal state).
  elapsedSeconds Int
  // UTC day this usage counted toward — YYYY-MM-DD, matching startOfTodayUTC().
  // Written at run completion so a run spanning UTC midnight lands wholly on the
  // day it STARTED, giving a predictable, easy-to-explain boundary.
  usedOn         String
  // The SearchJob / EmailCampaign this run measured (for auditing).
  jobId          String?
  createdAt      DateTime @default(now())

  @@index([userId, tool, usedOn])
  @@index([userId, createdAt])
}

// ============================================================================
// Task 92 — Assistant foundation (device layer + entitlements core).
// Plan: PLAN_NOW_ASSISTANT_AND_CYBER_LAB.md §SCHEMA + §CROSS-TRACK RULES.
// The Device* family is the SHARED device layer every device-side feature
// (Vantra plugin, Browser Clone, Cyber Lab) must consume — nobody invents
// their own identity, approval, audit, or panic primitives (Michael directive).
// Audit rows deliberately survive the deletion of the thing they audited:
// pendingActionId/cloneId are PLAIN SCALARS (no FK, no cascade) on purpose.
// ============================================================================

model Device {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  name            String
  // "workstation" | "hosted" — hosted = a SpaceWorker-run PC (Browser Clone
  // destination, arriving in Task 97); everything else is the user's own.
  deviceKind      String    @default("workstation")
  // Device identity = the user's Vantra agent (plan: VantraLink arrives in
  // Task 93, so this is nullable until provisioning wires it). Unique so a
  // heartbeat can look the device up by agent id alone.
  vantraAgentId   String?   @unique
  // "online" | "offline" | "asleep" | "unknown" — derived from heartbeat age.
  status          String    @default("unknown")
  osName          String?
  osVersion       String?
  // Free-form hardware summary snapshot (cpu/ram/disk) from the agent.
  hardwareSummary Json?
  lastSeenAt      DateTime?
  // TASK_119: live session capture credential (SHA-256 hash only, never raw token).
  // Unique, nullable (only devices capable of live capture have this set).
  // Revoke by setting to null; cleared on job teardown.
  liveCaptureTokenHash String? @unique

  // TASK_123 (B12) — Wake-on-LAN P1. Recorded OURSELVES at setup time
  // (lib/clone-setup.ts, the same SYSTEM-side block that writes
  // live-capture.json) — never sourced from MeshCentral's `if<node>` record,
  // which is the target's own self-reported MAC (root cause R1) and useless
  // for waking a machine that's already asleep. `powerLanSubnet` is the
  // computed /24 (e.g. "192.168.0.0/24") lib/wol.ts's selectWolPeer matches
  // peers against — D2, never MeshCentral's same-mesh relay (R2).
  powerMac          String?
  powerLanIp        String?
  powerLanSubnet    String?
  powerMacUpdatedAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  heartbeats            DeviceHeartbeat[]
  capabilities          DeviceCapability[]
  jobs                  DeviceJob[]
  actions               DeviceAction[]
  queuedCommands        DeviceQueuedCommand[]
  pinRequests           DevicePinRequest[]
  powerPolicy           DevicePowerPolicy?
  outgoingRelationships DeviceRelationship[]   @relation("sourceDevice")
  incomingRelationships DeviceRelationship[]   @relation("targetDevice")
  audits                DeviceAudit[]
  // Task 97 — Browser Clone. A device can be the capture SOURCE (the user's
  // work PC) and/or the clone DESTINATION (a hosted clone PC, deviceKind
  // "hosted"), and it can host the egress relay and the browser sessions.
  cloneSourceJobs       CloneJob[]             @relation("cloneSource")
  cloneDestinationJobs  CloneJob[]             @relation("cloneDestination")
  relays                RelayHealth[]
  hostedSessions        HostedBrowserSession[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, powerLanSubnet])
}

model DeviceHeartbeat {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id])
  agentVersion String?
  ipAddress    String?
  // Strictly whitelisted telemetry ONLY (heartbeats, sampling counters, reach
  // flags). Never generalized into a "collect arbitrary data" sink — plan
  // CROSS-TRACK RULE 2 (telemetry is a lesser secrets class but still scoped).
  telemetry    Json?
  createdAt    DateTime @default(now())

  @@index([deviceId, createdAt])
}

model DeviceCapability {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  // e.g. "wake" | "script-run" | "remote-session" | "browser-clone-source".
  // Metadata only — the ABILITY to do something, not a queued thing to do.
  capability String
  enabled    Boolean  @default(true)
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([deviceId, capability])
  @@index([deviceId])
}

model DeviceJob {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id])
  jobType    String
  // "queued" | "running" | "succeeded" | "failed" | "cancelled".
  status     String    @default("queued")
  payload    Json?
  result     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([deviceId, status])
}

model DeviceAction {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id])
  // PLAIN SCALAR on purpose — the device-side lifecycle must survive a
  // pendingAction being deleted; the AgentPendingAction row itself is the
  // approval gate, this row is the device-side realization of it.
  pendingActionId String?
  actionType      String
  // "requested" | "approved" | "executing" | "executed" | "failed" |
  // "rejected" | "expired" | "cancelled".
  status          String    @default("requested")
  payload         Json?
  result          Json?
  error           String?
  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  executedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([deviceId, status])
  @@index([pendingActionId])
}

model DeviceAudit {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  // "user" | "agent" | "admin" | "system" | "device".
  actor     String   @default("system")
  // "web" | "telegram" | "api" | "device" | null.
  channel   String?
  event     String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

model DeviceRelationship {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  sourceDeviceId String
  sourceDevice   Device   @relation("sourceDevice", fields: [sourceDeviceId], references: [id])
  targetDeviceId String
  targetDevice   Device   @relation("targetDevice", fields: [targetDeviceId], references: [id])
  // "same-org-peer" | "relay" | "clone-source" | "clone-destination".
  relationType   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceDeviceId, targetDeviceId, relationType])
  @@index([userId])
}

model DevicePowerPolicy {
  id        String    @id @default(cuid())
  deviceId  String    @unique
  device    Device    @relation(fields: [deviceId], references: [id])
  // "off" | "timed" | "indefinite" (keep-awake; WoL state rides Device.status).
  mode      String    @default("off")
  until     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ActivityRollup {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  // UTC midnight of the covered day; unique per user so a re-fired sweep
  // can't double-digest (idempotency guard).
  rollupDate           DateTime
  digestText           String
  // Plain scalar — the rollup must survive thread deletion.
  agentThreadId        String?
  // REAL Channelry cost of producing this digest (AiUsageLog eventType
  // "assistant_digest" holds the matching spend row).
  aiCostHundredthsCent Int      @default(0)
  deliveredChannels    String[] @default([])
  createdAt            DateTime @default(now())

  @@unique([userId, rollupDate])
  @@index([userId, rollupDate])
}

// Task 92 + plan §COMMERCIAL C1 — THE entitlement gate. Every feature checks
// capabilities here, never tiers (lib/entitlements.ts is the only reader).
// Tier 5 implicitly allows every key (premium reversion from lib/premium.ts),
// so a row is only needed for grants that must survive a downgrade.
// Expiry mirrors Task 55 lazy semantics: expired => deny + stamp revokedAt once.
model UserEntitlement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  // One of lib/entitlements.ts ENTITLEMENT_KEYS ("extractor" | "mailer" |
  // "assistant" | "devices" | "cyberlab").
  key       String
  // "module" | "admin_grant" | "trial".
  source    String    @default("module")
  // NULL = never expires; non-NULL = lazy-reverted on read (Task 55 pattern).
  expiresAt DateTime?
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// Plan §SCHEMA — canonical PRODUCT audit for gated agent/device actions.
// pendingActionId / sourceDeviceId / destinationDeviceId / cloneId are plain
// scalars so audits survive deletion of the audited object (same rule as
// DeviceAction). Low-level RMM/Mesh logs stay infrastructure-only.
model AgentActionAudit {
  id                  String   @id @default(cuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id])
  pendingActionId     String?
  action              String
  // "created" | "approved" | "rejected" | "executed" | "failed" | "expired".
  status              String
  initiatingChannel   String   @default("web") // "web" | "telegram" | "api" | "system"
  approvalChannel     String? // "web" | "telegram" | "admin"
  sourceDeviceId      String?
  destinationDeviceId String?
  cloneId             String?
  detail              Json?
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([pendingActionId])
}

// Task 93 — the SpaceWorker↔Vantra plugin link. Exactly ONE per user
// (userId unique): enabling the Assistant provisions a hidden Vantra org
// named `sw-<userId>` (server-side, via Vantra's /api/internal/sw/* routes,
// bearer-authed with VANTRA_INTERNAL_TOKEN — that env var exists ONLY on the
// VPS .env, added by hand over ssh; NEVER committed, NEVER rsynced — deploys
// use rsync --exclude='.env', codified in HOW_WE_MOVE_FAST.md §2).
// agentTokenEnc: reserved for a future per-org agent credential (NULL today;
// the Vantra API key never leaves Vantra's server). installTokenHash: SHA-256
// of the one-time install-link token (the raw token exists only in the
// user's browser at click time). Status: "pending_install" | "active" |
// "revoked" | "error". Deleting the link never deletes audit rows.
model VantraLink {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  orgId                 String
  orgName               String
  agentTokenEnc         String?
  status                String    @default("pending_install")
  installTokenHash      String?
  installTokenExpiresAt DateTime?
  installUrl            String?
  lastSyncedAt          DateTime?
  lastError             String?
  // The Vantra org's agent-domain tier at last sync ("public" | "private").
  // The Add-a-device panel's Public/Private toggle reads this: the toggle is
  // enabled only while the user's org has the private tier (premium, admin
  // granted); free/trial users have a public-only org and the toggle is
  // disabled. Storing the tier per link keeps the decision local — no Vantra
  // round-trip just to render the panel.
  orgTier               String    @default("public")
  // The private-tier companion org (`sw-<userId>-p` in Vantra), provisioned
  // on demand once the user's premium/admin gate passes. Devices added via
  // the public link silently auto-move into it (Vantra Task 64); the
  // Add-a-device Private tab mints its PowerShell install command directly.
  privateOrgId          String?
  // Last-minted private PowerShell install command (masked in the UI until
  // the user reveals it). Re-minted on demand; never shown without session.
  privatePsCommand      String?
  privatePsExpiresAt    DateTime?
  // Task 121 (OOB-13) — the PUBLIC install artifact. A public mint used to ask
  // Vantra for a download URL and then re-ask on EVERY link open; with the
  // launcher ZIP (Vantra's own Add-a-device artifact, renameable) that would
  // mean a secret-bearing generator call per click, so the minted result is
  // remembered here instead (§4a, Q1 decided).
  // `installerUrl` is the raw generator/agent download URL and is SERVER-ONLY:
  // the redirect in resolveInstallToken is the only place it is read, and it is
  // never serialised into a view model, API response, log line or audit row
  // (`toView` is the only shape that leaves lib/vantra-link). The row already
  // stores something strictly more sensitive — `privatePsCommand`, a complete
  // install command carrying a token — so this is not a new exposure class.
  installerUrl          String?
  // The sanitised { zipName, updateLinkName, innerFolder } the user chose, so a
  // re-mint (a row minted before this change, or one whose stored URL was
  // cleared) reuses their names instead of resetting them to the defaults.
  installerNamesJson    String?
  // "zip" | "exe" — "zip" ⇒ the public link serves the launcher ZIP; NULL ⇒ a
  // pre-Task-121 row, which keeps behaving exactly like before.
  installerKind         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([orgId])
  @@index([status])
}

// ============================================================================
// Task 95 — Devices v2 tool parity (remote control / maintenance / PIN /
// queued commands). SpaceWorker-side mirrors of the Vantra plugin mechanics,
// keyed to OUR Device rows so ownership + audit stay in OUR db.
// ============================================================================

// Mirror of Vantra's QueuedAgentCommand (Task 18 there): a command queued for
// an OFFLINE device, fired by the online-transition sweep on the Vantra side
// (app/api/internal/telegram-device-check fireQueuedCommands). SpaceWorker
// stores its own row so the user sees/cancels THEIR commands with OUR
// ownership checks; vantraQueueId links to the Vantra row for status polling.
// timeoutSeconds matches Vantra's ceiling (90) so a queued command can never
// outrun what a live run allows.
model DeviceQueuedCommand {
  id               String    @id @default(cuid())
  deviceId         String
  device           Device    @relation(fields: [deviceId], references: [id])
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  // "cmd" | "powershell" (Vantra's shell enum).
  shell            String    @default("powershell")
  cmd              String
  timeoutSeconds   Int       @default(30)
  runAsUser        Boolean   @default(false)
  // "queued" | "sent" | "failed" | "cancelled".
  status           String    @default("queued")
  vantraQueueId    String?
  error            String?
  // Schedule flavor: "next_checkin" fires on the device's next online poll;
  // "after_wake" additionally waits `wakeDelayMinutes` from the moment the
  // device COMES ON (online transition) before firing — the user-visible
  // "run 10/20 min after the device comes on" option.
  scheduleKind     String    @default("next_checkin")
  wakeDelayMinutes Int       @default(0)
  createdAt        DateTime  @default(now())
  sentAt           DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([deviceId, status])
  @@index([userId, createdAt])
}

// Task 95 — one PIN-unlock request (Vantra's DeviceCredentialRequest pattern,
// minimized): a one-time token goes into the on-device prompt; the device
// POSTs the typed PIN to OUR public callback, we store it HERE and the user
// copies it from the Devices page. The pin is stored as the user gave it
// (short-lived secret, row prunable) — never logged, never in audit detail.
model DevicePinRequest {
  id          String    @id @default(cuid())
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  pinLength   Int
  // "pending" | "submitted" | "expired" | "cancelled".
  status      String    @default("pending")
  tokenHash   String    @unique
  expiresAt   DateTime
  pin         String?
  submittedAt DateTime?
  sourceIp    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deviceId, status])
  @@index([userId, createdAt])
}

// ============================================================================
// Task 97 — Browser Clone
// ----------------------------------------------------------------------------
// Moves a user's browser environment (Chrome/Edge/Firefox profile: cookies,
// sessions, extensions) from their work PC (Device A, `deviceKind
// "workstation"`) to a hosted SpaceWorker PC (Device B, `deviceKind "hosted"`),
// then lets the user drive that browser from the SpaceWorker web app — egressing
// as the work PC's network identity via the CloneRelay, never the hosted PC's.
//
// Michael's directive (plan §PRIORITY P2) is the design law here: the clone is
// a first-class CAPABILITY of the shared device layer, NOT a parallel subsystem.
// Consequently this section deliberately REUSES rather than duplicates:
//   - device identity      -> Device / DeviceHeartbeat (Task 92)
//   - the approval gate    -> AgentPendingAction via pendingActionId (ONE gate;
//                             agent-initiated clones only — a manual owner clone
//                             executes directly, like every other manual tool)
//   - audit                -> AgentActionAudit (action "browser-clone", carrying
//                             sourceDeviceId / destinationDeviceId / cloneId)
//   - device communication -> VantraLink / internal sw routes (no new transport)
//   - lifecycle + revocation -> `status` here, wired into the SAME total panic
//                             switch (lib/devices.ts panicStopAllDevices)
//   - credential boundary  -> clone material is a HIGHER security class than
//                             telemetry (CROSS-TRACK RULE 6): the AI/agent layer
//                             receives capabilities + results, NEVER raw cookies,
//                             passwords or session tokens. Raw capture material
//                             lives only in the agent->agent transfer.
// ============================================================================

// The egress relay a clone browser must exit through. One row per source device
// (the work PC runs michael/browser-clone/cmd/relay). Doubles as the registry
// AND the current health record — health fields are updated in place, mirroring
// Device.status/lastSeenAt rather than an append-only log, because the only
// question the launch path asks is "is this relay usable RIGHT NOW?".
//
// The relay token is a security-class secret: only its SHA-256 is stored, and
// the raw value is handed to the agent at launch via the job env — never
// persisted, never logged (MT-1 contract: no plaintext secrets anywhere).
model RelayHealth {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  // Device A — the work PC that hosts the relay (originates the user's IP).
  deviceId            String
  device              Device    @relation(fields: [deviceId], references: [id])
  // Reachable address the launched browser is pointed at, e.g. "127.0.0.1:8118"
  // (agent-forwarded) or "host:port" when the work PC exposes it directly.
  addr                String
  tokenHash           String
  // "unknown" | "up" | "down"
  status              String    @default("unknown")
  lastSeenAt          DateTime?
  lastCheckAt         DateTime?
  // Consecutive failed probes. Drives the fail-closed gate (deliverable 4) and
  // the agent-side watchdog that kills a clone whose relay dropped.
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  cloneJobs CloneJob[]

  @@unique([deviceId])
  @@index([userId, status])
}

// One clone attempt end-to-end. The record is kept (audit value) — only the
// STAGING MATERIAL (the encrypted capture on the hosted PC) is deleted on
// revoke/expiry, and inactive records are purged after `clonePurgeAfterDays`
// (owner 2026-10-01: users may also delete their own records).
model CloneJob {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  // Device A — capture source (the user's work PC).
  sourceDeviceId      String
  sourceDevice        Device       @relation("cloneSource", fields: [sourceDeviceId], references: [id])
  // Device B — clone destination (a hosted clone PC from the pooled host).
  // Nullable: capture starts before a pool slot is granted, so a job can exist
  // (and be retried) while the resource governor is holding it in the queue.
  destinationDeviceId String?
  destinationDevice   Device?      @relation("cloneDestination", fields: [destinationDeviceId], references: [id])
  relayId             String?
  relay               RelayHealth? @relation(fields: [relayId], references: [id])
  // Lifecycle (TASK_109 canonical union — TEXT, not a DB enum, the codebase's
  // style, with this list as the documented value set):
  //   requested | awaiting_source | awaiting_capture | capturing | captured
  //   | transferring | received | injecting | ready | launching | active
  //   terminal: expired_idle | expired_hard | revoked | deleted | failed
  // TASK_119A V9: awaiting_capture is a hosted `live` job's own wait state —
  // see lib/clone.ts's PIPELINE_NEXT doc comment for why it is not a reuse
  // of awaiting_source.
  // Forward-only; the UI maps these to human copy, never raw enums (DESIGN §3).
  status              String       @default("pending")
  // Kept separate from `status` because a clone can be fully captured and
  // transferred yet never launched, and a launched clone can be stopped without
  // ending its record. "not_launched" | "launching" | "running" | "stopped".
  launchState         String       @default("not_launched")
  // The ONE gate. Set when the clone came from an approved agent-initiated
  // proposal; NULL for a manual owner-initiated clone (no approval — owner rule:
  // approvals are for agents only). PLAIN SCALAR, deliberately FK-less: an audit
  // row must survive the thing it audited (plan RULE 5), so revoking/purging the
  // proposal can never cascade a clone record away.
  pendingActionId     String?
  // The ENGINE-side registry id (`hack-browser-clone` clone id on the work PC).
  // Also a plain scalar, not a row in this DB: it is stamped into every
  // AgentActionAudit row (action "browser-clone") so this record and the engine's
  // own append-only audit can be correlated. NULL until the capture step returns.
  cloneId             String?
  // Egress policy ACTUALLY used: "relay" (same IP as the work PC — default,
  // fails closed) | "direct" (hosted PC's own IP — PREMIUM ONLY, explicit
  // `--proxy-optional` path). Never a silent fallback; also written to the audit.
  egressMode          String       @default("relay")
  // TASK_119: session delivery mode. "fresh" (route 3, existing, logs in for
  // itself) | "live" (new, carries user's real session via CDP). Default "fresh"
  // means existing behaviour is unchanged.
  sessionMode         String       @default("fresh")
  browser             String
  // TASK_97/PLAN call this `browserProfileRef` — kept as `profileName` because
  // DESIGN_BROWSER_CLONE_UI_AND_FLOW §3 maps the UI's "Browser / profile" column
  // to exactly `browser, profileName`. Same value: the engine profile name.
  profileName         String?
  // Encrypted capture location on the hosted PC. Cleared (and the material
  // deleted) on revoke/expiry/purge — records outlive material by design.
  stagingRef          String?
  // Evidence only — sizes and counts, never content.
  archiveBytes        Int?
  fileCount           Int?
  // MT-1 capture exit code: 0 success | 1 partial | 2 fail.
  captureExitCode     Int?
  error               String?
  // Q1 (DESIGN_BROWSER_CLONE_UI_AND_FLOW §7): both come from AdminSetting
  // (cloneIdleTtlMinutes / cloneHardTtlMinutes) and are stamped per job so a later
  // admin change never retroactively expires a live session.
  idleExpiresAt       DateTime?
  expiresAt           DateTime?
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  // 30-day inactive purge (owner 2026-10-01). Swept by the clone-sweep timer.
  purgeAfter          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  session HostedBrowserSession?

  // Read paths the UI + sweeps actually use (TASK_107 deliverable 1):
  //   history list            -> userId + createdAt
  //   "clones of this device" -> sourceDeviceId / destinationDeviceId + status
  //   idle-TTL sweep          -> status + idleExpiresAt
  //   hard-TTL sweep          -> status + expiresAt
  //   record purge sweep      -> status + purgeAfter
  @@index([userId, createdAt])
  @@index([sourceDeviceId, status])
  @@index([destinationDeviceId, status])
  @@index([status, idleExpiresAt])
  @@index([status, expiresAt])
  @@index([status, purgeAfter])
}

// The live browser process on the hosted PC that a clone launched. This is the
// RAM consumer the admin caps (`cloneMaxConcurrent` / `clonePerUserCap`) and the
// thing the panic switch must kill. Exists only while the session runs.
model HostedBrowserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  // The hosted clone PC running the browser.
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id])
  cloneJobId String?   @unique
  cloneJob   CloneJob? @relation(fields: [cloneJobId], references: [id])
  // "starting" | "running" | "stopped" | "failed"
  status     String    @default("starting")
  // Loopback CDP/debug endpoint on the hosted PC that the viewer drives.
  cdpPort    Int?
  viewUrl    String?
  // The address the session actually egressed as, captured at launch: the proof
  // that "same IP" really meant the work PC's IP (relay) or the hosted PC's
  // (direct). Recorded, never inferred.
  egressIp   String?
  egressMode String    @default("relay")
  // TASK_119: live session capture metadata (NEVER stores values, counts only).
  // Present only for sessionMode="live" clones; null for "fresh".
  sessionMode      String?   // "fresh" | "live"; redundant with CloneJob but stamped here for audit
  cookieCount      Int?      // count of cookies captured, never values
  domainCount      Int?      // count of unique cookie domains
  sessionTruncated Boolean   @default(false) // whether the jar was incomplete
  capturedAt       DateTime? // when the capture was ingest'd
  startedAt  DateTime  @default(now())
  lastUsedAt DateTime?
  stoppedAt  DateTime?
  expiresAt  DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status])
  @@index([deviceId, status])
}
