{
  "$schema": "https://schema.tauri.app/config/v2",
  "productName": "SpaceWorker OS",
  "version": "0.1.0",
  "identifier": "com.spaceworker-os.desktop",
  "build": {
    "beforeDevCommand": "npm run exe:dev:server",
    "devUrl": "http://localhost:3400/dashboard/extract",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../exe/static"
  },
  "app": {
    "windows": [
      {
        "title": "SpaceWorker OS",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}