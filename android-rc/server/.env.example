# android-rc server environment (T254-B)
# Copy to .env and fill in real values. Never commit .env.

# Fleet enrollment code — used as MQTT password for ANY deviceId username (Phase 1)
# Rotate this whenever a device is decommissioned. 48+ hex chars recommended.
RC_ENROLL_CODE=CHANGE_ME_ENROLL_CODE_HEX

# Internal MQTT user that rc-api connects as (superuser, rc/#)
INTERNAL_MQTT_USER=rc-api
INTERNAL_MQTT_PASSWORD=CHANGE_ME_INTERNAL_MQTT_PASSWORD

# HMAC secret for session tokens (10 min TTL)
TOKEN_SECRET=CHANGE_ME_TOKEN_SECRET_HEX

# SQLite database file path
DB_PATH=/data/devices.sqlite

# API listener (bound to 127.0.0.1 on the box)
API_PORT=8090
API_HOST=127.0.0.1

# Relay listener (bound to 127.0.0.1 on the box; nginx terminates WSS)
RELAY_PORT=8081
RELAY_HOST=127.0.0.1

# Public relay WSS URL (no token, no /relay path — api appends /relay?session=...)
WS_URL_PUBLIC=wss://android.spaceworker.top

# Mosquitto listener (public TLS 8883; dev plain 1883)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS_PORT=8883

# Mosquitto TLS certs (mounted from /etc/letsencrypt on the box)
MQTT_TLS_CERT=/etc/letsencrypt/live/android.spaceworker.top/fullchain.pem
MQTT_TLS_KEY=/etc/letsencrypt/live/android.spaceworker.top/privkey.pem
MQTT_TLS_CA=/etc/letsencrypt/live/android.spaceworker.top/chain.pem