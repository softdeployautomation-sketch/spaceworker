# Copy to keystore/keystore.properties (gitignored) and fill in.
# Gradle also accepts these as -P flags or ~/.gradle/gradle.properties entries.

# --- Fleet signing (required for assembleRelease) ---
FLEET_STORE_PASSWORD=
FLEET_KEY_ALIAS=fleet
FLEET_KEY_PASSWORD=

# --- Backend endpoints baked into BuildConfig ---
# Leave unset to build against the public placeholders (relay.example.com).
RC_MQTT_BROKER=ssl://relay.yourdomain.net:8883
RC_WS_BASE=wss://relay.yourdomain.net

# --- Optional ---
# Broker password. Prefer pushing this from the MDM instead of baking it in.
RC_MQTT_PASSWORD=
# Fixed device id. Blank = ANDROID_ID, or %SERIAL% via MDM.
RC_DEVICE_ID=
